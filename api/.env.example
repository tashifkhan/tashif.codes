# Multi-Project Analytics API - Environment Variables
# Copy this file to .env and fill in your values

# PostHog API Key (required for live data)
# Get from PostHog -> Settings -> Personal API Keys
POSTHOG_API_KEY=phx_your_api_key_here

# PostHog Base URL (optional, defaults to US cloud)
# Use https://eu.posthog.com for EU cloud
POSTHOG_BASE_URL=https://us.posthog.com

# Project IDs for each project
# Get from PostHog -> Settings -> Project Settings -> Project ID
# Leave empty if project doesn't have PostHog tracking yet

PH_PORTFOLIO_ID=
PH_BLOG_ID=
PH_DASHBOARD_ID=
PH_JIIT_CAMPUS_UPDATES_ID=
PH_JIIT_TIMETABLE_ID=

# JPortal stats go through JPortal's analytics proxy, which holds the
# Cloudflare token. Set this empty to query Cloudflare with your own token.
# CLOUDFLARE_PROXY_URL=https://jportal.jmut.de/api/analytics

# Shared last-successful analytics snapshots
# Use the REST URL and read/write token from your Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
