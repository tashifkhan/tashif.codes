{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"functions": {
		"api/**/*.py": {
			"maxDuration": 300,
			"excludeFiles": "{src/**,public/**,scripts/**,dist/**,.vercel/**,node_modules/**}"
		}
	},
	"rewrites": [
		{
			"source": "/u/:path*",
			"destination": "https://u.tashif.codes/:path*"
		},
		{
			"source": "/api/:path*",
			"has": [
				{
					"type": "header",
					"key": "referer",
					"value": "https://tashif.codes/u.*"
				}
			],
			"destination": "https://u.tashif.codes/api/:path*"
		},
		{
			"source": "/static/:path*",
			"has": [
				{
					"type": "header",
					"key": "referer",
					"value": "https://tashif.codes/u.*"
				}
			],
			"destination": "https://u.tashif.codes/static/:path*"
		},
		{
			"source": "/projects/stats/api",
			"destination": "/api/index.py"
		},
		{
			"source": "/projects/stats/api/:path*",
			"destination": "/api/index.py"
		},
		{
			"source": "/proxy/gh-stats/:path*",
			"destination": "https://github-stats.tashif.codes/:path*"
		},
		{
			"source": "/proxy/lc-stats/:path*",
			"destination": "https://leetcode-stats.tashif.codes/:path*"
		},
		{
			"source": "/proxy/blog/:path*",
			"destination": "https://blog.tashif.codes/api/:path*"
		},
		{
			"source": "/proxy/ghpvc",
			"destination": "https://komarev.com/ghpvc/"
		},
		{
			"source": "/ph/static/:path*",
			"destination": "https://eu-assets.i.posthog.com/static/:path*"
		},
		{
			"source": "/ph/:path*/",
			"destination": "https://eu.i.posthog.com/:path*"
		},
		{
			"source": "/ph/:path*",
			"destination": "https://eu.i.posthog.com/:path*"
		},
		{
			"source": "/:slug((?!(?:api|static|projects|docs|download|blog|blogs|github|leetcode|connect|print-resume|resume|fdroid|ph|u|proxy|_astro|404)(?:/|$))(?:[A-Za-z0-9_:;-]|%3[AaBb])+)",
			"destination": "https://u.tashif.codes/:slug"
		}
	],
	"redirects": [
		{
			"source": "/blogs",
			"destination": "/blog",
			"permanent": true
		},
		{
			"source": "/feed",
			"destination": "/rss.xml",
			"permanent": true
		},
		{
			"source": "/blog.xml",
			"destination": "/rss.xml",
			"permanent": true
		},
		{
			"source": "/blog/feed",
			"destination": "/blog/rss.xml",
			"permanent": true
		},
		{
			"source": "/blog/feed.xml",
			"destination": "/blog/rss.xml",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/rss.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/rss+xml; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		},
		{
			"source": "/feed.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/rss+xml; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		},
		{
			"source": "/blog/rss.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/rss+xml; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		},
		{
			"source": "/rss-projects.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/rss+xml; charset=utf-8"
				},
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		}
	]
}
