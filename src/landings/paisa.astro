---
/**
 * Paisa. The file name is the project slug, so this page replaces the README
 * at /projects/paisa. Media lives in public/landings/paisa.
 */
import { Download, Globe, Copy } from "lucide-react";
import {
	Landing,
	LandingHero,
	Section,
	Shot,
	LandingVideo,
	Pinned,
	MediaSwitcher,
	Rows,
	Rail,
	Faq,
} from "@/components/landing";
import { formatBytes, releaseHref } from "@/lib/releases";
import type { LandingMeta } from "@/lib/landings";
import type { Project } from "@/types";

export const landing: LandingMeta = {
	tagline:
		"An expense manager that reads your bank SMS on the phone and keeps the ledger there.",
	accent: { light: "#0b6e4f", dark: "#5fd6a6" },
	cta: { label: "Get Paisa", href: "#get" },
};

interface Props {
	project: Project;
}

const { project } = Astro.props;

const media = "/landings/paisa";
const webApp = "https://paisa.tashif.codes";
const fdroidRepo =
	"https://tashif.codes/fdroid/repo?fingerprint=568557c435bdf555725de95de596a90d6fa964d4bf0b71874f254cd0be7e94c9";

// Download buttons follow the newest GitHub release, so a new version needs
// no edit here.
const release = (project.releases ?? []).find((r) => !r.draft && !r.prerelease);
const apk = release?.assets.find((a) => a.name.toLowerCase().endsWith(".apk"));
const apkHref = apk?.download_url ?? `${project.github_link}/releases/latest`;
const apkSize = apk ? formatBytes(apk.size).replace(" ", " ") : null;

// Every app screen is cropped to the same size.
const screen = { width: 650, height: 1462 };

const shot = (name: string, alt: string) => ({
	src: `${media}/screens/${name}.webp`,
	alt,
});

// The same four chapters the walkthrough video follows.
const chapters = [
	{
		title: "Capture",
		features: [
			{
				title: "Bank SMS import",
				body: "Parsers for about 140 Indian banks turn an alert into a transaction on the phone. A bulk scan reads the inbox once, and a live receiver catches new alerts.",
			},
			{
				title: "The source stays attached",
				body: "Open any imported transaction to read the original message under it.",
			},
			{
				title: "Add with AI",
				body: "Type “lunch 240 yesterday, uber 180 today” or attach a receipt. Ask it to change a draft in plain words, then save them together.",
			},
			{
				title: "Manual entry",
				body: "A cash expense takes an amount, a title and a category.",
			},
		],
		shots: [
			shot("sms", "A UPI transfer of 460 rupees, parsed from a bank SMS"),
			shot("source", "The same transaction with the original bank SMS shown under it"),
			shot("ai", "Two AI drafts, Chaayos and Uber, ready to save"),
		],
	},
	{
		title: "Review",
		features: [
			{
				title: "Merchant search",
				body: "Type a merchant and get every payment to it, with the total.",
			},
			{
				title: "Analytics",
				body: "Spending by category for a month or a range you pick.",
			},
			{
				title: "Budgets",
				body: "A monthly cap per category, with progress beside each one.",
			},
			{
				title: "Accounts",
				body: "Bank, cash, card and wallet balances in one list.",
			},
		],
		shots: [
			shot("search", "Search results for Swiggy, four transactions"),
			shot("analytics", "Analytics by category with a ring chart"),
			shot("budgets", "Monthly budgets for food, groceries, shopping and transport"),
		],
	},
	{
		title: "Make it yours",
		features: [
			{
				title: "Material You",
				body: "Wallpaper colours on Android 12 and up, or one of 31 fixed palettes.",
			},
			{
				title: "AMOLED black",
				body: "Pure black surfaces in dark mode.",
			},
			{
				title: "Contrast, motion and navigation",
				body: "High contrast, calmer motion and a floating navigation bar are each one switch.",
			},
		],
		shots: [
			shot("appearance", "Appearance settings with wallpaper colours selected"),
			shot("customize", "Dark appearance settings with AMOLED black and a floating navbar on"),
			shot("amoled", "The home screen in AMOLED black with the Ocean palette"),
		],
	},
	{
		title: "Keep it yours",
		features: [
			{
				title: "Hide amounts",
				body: "One tap swaps every amount for dots.",
			},
			{
				title: "App lock",
				body: "A fingerprint, your face or the screen lock, each time you come back.",
			},
			{
				title: "Backup and sync",
				body: "Google Drive, Nextcloud or a .paisa file, encrypted with AES-256-GCM when you set a password. A phone and a browser can share one destination.",
			},
		],
		shots: [
			shot("hide", "Home screen with every balance replaced by dots"),
			shot("lock", "Paisa is locked. Unlock with fingerprint, face or device credentials"),
			shot("backup", "Backup settings with Google Drive and Nextcloud"),
		],
	},
];

const stays = [
	{ title: "Your SMS", body: "Parsed on the device. Never uploaded." },
	{ title: "The ledger", body: "Room and SQLite, on the phone." },
	{ title: "AI keys", body: "Held in EncryptedSharedPreferences." },
];
const leaves = [
	{
		title: "A statement",
		body: "To the AI endpoint you configured, when you import one.",
	},
	{
		title: "A backup",
		body: "To the Drive, Nextcloud or file you picked.",
	},
];

const clips = [
	{
		id: "walkthrough",
		label: "Walkthrough",
		note: "Two minutes, with sound.",
		src: `${media}/walkthrough.mp4`,
		poster: `${media}/walkthrough-poster.webp`,
		width: 1280,
		height: 800,
		controls: true,
	},
	{
		id: "foldable",
		label: "Foldable",
		note: "Unfolded, a transaction opens beside the list.",
		src: `${media}/foldable.mp4`,
		poster: `${media}/foldable-poster.webp`,
		width: 1280,
		height: 800,
	},
	{
		id: "tablet",
		label: "Tablet",
		note: "From 840dp wide, analytics goes to two columns.",
		src: `${media}/tablet.mp4`,
		poster: `${media}/tablet-poster.webp`,
		width: 1280,
		height: 800,
	},
	{
		id: "web",
		label: "Browser",
		note: "The same Kotlin, compiled to WebAssembly.",
		src: `${media}/web.mp4`,
		poster: `${media}/web-poster.webp`,
		width: 1280,
		height: 800,
	},
];

const more = [
	{
		title: "Statement import",
		body: "Feed it PDF, CSV or image statements, several at once. Duplicates across files are dropped.",
	},
	{
		title: "Model ladder",
		body: "Pick a model per provider and order fallbacks, with your own key.",
	},
	{
		title: "Categories that learn",
		body: "Your merchant rules run first. Fix a merchant once and the fix sticks.",
	},
	{
		title: "Split with others",
		body: "A split adds each person's share to what they owe you in Debts.",
	},
	{
		title: "Credit cards",
		body: "Available credit and what you owe, on the home screen.",
	},
	{ title: "Export", body: "CSV for a spreadsheet, PDF for a person." },
	{
		title: "Widgets",
		body: "Your balance and quick add on the home screen.",
	},
	{
		title: "Keyboard in the browser",
		body: "n adds, / searches, 1 to 6 switch tabs.",
	},
];

const panelAlt = [
	"Paisa overview. Your money, your business.",
	"A bank SMS recorded as a transaction",
	"The original bank message beside the parsed transaction",
	"Add with AI turns a sentence into two drafts",
	"Manual entry for a coffee",
	"Analytics by category",
	"Monthly budgets per category",
	"All account balances in one list",
	"Merchant search results",
	"Material You colours from the wallpaper",
	"Appearance settings with fixed palettes",
	"Dark mode with AMOLED black",
	"Amounts hidden behind dots",
	"App lock screen",
	"Unfolded foldable with list and detail",
	"Tablet layout",
	"Web app on a wide screen",
	"Backup destinations",
	"Paisa on phone, foldable, tablet and web",
];
const panels = panelAlt.map((alt, i) => ({
	src: `${media}/panels/${String(i + 1).padStart(2, "0")}.webp`,
	alt,
}));

const faq = [
	{
		q: "Do I need an account?",
		a: "No. There is no sign up and no Paisa server. Setup asks for a currency and a theme.",
	},
	{
		q: "Which banks does SMS import cover?",
		a: 'About 140 Indian banks. The parsers come from <a href="https://github.com/sarim2000/pennywiseai-tracker" target="_blank" rel="noopener noreferrer">PennyWise</a>. A financial message that no parser claims goes to an unrecognized list instead of vanishing.',
	},
	{
		q: "Is the AI required?",
		a: "No. SMS parsing uses on-device parsers and no model. Add with AI and statement import stay off until you add your own key for an OpenAI compatible endpoint, Gemini or Anthropic.",
	},
	{
		q: "Is there an iPhone app?",
		a: `Not yet. Paisa runs on Android 7.0 and up, and in a recent Chrome, Edge, Firefox or Safari at <a href="${webApp}" target="_blank" rel="noopener noreferrer">paisa.tashif.codes</a>. The browser build can't read SMS, because browsers can't.`,
	},
	{
		q: "What does it cost?",
		a: `Nothing. Paisa is free under AGPL-3.0, and the source is on <a href="${project.github_link}" target="_blank" rel="noopener noreferrer">GitHub</a>.`,
	},
];
---

<Landing name="paisa">
	<LandingHero
		title="Your money stays on your phone."
		lead="Paisa turns bank SMS into transactions on the device, with no account."
	>
		<Fragment slot="actions">
			<a href={apkHref} data-haptic-external class="ld-btn ld-btn-primary">
				<Download aria-hidden="true" />
				Download APK
			</a>
			<a
				href={`${webApp}/?demo`}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class="ld-btn"
			>
				<Globe aria-hidden="true" />
				Open the web demo
			</a>
		</Fragment>
		<Fragment slot="terms">
			{apkSize ? `${apkSize}, for` : "For"} Android 7.0 and up. Free under AGPL-3.0.
			{
				release && (
					<a class="text-link" href={releaseHref(project.slug, release.tag_name)}>
						Release notes
					</a>
				)
			}
		</Fragment>
		<Shot slot="media" width={720} height={1280}>
			<LandingVideo
				src={`${media}/phone.mp4`}
				poster={`${media}/phone-poster.webp`}
				label="Paisa on a phone: an SMS becomes a transaction, then AI drafts, budgets and themes"
				autoplay
			/>
		</Shot>
	</LandingHero>

	<Section
		id="features"
		title="Everything it does, in four chapters."
		gap="s"
	>
		<Pinned chapters={chapters} {...screen} />
	</Section>

	<Section
		id="privacy"
		title="What leaves the phone."
		lead="Two things, and only when you send them."
		layout="side"
	>
		<div class="ld-rows-group">
			<h3>Stays on the phone</h3>
			<Rows rows={stays} />
		</div>
		<div class="ld-rows-group">
			<h3>Leaves when you send it</h3>
			<Rows rows={leaves} />
		</div>
	</Section>

	<Section
		id="screens"
		title="One codebase, four screen sizes."
		lead="The layout follows the window, not the platform."
		gap="l"
	>
		<MediaSwitcher clips={clips} label="Paisa on different screens" />
	</Section>

	<Section id="more" title="Also in the app." layout="side">
		<Rows rows={more} dense />
	</Section>

	<Section id="gallery" title="Nineteen screens." gap="s">
		<Rail panels={panels} label="Paisa screenshots" width={720} height={1558} />
	</Section>

	<Section id="faq" title="Before you install." layout="side">
		<Faq items={faq} />
	</Section>

	<section id="get" class="ld-section" data-gap="l">
		<div class="ld-split" data-ratio="7-5">
			<div class="ld-split-text">
				<h2>Get Paisa.</h2>
				<dl class="get">
					<div class="get-route">
						<dt>APK</dt>
						<dd>
							<p>
								A .sha256 file ships beside every build, and the source is on
								<a class="text-link" href={project.github_link} target="_blank" rel="noopener noreferrer">GitHub</a>.
							</p>
							<a href={apkHref} data-haptic-external class="ld-btn ld-btn-primary">
								<Download aria-hidden="true" />
								Download APK
							</a>
						</dd>
					</div>
					<div class="get-route">
						<dt>F-Droid</dt>
						<dd>
							<p>
								Add this repo under Settings, Repositories. The fingerprint lets
								F-Droid check the repo is mine.
								<a class="text-link" href="/fdroid" data-haptic-nav>Setup steps</a>
							</p>
							<div class="get-repo">
								<code>{fdroidRepo}</code>
								<button
									type="button"
									class="ld-btn"
									data-copy={fdroidRepo}
									data-haptic-nav
									aria-label="Copy the F-Droid repo address"
								>
									<Copy aria-hidden="true" />
									<span data-copy-label>Copy</span>
								</button>
							</div>
						</dd>
					</div>
					<div class="get-route">
						<dt>Browser</dt>
						<dd>
							<p>
								Nothing to install. Add <code>?demo</code> for three months of
								sample data.
							</p>
							<a
								href={`${webApp}/?demo`}
								target="_blank"
								rel="noopener noreferrer"
								data-haptic-external
								class="ld-btn"
							>
								<Globe aria-hidden="true" />
								Open the web demo
							</a>
						</dd>
					</div>
				</dl>
			</div>
			<Shot
				src={`${media}/screens/accounts.webp`}
				alt="Accounts in Paisa: cash, savings, credit card and wallet balances"
				{...screen}
			/>
		</div>
	</section>
</Landing>

<style>
	/* Only the install routes are specific to this landing. The kit covers the rest. */
	.get {
		margin: 0;
		border-top: 1px solid var(--ld-rule);
	}
	.get-route {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--ld-space-sm);
		padding-block: var(--ld-space-lg);
		border-bottom: 1px solid var(--ld-rule);
	}
	.get-route dt {
		font-family: var(--ld-font-display);
		font-size: var(--ld-text-title);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}
	.get-route dd {
		display: grid;
		gap: var(--ld-space-md);
		justify-items: start;
		margin: 0;
		min-width: 0;
		color: var(--ld-muted);
	}
	.get-repo {
		display: grid;
		gap: var(--ld-space-sm);
		justify-items: start;
		min-width: 0;
	}
	.get-repo code {
		overflow-wrap: anywhere;
	}
	@media (min-width: 40rem) {
		.get-route {
			grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
			column-gap: var(--ld-gap-columns);
		}
	}
	.text-link {
		color: var(--ld-ink);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.16em;
	}
	.text-link:hover {
		color: var(--ld-accent);
	}
	.text-link:active {
		color: var(--ld-press);
	}
	#get :global(.ld-shot) {
		justify-self: center;
	}
</style>

<script>
	function initCopy() {
		document
			.querySelectorAll<HTMLButtonElement>("[data-copy]:not([data-wired])")
			.forEach((button) => {
				button.dataset.wired = "true";
				button.addEventListener("click", async () => {
					const label = button.querySelector("[data-copy-label]");
					try {
						await navigator.clipboard.writeText(button.dataset.copy ?? "");
						if (label) label.textContent = "Copied";
					} catch {
						if (label) label.textContent = "Copy failed";
					}
					setTimeout(() => {
						if (label) label.textContent = "Copy";
					}, 1600);
				});
			});
	}

	initCopy();
	document.addEventListener("astro:page-load", initCopy);
</script>
