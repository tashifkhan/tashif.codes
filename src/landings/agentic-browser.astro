---
/**
 * Agentic Browser. Replaces the README at /projects/agentic-browser.
 *
 * The figures, the memory design and the limits come from the project
 * report and deck, which are public at tashif.codes/agentic-browser. The
 * slides are in public/landings/agentic-browser/slides. The video streams
 * from taf.sh.
 */
import { FileText, Github } from "lucide-react";
import {
	Landing,
	LandingHero,
	Section,
	Shot,
	LandingVideo,
	Rows,
	Deck,
	DeckOpen,
	Faq,
	Routes,
} from "@/components/landing";
import type { LandingMeta } from "@/lib/landings";
import type { Project } from "@/types";

export const landing: LandingMeta = {
	tagline:
		"A browser side panel whose agents plan, act and check their work on any page, on your own model keys or the plan you already pay for.",
	cta: { label: "Report and deck", href: "#papers" },
};

interface Props {
	project: Project;
}

const { project } = Astro.props;
const tafMedia = "https://taf.sh/media";
const media = "/landings/agentic-browser";
const files = "https://drive.tashif.codes/public.php/dav/files/9XPLTERoHiNdnBw";
const report = `${files}/Report.pdf`;
const install = "curl -fsSL https://tashif.codes/agentic-browser:install | sh";

const loop = [
	{
		title: "Plan",
		body: "It reads the page's DOM as it is right now, then writes the steps it means to take.",
	},
	{
		title: "Act",
		body: "It clicks, types, scrolls and navigates through 27 browser tools. Each action waits for your approval.",
	},
	{
		title: "Verify",
		body: "It looks at the page after every step, and reasons again when the result is not what it planned for.",
	},
];

const stores = [
	{
		title: "PostgreSQL",
		body: "The source of truth. Facts, entities, claims and events, written in transactions.",
	},
	{
		title: "Neo4j",
		body: "A knowledge graph of how those things relate, so a recall can follow a link two hops out.",
	},
	{
		title: "OpenSearch",
		body: "Meaning and keywords together: vector search and BM25 run side by side.",
	},
	{
		title: "Fused, then trimmed",
		body: "Reciprocal Rank Fusion merges the results, the graph expands the best of them, and the rest is cut to fit the model's context.",
	},
	{
		title: "Memories fade",
		body: "Each memory decays on a forgetting curve unless it is used again. Preferences last far longer than passing context.",
	},
];

// Table 5.2 of the report.
const memory = [
	["Recall, hybrid retrieval", "85", "145"],
	["Graph expansion, two hops", "45", "78"],
	["Store a claim, three writes", "125", "210"],
	["Assemble the context", "12", "25"],
];

// Table 5.1 of the report.
const providers = [
	["Ollama, local", "llama3", "180", "320"],
	["Google", "gemini-3.1-pro", "340", "580"],
	["Deepseek", "deepseek-chat", "480", "820"],
	["OpenAI", "gpt-5.5", "520", "890"],
	["OpenRouter", "mistral-7b-instruct", "550", "950"],
	["Anthropic", "claude-4.6-sonnet", "610", "1050"],
];

// Current models per provider, from models.dev on 19 Nov 2026.
const models: { name: string; ids: string[]; note?: string }[] = [
	{ name: "Anthropic", ids: ["claude-fable-5-2", "claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5"] },
	{ name: "OpenAI", ids: ["gpt-6.2-sol", "gpt-6.2-astra", "gpt-6.1-terra", "gpt-6-luna"] },
	{ name: "Google", ids: ["gemini-4-neon", "gemini-4-hydrogen", "gemini-4-carbon", "gemini-3.8-flash"] },
	{ name: "DeepSeek", ids: ["deepseek-v4-pro", "deepseek-flash"] },
	{ name: "OpenRouter", ids: ["qwen/qwen4-max"], note: "Any of its 380+ models, such as" },
	{ name: "Ollama, local", ids: [], note: "Any model you pull, with no key and no network" },
];

// Shipped after the May defence, in PR #122.
const since = [
	{ title: "Your plan, not just your keys", body: "Run a turn on your Claude, ChatGPT, Google AI or OpenCode subscription. That plan's own agent does the work, with this browser's tools and no shell." },
	{ title: "Screenshots and files", body: "Attach an image, a PDF or a log and ask about it. Images go to any model that can see." },
	{ title: "Voice in one pass", body: "Ramble and correct yourself. A model that hears audio writes down what you meant, then the agent acts on it." },
	{ title: "Long chats", body: "Older messages fold into running notes instead of falling off the end of the context." },
	{ title: "From your phone", body: "Text a task to the Telegram bot. It runs in your browser at home and replies with the answer or a screenshot. Only people on your allow list can use it." },
	{ title: "Coding agents drive it", body: "Claude Code, Codex, Cursor and other MCP clients get your real tabs and your memory." },
	{ title: "A repo agent", body: "It clones a repository, greps it and reads the files before it answers. Private repos work through your GitHub token." },
	{ title: "One command to install", body: "Databases, backend, extension, browsers and MCP, on macOS and Linux. It asks before anything that touches your machine." },
];

const setup = [
	{
		title: "Install",
		body: "macOS or Linux. It clones the repo into ~/agentic‑browser and walks through seven steps. Add <code>-s -- --yes</code> after <code>sh</code> to take every default.",
		copy: install,
	},
	{
		title: "Read it first",
		body: "The whole installer is one shell script and one Python file.",
		action: { label: "Read install.sh", href: `${project.github_link}/blob/main/install.sh`, external: true },
	},
];

const compatible = [
	{ title: "OpenAI-compatible", body: "Give the OpenAI provider another base URL. vLLM, LM Studio, Groq and most hosted gateways speak this format." },
	{ title: "Anthropic-compatible", body: "The Anthropic provider takes a base URL too, for any proxy or gateway that speaks the Messages API." },
	{ title: "Gemini-compatible", body: "Gateways that speak Google's generateContent API work through the Google provider." },
];


const slideAlt = [
	"Title slide",
	"The problem: work scattered across too many tabs",
	"Where existing solutions fall short",
	"Foundations of agentic systems",
	"Objectives in two phases",
	"Complete system architecture",
	"One interface, several model providers",
	"The ReAct agent loop",
	"The browser automation engine",
	"Integrations",
	"The triple-store memory",
	"The context engine",
	"Memory stores and retrieval",
	"Memory decay formula",
	"Implementation and technology stack",
	"Results and system impact",
	"Conclusion, limitations and future scope",
	"Closing slide",
	"Since the report: what's new in November 2026",
	"Runs on the plan you already pay for",
	"Show it, say it: attachments and voice",
	"Long chats, no amnesia",
	"Your coding agent and your phone drive it",
	"A repo agent that reads the code",
	"One command to install",
	"Try it",
];
const slides = slideAlt.map((alt, i) => ({
	src: `${media}/slides/${String(i + 1).padStart(2, "0")}.webp`,
	hd: `${media}/slides/hd/${String(i + 1).padStart(2, "0")}.webp`,
	alt: `Slide ${i + 1}: ${alt}`,
}));

const commands = [
	{ title: "/browser-action", body: "Click, type, scroll and navigate on the open page." },
	{ title: "/react-ask", body: "Reason through a question step by step, calling tools as it goes." },
	{ title: "/google-search", body: "Search the web through more than one provider." },
	{ title: "/gmail-unread", body: "Read and summarise unread email." },
	{ title: "/calendar-events", body: "List what is coming up on your calendar." },
	{ title: "/youtube-ask", body: "Ask questions about a video from its transcript." },
	{ title: "/voice", body: "Talk to it instead of typing." },
];

const papers = [
	{
		title: "Report",
		body: "76 pages. Architecture, the memory algorithms, the security model, and the results above.",
		action: { label: "Read the report", href: report, primary: true, external: true },
	},
	{
		title: "Deck",
		body: "All 26 slides shown above, as a PDF.",
		action: { label: "Open the deck", href: `${tafMedia}/agentic-browser/deck.pdf`, external: true },
	},
	{
		title: "Deck as PowerPoint",
		body: "The same 26 slides with editable text, 5 MB.",
		action: { label: "Download the PowerPoint", href: `${files}/PPT.pptx`, external: true },
	},
	{
		title: "Similarity report",
		body: "The university's plagiarism check of the report: 8% overall similarity.",
		action: {
			label: "Open the similarity report",
			href: `${files}/Plag%20Report%20-%2022102141_MODEL-AGNOSTIC%20AGENTIC%20RESEARCH%20BROWSER%20USING%20PYTHON%20MCP%20ARCHITECTURE.pdf`,
			external: true,
		},
	},
	{
		title: "The film in full resolution",
		body: "The film at the top of this page at 1920x1200, straight from the render, 121 MB.",
		action: { label: "Watch in full resolution", href: `${files}/demo-hd.mp4`, external: true },
	},
	{
		title: "Full demo",
		body: "The longer recording, 48 MB.",
		action: { label: "Watch the full demo", href: `${files}/demo.mp4`, external: true },
	},
	{
		title: "Source",
		body: "The extension, the Python server and the debug dashboard, in one repository.",
		action: { label: "Open on GitHub", href: project.github_link, external: true },
	},
];

const faq = [
	{
		q: "Which models work?",
		a: "Six providers: Google Gemini, OpenAI, Anthropic, DeepSeek, OpenRouter, and local models through Ollama. Any API that speaks the OpenAI, Anthropic or Gemini format works too. Bring a key, or use a Claude, ChatGPT, Google AI or OpenCode subscription you already have.",
	},
	{
		q: "Does it act without asking?",
		a: "No. Browser actions are declared first and wait for your approval, and every action is logged.",
	},
	{
		q: "Where do my keys and memories go?",
		a: "Keys stay on your machine. Stored memories are encrypted with AES-CBC.",
	},
	{
		q: "What does it not do yet?",
		a: "Safari is not supported. Local models through Ollama want a GPU, and the MLX setup needs macOS.",
	},
	{
		q: "How do I install it?",
		a: `Run <code>${install}</code>. It sets up the databases, backend and extension, and registers the MCP server with your coding agents. It is not on a browser store.`,
	},
];
---

<Landing name="agentic-browser">
	<LandingHero
		wide
		title="An agent that acts on the page."
		lead="It plans, clicks and checks its own work in your browser, on your own keys or the plan you already pay for."
	>
		<Fragment slot="actions">
			<a
				href={report}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class="ld-btn ld-btn-primary"
			>
				<FileText aria-hidden="true" />
				Read the report
			</a>
			<a
				href={project.github_link}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class="ld-btn"
			>
				<Github aria-hidden="true" />
				Source
			</a>
		</Fragment>
		<Fragment slot="terms">
			My B.Tech major project at JIIT, May 2026, still growing. Open source.
		</Fragment>
		<Shot slot="media" width={1280} height={800}>
			<LandingVideo
				src={`${tafMedia}/agentic-browser/demo.mp4`}
				poster={`${tafMedia}/agentic-browser/poster.jpg`}
				label="Agentic Browser walkthrough: the side panel planning and acting on a page"
				controls
			/>
		</Shot>
	</LandingHero>

	<Section id="loop" title="Plan, act, verify." layout="side" gap="s">
		<ol class="ab-loop">
			{
				loop.map((step) => (
					<li>
						<h3>{step.title}</h3>
						<p>{step.body}</p>
					</li>
				))
			}
		</ol>
	</Section>

	<Section id="since" title="Since May." lead="What shipped after the defence." layout="side" gap="l">
		<Rows rows={since} />
	</Section>

	<Section id="install" title="Install." lead="One command." layout="side">
		<Routes routes={setup} />
	</Section>

	<Section
		id="memory"
		title="It remembers, in three stores."
		lead="Most agents forget everything between sessions. This one writes what it learns to three databases, each good at one kind of recall."
		layout="side"
		gap="l"
	>
		<Rows rows={stores} />
	</Section>

	<Section id="models" title="Any model." lead="Six providers are built in, and any endpoint that speaks the OpenAI, Anthropic or Gemini API works too. Bring a key, or run on your Claude, ChatGPT, Google AI or OpenCode plan. Model ids are current as of November 2026, from models.dev." layout="side">
		<div class="ld-table-wrap">
			<table class="ld-table">
				<caption>Built-in providers</caption>
				<thead>
					<tr><th scope="col">Provider</th><th scope="col">Current models</th></tr>
				</thead>
				<tbody>
					{models.map((row) => <tr><th scope="row">{row.name}</th><td class="ab-ids">{row.note && `${row.note} `}{row.ids.map((id, i) => <>{i > 0 && ", "}<code>{id}</code></>)}</td></tr>)}
				</tbody>
			</table>
		</div>
		<Rows rows={compatible} />
	</Section>

	<Section
		id="results"
		title="Measured."
		lead="From chapter 5 of the report. Milliseconds, average and 95th percentile."
		layout="side"
	>
		<div class="ld-table-wrap">
			<table class="ld-table">
				<caption>Memory</caption>
				<thead>
					<tr>
						<th scope="col">Operation</th>
						<th scope="col">Average</th>
						<th scope="col">p95</th>
					</tr>
				</thead>
				<tbody>
					{
						memory.map(([name, avg, p95]) => (
							<tr>
								<th scope="row">{name}</th>
								<td>{avg}</td>
								<td>{p95}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<div class="ld-table-wrap">
			<table class="ld-table">
				<caption>First response, by provider, as tested for the report</caption>
				<thead>
					<tr>
						<th scope="col">Provider</th>
						<th scope="col">Model</th>
						<th scope="col">Average</th>
						<th scope="col">p95</th>
					</tr>
				</thead>
				<tbody>
					{
						providers.map(([name, model, avg, p95]) => (
							<tr>
								<th scope="row">{name}</th>
								<td>{model}</td>
								<td>{avg}</td>
								<td>{p95}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</Section>

	<Section id="deck" title="The deck." lead="The May defence in 18 slides, then eight on what's new since." gap="l">
		<DeckOpen slot="action" />
		<Deck slides={slides} title="Agentic Browser deck" width={1280} height={853} />
	</Section>

	<Section
		id="commands"
		title="Slash commands."
		lead="Each one is a tool the agents can also call on their own."
		layout="side"
	>
		<dl class="ab-commands">
			{
				commands.map((command) => (
					<div>
						<dt>
							<code>{command.title}</code>
						</dt>
						<dd>{command.body}</dd>
					</div>
				))
			}
		</dl>
	</Section>

	<Section id="faq" title="Questions." layout="side" gap="l">
		<Faq items={faq} />
	</Section>

	<Section id="papers" title="Report, deck and source." layout="side">
		<Routes routes={papers} />
	</Section>
</Landing>

<style>
	.ab-loop,
	.ab-commands {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ld-rule);
	}
	.ab-loop {
		counter-reset: step;
	}
	.ab-loop > li {
		position: relative;
		display: grid;
		gap: var(--ld-space-2xs);
		padding: var(--ld-space-lg) 0 var(--ld-space-lg) var(--ld-space-2xl);
		border-bottom: 1px solid var(--ld-rule);
		counter-increment: step;
	}
	.ab-loop > li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: var(--ld-space-lg);
		font-family: var(--ld-font-display);
		font-size: var(--ld-text-section);
		font-weight: 700;
		line-height: 0.9;
		color: var(--ld-accent);
	}
	.ab-loop p,
	.ab-commands dd {
		margin: 0;
		max-width: 56ch;
		color: var(--ld-muted);
	}
	.ab-commands > div {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--ld-space-2xs);
		padding-block: var(--ld-space-md);
		border-bottom: 1px solid var(--ld-rule);
	}
	.ab-ids code {
		font-size: 0.92em;
		white-space: nowrap;
	}
	.ab-commands dt code {
		font-weight: 500;
	}
	@media (min-width: 40rem) {
		.ab-commands > div {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			column-gap: var(--ld-gap-columns);
			align-items: baseline;
		}
	}
</style>
