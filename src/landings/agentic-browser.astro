---
/**
 * Agentic Browser. Replaces the README at /projects/agentic-browser.
 *
 * The figures, the memory design and the limits come from the project report
 * and deck, which are public at tashif.codes/agentic-browser. The tour frames
 * are stills from the film (the real extension on real pages), in
 * public/landings/agentic-browser/tour, beside the slides and the README's
 * architecture diagram in both themes. The film streams from taf.sh.
 */
import { Copy, FileText, Github } from "lucide-react";
import { Landing, Shot, LandingVideo, Deck, DeckOpen, Faq, Routes } from "@/components/landing";
import type { LandingMeta } from "@/lib/landings";
import type { Project } from "@/types";

export const landing: LandingMeta = {
	tagline:
		"A browser side panel whose agents plan, act and check their work on any page, on your own model keys or the plan you already pay for.",
	cta: { label: "Report and deck", href: "#papers" },
};

interface Props {
	project: Project;
}

const { project } = Astro.props;
const tafMedia = "https://taf.sh/media";
const media = "/landings/agentic-browser";
const repo = project.github_link;
const files = "https://drive.tashif.codes/public.php/dav/files/9XPLTERoHiNdnBw";
const report = `${files}/Report.pdf`;
const install = "curl -fsSL https://tashif.codes/agentic-browser:install | sh";

const loop = [
	{ title: "Plan", body: "It reads the page's DOM as it is right now, then writes the steps it means to take." },
	{ title: "Act", body: "It clicks, types, scrolls and navigates through 27 browser tools. Each action waits for your approval." },
	{ title: "Verify", body: "It looks at the page after every step, and reasons again when the result is not what it planned for." },
];

// The tour: one frame from the film per chapter.
const tour = [
	{ id: "read", title: "It reads what you are looking at", body: "Ask about the page or the video in front of you. Here it answers from a 27-minute video's transcript.", alt: "The side panel beside a YouTube video, answering from its transcript" },
	{ id: "act", title: "It clicks through for you", body: "Give it a task with several steps. It searches crates.io, opens reqwest, then its Versions tab, and checks the page after each step.", alt: "crates.io open on the reqwest Versions tab, with the side panel listing each step it took" },
	{ id: "plan", title: "It runs on the plan you pay for", body: "Pick Claude, ChatGPT, Google AI or OpenCode in the model menu. That plan's own agent runs the turn with this browser's tools, and no shell.", alt: "The side panel on GitHub, answering with Claude Sonnet picked from the model menu" },
	{ id: "attach", title: "It reads your screenshots", body: "Attach an image, a PDF or a log. Here it reads a declined payment and explains code 51.", alt: "A screenshot of a declined payment attached in the side panel, with the agent explaining code 51" },
	{ id: "voice", title: "It hears what you meant", body: "Ramble, say um, correct yourself halfway. One pass through Gemini writes the request you meant, then it clicks through.", alt: "The side panel on Wikipedia with a cleaned-up spoken request in the composer" },
	{ id: "mcp", title: "Your coding agent drives it", body: "Claude Code, Codex and Cursor get your real tabs over MCP. Here Claude Code searches crates.io and reads the axum page.", alt: "Claude Code calling the browser tools, with the axum crate page open beside it" },
	{ id: "memory", title: "It remembers you", body: "Tell it once. A new chat recalls the talk you are giving on async Rust and picks the Tokio sections for it.", alt: "The side panel on the Tokio tutorial, answering with what it remembers about the talk" },
];
const also = [
	{ title: "From your phone", body: "Text a task to the Telegram bot. It runs in your browser at home and replies with the answer or a screenshot. Only people on your allow list can use it." },
	{ title: "Long chats", body: "Older messages fold into running notes instead of falling off the end of the context." },
	{ title: "A repo agent", body: "It clones a repository, greps it and reads the files before it answers. Private repos work through your GitHub token." },
];

const stores = [
	{ title: "PostgreSQL", body: "The source of truth. Facts, entities, claims and events, written in transactions." },
	{ title: "Neo4j", body: "A knowledge graph of how those things relate, so a recall can follow a link two hops out." },
	{ title: "OpenSearch", body: "Meaning and keywords together: vector search and BM25 run side by side." },
	{ title: "Fused, then trimmed", body: "Reciprocal Rank Fusion merges the results, the graph expands the best of them, and the rest is cut to fit the model's context." },
	{ title: "Memories fade", body: "Each memory decays on a forgetting curve unless it is used again. Preferences last far longer than passing context." },
];

// From the tests behind slides 22 and 24 of the deck, and the Settings test in the film.
const proof = [
	{ value: "14/14", label: "unsafe shell commands refused by the repo agent" },
	{ value: "6/6", label: "facts kept after a long chat was compacted" },
	{ value: "142 s", label: "longest task, finished with no step cap" },
	{ value: "3.5 s", label: "for a test turn on a Claude subscription" },
];

// Table 5.2 of the report.
const memory = [
	["Recall, hybrid retrieval", "85", "145"],
	["Graph expansion, two hops", "45", "78"],
	["Store a claim, three writes", "125", "210"],
	["Assemble the context", "12", "25"],
];

// Table 5.1 of the report.
const providers = [
	["Ollama, local", "llama3", "180", "320"],
	["Google", "gemini-3.1-pro", "340", "580"],
	["Deepseek", "deepseek-chat", "480", "820"],
	["OpenAI", "gpt-5.5", "520", "890"],
	["OpenRouter", "mistral-7b-instruct", "550", "950"],
	["Anthropic", "claude-4.6-sonnet", "610", "1050"],
];

// Current models per provider, from models.dev on 19 Nov 2026.
const models: { name: string; ids: string[]; note?: string }[] = [
	{ name: "Anthropic", ids: ["claude-fable-5-2", "claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5"] },
	{ name: "OpenAI", ids: ["gpt-6.2-sol", "gpt-6.2-astra", "gpt-6.1-terra", "gpt-6-luna"] },
	{ name: "Google", ids: ["gemini-4-neon", "gemini-4-hydrogen", "gemini-4-carbon", "gemini-3.8-flash"] },
	{ name: "DeepSeek", ids: ["deepseek-v4-pro", "deepseek-flash"] },
	{ name: "OpenRouter", ids: ["qwen/qwen4-max"], note: "Any of its 380+ models, such as" },
	{ name: "Ollama, local", ids: [], note: "Any model you pull, with no key and no network" },
];
const plans = ["Claude", "ChatGPT", "Google AI", "OpenCode"];

const steps = [
	{ title: "Tools", body: "docker, uv, node and pnpm, with Homebrew offers for what is missing" },
	{ title: "Settings", body: "a .env, a model key, the encryption key, the backend on 127.0.0.1" },
	{ title: "Databases", body: "Postgres, Neo4j and OpenSearch, waited on until healthy" },
	{ title: "Build", body: "dependencies and the extension" },
	{ title: "Backend", body: "at login with launchd or systemd, or just for now" },
	{ title: "Browsers", body: "finds them, guides the load, confirms it connected" },
	{ title: "MCP", body: "registers the tools with your coding agents, after showing the diff" },
];

const compatible = [
	{ title: "OpenAI-compatible", body: "Give the OpenAI provider another base URL. vLLM, LM Studio, Groq and most hosted gateways speak this format." },
	{ title: "Anthropic-compatible", body: "The Anthropic provider takes a base URL too, for any proxy or gateway that speaks the Messages API." },
	{ title: "Gemini-compatible", body: "Gateways that speak Google's generateContent API work through the Google provider." },
];


const slideAlt = [
	"Title slide",
	"The problem: work scattered across too many tabs",
	"Where existing solutions fall short",
	"Foundations of agentic systems",
	"Objectives in two phases",
	"Complete system architecture",
	"One interface, several model providers",
	"The ReAct agent loop",
	"The browser automation engine",
	"Integrations",
	"The triple-store memory",
	"The context engine",
	"Memory stores and retrieval",
	"Memory decay formula",
	"Implementation and technology stack",
	"Results and system impact",
	"Conclusion, limitations and future scope",
	"Closing slide",
	"Since the report: what's new in November 2026",
	"Runs on the plan you already pay for",
	"Show it, say it: attachments and voice",
	"Long chats, no amnesia",
	"Your coding agent and your phone drive it",
	"A repo agent that reads the code",
	"One command to install",
	"Try it",
];
const slides = slideAlt.map((alt, i) => ({
	src: `${media}/slides/${String(i + 1).padStart(2, "0")}.webp`,
	hd: `${media}/slides/hd/${String(i + 1).padStart(2, "0")}.webp`,
	alt: `Slide ${i + 1}: ${alt}`,
}));

const commands = [
	{ title: "/browser-action", body: "Click, type, scroll and navigate on the open page." },
	{ title: "/react-ask", body: "Reason through a question step by step, calling tools as it goes." },
	{ title: "/google-search", body: "Search the web through more than one provider." },
	{ title: "/gmail-unread", body: "Read and summarise unread email." },
	{ title: "/calendar-events", body: "List what is coming up on your calendar." },
	{ title: "/youtube-ask", body: "Ask questions about a video from its transcript." },
	{ title: "/voice", body: "Talk to it instead of typing." },
];

const papers = [
	{ title: "Report", body: "76 pages. Architecture, the memory algorithms, the security model, and the results above.", action: { label: "Read the report", href: report, primary: true, external: true } },
	{ title: "Deck", body: "All 26 slides shown above, as a PDF.", action: { label: "Open the deck", href: `${tafMedia}/agentic-browser/deck.pdf`, external: true } },
	{ title: "Deck as PowerPoint", body: "The same 26 slides with editable text, 5 MB.", action: { label: "Download the PowerPoint", href: `${files}/PPT.pptx`, external: true } },
	{
		title: "Similarity report",
		body: "The university's plagiarism check of the report: 8% overall similarity.",
		action: {
			label: "Open the similarity report",
			href: `${files}/Plag%20Report%20-%2022102141_MODEL-AGNOSTIC%20AGENTIC%20RESEARCH%20BROWSER%20USING%20PYTHON%20MCP%20ARCHITECTURE.pdf`,
			external: true,
		},
	},
	{ title: "The film in full resolution", body: "The film at the top of this page at 1920x1200, straight from the render, 121 MB.", action: { label: "Watch in full resolution", href: `${files}/demo-hd.mp4`, external: true } },
	{ title: "Full demo", body: "The longer recording, 48 MB.", action: { label: "Watch the full demo", href: `${files}/demo.mp4`, external: true } },
	{ title: "Source", body: "The extension, the Python server and the debug dashboard, in one repository.", action: { label: "Open on GitHub", href: repo, external: true } },
];

const faq = [
	{ q: "Which models work?", a: "Six providers: Google Gemini, OpenAI, Anthropic, DeepSeek, OpenRouter, and local models through Ollama. Any API that speaks the OpenAI, Anthropic or Gemini format works too. Bring a key, or use a Claude, ChatGPT, Google AI or OpenCode subscription you already have." },
	{ q: "Does it act without asking?", a: "No. Browser actions are declared first and wait for your approval, and every action is logged." },
	{ q: "Where do my keys and memories go?", a: "Keys stay on your machine. Stored memories are encrypted with AES-CBC." },
	{ q: "What does it not do yet?", a: "Safari is not supported. Local models through Ollama want a GPU, and the MLX setup needs macOS." },
	{ q: "How do I install it?", a: `Run <code>${install}</code>. It sets up the databases, backend and extension, and registers the MCP server with your coding agents. It is not on a browser store.` },
];
---

<Landing name="agentic-browser">
	<section class="ab-hero">
		<div class="ab-hero-text">
			<h1 class="ab-display">An agent that acts on the page.</h1>
			<p class="ab-lead">It plans, clicks and checks its own work in your browser, on your own keys or the plan you already pay for.</p>
			<div class="ab-cmd">
				<code>{install}</code>
				<button type="button" class="ab-copy" data-copy={install} aria-label="Copy the install command"><Copy aria-hidden="true" /><span data-copy-label>Copy</span></button>
			</div>
			<div class="ab-links">
				<a href={report} target="_blank" rel="noopener noreferrer" class="ld-btn"><FileText aria-hidden="true" /> Read the report</a>
				<a href={repo} target="_blank" rel="noopener noreferrer" class="ld-btn"><Github aria-hidden="true" /> Source</a>
			</div>
			<p class="ab-small">My B.Tech major project at JIIT, May 2026, still growing. Open source.</p>
		</div>
		<div class="ab-hero-media">
			<Shot width={1920} height={1200}>
				<LandingVideo src={`${tafMedia}/agentic-browser/demo.mp4`} poster={`${tafMedia}/agentic-browser/poster.jpg`} label="Agentic Browser walkthrough: the side panel planning and acting on real pages" controls />
			</Shot>
		</div>
	</section>

	<section id="loop" class="ab-sec">
		<div class="ab-head ab-head-split">
			<h2>Plan, act, verify.</h2>
			<p class="ab-lead">One action at a time, then it looks at the page again before the next.</p>
		</div>
		<ol class="ab-steps">
			{loop.map((step) => (
				<li>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
				</li>
			))}
		</ol>
		<figure class="ab-arch">
			<img class="ab-arch-light" src={`${media}/architecture-light.svg`} width="1240" height="900" loading="lazy" decoding="async" alt="Architecture: the side panel talks to the FastAPI backend over HTTP and SSE. The backend runs the agents, tools, model layer and memory, backed by model providers and Postgres, Neo4j and OpenSearch. Coding agents reach the browser through agentic-mcp, whose bridge the extension connects to over a WebSocket." />
			<img class="ab-arch-dark" src={`${media}/architecture-dark.svg`} width="1240" height="900" loading="lazy" decoding="async" alt="Architecture: the side panel talks to the FastAPI backend over HTTP and SSE. The backend runs the agents, tools, model layer and memory, backed by model providers and Postgres, Neo4j and OpenSearch. Coding agents reach the browser through agentic-mcp, whose bridge the extension connects to over a WebSocket." />
			<figcaption>The side panel, your coding agents and the Telegram bot all drive the same backend, the same memory and the same tabs.</figcaption>
		</figure>
	</section>

	<section id="tour" class="ab-sec">
		<div class="ab-head">
			<h2>Watch it work.</h2>
			<p class="ab-lead">Seven frames from the film, each the real extension on a real page.</p>
		</div>
		<div class="ab-tour" data-ab-tour>
			<ol class="ab-tour-panels">
				{tour.map((chapter, i) => (
					<li class="ab-tour-panel" data-ab-panel={chapter.id} data-on={i === 0 ? "" : undefined}>
						<h3>{chapter.title}</h3>
						<p>{chapter.body}</p>
						<div class="ab-tour-inline">
							<Shot src={`${media}/tour/${chapter.id}.webp`} alt={chapter.alt} width={1760} height={1100} />
						</div>
					</li>
				))}
			</ol>
			<div class="ab-tour-stage" aria-hidden="true">
				<div class="ab-tour-frame">
					{tour.map((chapter, i) => (
						<img src={`${media}/tour/${chapter.id}.webp`} alt="" width="1760" height="1100" loading={i === 0 ? "eager" : "lazy"} decoding="async" data-ab-frame={chapter.id} data-on={i === 0 ? "" : undefined} />
					))}
				</div>
			</div>
		</div>
		<dl class="ab-also">
			{also.map((entry) => (
				<div>
					<dt>{entry.title}</dt>
					<dd>{entry.body}</dd>
				</div>
			))}
		</dl>
	</section>

	<section id="memory" class="ab-sec ab-split">
		<div>
			<div class="ab-head">
				<h2>It remembers, in three stores.</h2>
				<p class="ab-lead">Most agents forget everything between sessions. This one writes what it learns to three databases, each good at one kind of recall.</p>
			</div>
			<dl class="ab-rows">
				{stores.map((store) => (
					<div>
						<dt>{store.title}</dt>
						<dd>{store.body}</dd>
					</div>
				))}
			</dl>
		</div>
		<div class="ab-split-media">
			<Shot src={`${media}/tour/graph.webp`} alt="The console's memory graph: you at the centre, linked to people, projects and preferences" width={1920} height={1200} />
		</div>
	</section>

	<section id="results" class="ab-sec">
		<div class="ab-head ab-head-split">
			<h2>Tested on real runs.</h2>
			<p class="ab-lead">From the tests behind the deck, and chapter 5 of the report in milliseconds, average and 95th percentile.</p>
		</div>
		<ul class="ab-figures">
			{proof.map((figure) => (
				<li>
					<span class="ab-figure">{figure.value}</span>
					<span class="ab-figure-label">{figure.label}</span>
				</li>
			))}
		</ul>
		<div class="ab-tables">
			<div class="ld-table-wrap">
				<table class="ld-table">
					<caption>Memory</caption>
					<thead>
						<tr><th scope="col">Operation</th><th scope="col">Average</th><th scope="col">p95</th></tr>
					</thead>
					<tbody>
						{memory.map(([name, avg, p95]) => <tr><th scope="row">{name}</th><td>{avg}</td><td>{p95}</td></tr>)}
					</tbody>
				</table>
			</div>
			<div class="ld-table-wrap">
				<table class="ld-table">
					<caption>First response, by provider, as tested for the report</caption>
					<thead>
						<tr><th scope="col">Provider</th><th scope="col">Model</th><th scope="col">Average</th><th scope="col">p95</th></tr>
					</thead>
					<tbody>
						{providers.map(([name, model, avg, p95]) => <tr><th scope="row">{name}</th><td>{model}</td><td>{avg}</td><td>{p95}</td></tr>)}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section id="models" class="ab-sec">
		<div class="ab-head ab-head-split">
			<h2>Any model, or your plan.</h2>
			<p class="ab-lead">Six providers are built in, and any endpoint that speaks the OpenAI, Anthropic or Gemini API works too. Model ids are current as of November 2026, from models.dev.</p>
		</div>
		<div class="ld-table-wrap">
			<table class="ld-table ab-models">
				<caption>Built-in providers and the plans it runs on</caption>
				<thead>
					<tr><th scope="col">Provider</th><th scope="col">Current models</th></tr>
				</thead>
				<tbody>
					{models.map((row) => <tr><th scope="row">{row.name}</th><td class="ab-ids">{row.note && `${row.note} `}{row.ids.map((id, i) => <>{i > 0 && ", "}<code>{id}</code></>)}</td></tr>)}
					<tr class="ab-plan-row"><th scope="row">Your subscription</th><td>{plans.join(", ")}, each through its own agent, logged in as you</td></tr>
				</tbody>
			</table>
		</div>
		<dl class="ab-compat">
			{compatible.map((entry) => (
				<div>
					<dt>{entry.title}</dt>
					<dd>{entry.body}</dd>
				</div>
			))}
		</dl>
	</section>

	<section id="deck" class="ab-sec">
		<div class="ab-head ab-head-row">
			<div>
				<h2>The deck.</h2>
				<p class="ab-lead">The May defence in 18 slides, then eight on what's new since.</p>
			</div>
			<DeckOpen />
		</div>
		<Deck slides={slides} title="Agentic Browser deck" width={1280} height={853} />
	</section>

	<section id="commands" class="ab-sec">
		<div class="ab-head ab-head-split">
			<h2>Slash commands.</h2>
			<p class="ab-lead">Each one is a tool the agents can also call on their own.</p>
		</div>
		<dl class="ab-commands">
			{commands.map((command) => (
				<div>
					<dt><code>{command.title}</code></dt>
					<dd>{command.body}</dd>
				</div>
			))}
		</dl>
	</section>

	<section id="install" class="ab-sec">
		<div class="ab-band">
			<div class="ab-head">
				<h2>One command, everything.</h2>
				<p class="ab-lead">macOS or Linux. It clones the repo into ~/agentic&#8209;browser and asks before anything that touches your machine.</p>
			</div>
			<div class="ab-cmd ab-cmd-big">
				<code>{install}</code>
				<button type="button" class="ab-copy" data-copy={install} aria-label="Copy the install command"><Copy aria-hidden="true" /><span data-copy-label>Copy</span></button>
			</div>
			<ol class="ab-install-steps">
				{steps.map((step) => (
					<li>
						<h3>{step.title}</h3>
						<p>{step.body}</p>
					</li>
				))}
			</ol>
			<p class="ab-small">Add <code>-s -- --yes</code> after <code>sh</code> to take every default, or <code>--dry-run</code> to see what it would do. <a href={`${repo}/blob/main/install.sh`} target="_blank" rel="noopener noreferrer">Read install.sh</a> before you pipe it into a shell.</p>
		</div>
	</section>

	<section id="faq" class="ab-sec ab-side">
		<div class="ab-head">
			<h2>Questions.</h2>
		</div>
		<Faq items={faq} />
	</section>

	<section id="papers" class="ab-sec ab-side ab-last">
		<div class="ab-head">
			<h2>Report, deck and source.</h2>
		</div>
		<Routes routes={papers} />
	</section>
</Landing>

<script>
	// Copy the install command, with the label confirming it.
	document.querySelectorAll<HTMLButtonElement>("[data-landing='agentic-browser'] [data-copy]").forEach((button) => {
		const label = button.querySelector<HTMLElement>("[data-copy-label]");
		button.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy || "");
				if (label) label.textContent = "Copied";
				setTimeout(() => label && (label.textContent = "Copy"), 1600);
			} catch {}
		});
	});

	// The tour: on a wide screen the stage holds one frame while the chapters
	// scroll past, and swaps to the chapter nearest the middle of the screen.
	document.querySelectorAll<HTMLElement>("[data-ab-tour]").forEach((root) => {
		const panels = [...root.querySelectorAll<HTMLElement>("[data-ab-panel]")];
		const frames = [...root.querySelectorAll<HTMLElement>("[data-ab-frame]")];
		root.dataset.wired = "";
		const show = (id: string) => {
			panels.forEach((p) => p.toggleAttribute("data-on", p.dataset.abPanel === id));
			frames.forEach((f) => f.toggleAttribute("data-on", f.dataset.abFrame === id));
		};
		const seen = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) if (entry.isIntersecting) show((entry.target as HTMLElement).dataset.abPanel || "");
			},
			{ rootMargin: "-45% 0px -45% 0px" },
		);
		panels.forEach((p) => seen.observe(p));
	});
</script>

<style>
	/* Hallmark · redesign: full · shape: workbench · genre: modern-minimal · theme: brand, the landing kit's --ld-* tokens (the site's theme switcher sets them) · hero: Stage, the film on seven columns · signature: the pinned tour, seven real frames from the film swapping as the chapters scroll · sections: hero, loop with the architecture, tour, memory split, results, models, deck, commands, install band, questions, papers */
	/* critique: the old page stacked the same head-then-rows block eleven times; now each section has its own composition and the product is shown, not listed */
	/* Hallmark · dismiss F1 · the owner's house style is straight quotes everywhere */
	/* Hallmark · waive 26b · no control on this page is ever disabled, no aria-disabled anywhere · copy buttons and deck controls always work, so a disabled look would never show */

	.ab-sec {
		scroll-margin-top: var(--ld-sticky-top);
		padding-top: var(--ld-gap-m);
	}
	.ab-last {
		padding-bottom: var(--ld-gap-s);
	}
	.ab-head {
		display: grid;
		gap: var(--ld-space-md);
		margin-bottom: var(--ld-space-2xl);
	}
	.ab-head h2 {
		margin: 0;
		text-wrap: balance;
		font-family: var(--ld-font-display);
