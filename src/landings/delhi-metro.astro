---
/**
 * Delhi NCR Metro. Replaces the README at /projects/delhi-metro. Screens
 * live in public/landings/delhi-metro. The walkthroughs stream from taf.sh.
 */
import { Download, Globe } from "lucide-react";
import {
	Landing,
	LandingHero,
	Section,
	Shot,
	LandingVideo,
	Pinned,
	Rows,
	Faq,
	Routes,
} from "@/components/landing";
import { REPO_ADD_URL } from "@/lib/fdroid";
import { playStoreRoute } from "@/data/profile";
import type { LandingMeta } from "@/lib/landings";
import type { Project } from "@/types";

export const landing: LandingMeta = {
	tagline:
		"Delhi Metro and Noida Metro in one trip planner, on Android and the web, with the API behind it.",
	cta: { label: "Get the app", href: "#get" },
};

interface Props {
	project: Project;
}

const { project } = Astro.props;
const media = "/landings/delhi-metro";
const webApp = "https://ncr-metro.tashif.codes";

const release = (project.releases ?? []).find((r) => !r.draft && !r.prerelease);
const apk = release?.assets.find((a) => a.name.toLowerCase().endsWith(".apk"));
const apkHref = apk?.download_url ?? `${project.github_link}/releases/latest`;

const screen = { width: 600, height: 1298 };
const shot = (name: string, alt: string) => ({
	src: `${media}/screens/${name}.webp`,
	alt,
});

const chapters = [
	{
		title: "Plan a trip",
		features: [
			{
				title: "Shortest, or fewest changes",
				body: "Both routes side by side, with time, fare, every station and where to change.",
			},
			{
				title: "Fares for the day you travel",
				body: "Weekday and weekend fares, plus first and last train times.",
			},
			{
				title: "Book on WhatsApp",
				body: "A journey opens the operator's ticket chat, one step per operator.",
			},
		],
		shots: [
			shot("journey", "A journey from AIIMS to Noida Sector 137"),
			shot("route", "The route drawn on the network map"),
			shot("fares", "Fares for the journey"),
		],
	},
	{
		title: "Two operators",
		features: [
			{
				title: "Delhi to Noida in one plan",
				body: "DMRC and NMRC don't share tickets. The app joins the trip at Sector 52 and 51 with a walk between them.",
			},
			{
				title: "Two fares, shown as two",
				body: "You see what to pay each operator, and where to buy the second ticket.",
			},
		],
		shots: [
			shot("cross", "A trip that crosses from Delhi Metro to the Aqua Line"),
			shot("transfer", "The walk between Sector 52 and Sector 51"),
			shot("split-fare", "A fare split between the two operators"),
		],
	},
	{
		title: "Stations",
		features: [
			{
				title: "Search by name or code",
				body: "Either operator's station code works.",
			},
			{
				title: "What is at the station",
				body: "Gates, lifts, platforms, facilities, parking and what is nearby.",
			},
		],
		shots: [
			shot("search", "Station search"),
			shot("gates", "Gates at a station"),
			shot("lifts", "Lifts and platforms at a station"),
		],
	},
	{
		title: "Map and alerts",
		features: [
			{
				title: "A map you can zoom",
				body: "Drawn from station coordinates, with search and a sheet for the station you tap. The official maps are one tap away.",
			},
			{
				title: "Service alerts",
				body: "From both operators, in one list.",
			},
			{
				title: "Works with no signal",
				body: "Lines, stations, alerts and the journeys you already planned stay readable offline.",
			},
		],
		shots: [
			shot("map", "The network map"),
			shot("lines", "Lines with their stations"),
			shot("alerts", "Service alerts"),
		],
	},
];

const api = [
	{
		title: "/api/v1/dmrc and /api/v1/nmrc",
		body: "Lines, stations, fares, timings and maps for each operator, in one shared schema.",
	},
	{
		title: "/api/v2/journeys/plan",
		body: "Plans through the Delhi Metro Sarthi API, and falls back to the older planner when Sarthi times out. The response says which one answered.",
	},
	{
		title: "No key",
		body: "JSON over REST with no auth. Swagger at /docs, OpenAPI at /openapi.json, and a playground to try calls.",
	},
];

const routes = [
	{
		title: "F-Droid",
		body: 'Add my repo under Settings, Repositories, then install Delhi NCR Metro. <a href="/fdroid">Setup steps</a>',
		copy: REPO_ADD_URL,
	},
	{
		title: "APK",
		body: release
			? `${release.tag_name}, straight from GitHub releases.`
			: "The newest build from GitHub releases.",
		action: { label: "Download APK", href: apkHref, primary: true },
	},
	{
		title: "Browser",
		body: "The same app at ncr-metro.tashif.codes. Nothing to install.",
		action: { label: "Open the web app", href: webApp, external: true },
	},
	playStoreRoute("delhi-metro"),
];

const faq = [
	{
		q: "Is this an official app?",
		a: "No. It is not made by DMRC or NMRC. It reads their public services and pages.",
	},
	{
		q: "Can I buy tickets in it?",
		a: "Not inside the app. It opens the operator's WhatsApp ticket chat for the journey, and you pick the stations again there.",
	},
	{
		q: "Does it track my location?",
		a: "The Android app asks for no location permission.",
	},
	{
		q: "Is there an iPhone app?",
		a: `Not on the App Store. The web app at <a href="${webApp}" target="_blank" rel="noopener noreferrer">ncr-metro.tashif.codes</a> works on an iPhone.`,
	},
];
---

<Landing name="delhi-metro">
	<LandingHero
		title="Two metros, one plan."
		lead="Plan a trip across Delhi Metro and the Noida Aqua Line, with the fare for each."
	>
		<Fragment slot="actions">
			<a href={apkHref} data-haptic-external class="ld-btn ld-btn-primary">
				<Download aria-hidden="true" />
				Download APK
			</a>
			<a
				href={webApp}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class="ld-btn"
			>
				<Globe aria-hidden="true" />
				Open the web app
			</a>
		</Fragment>
		<Fragment slot="terms">Android 7.0 and up, and any browser. Free under MIT.</Fragment>
		<Shot slot="media" width={720} height={1280}>
			<LandingVideo
				src="https://taf.sh/media/delhi-metro/cuts/phone.mp4"
				poster="https://taf.sh/media/delhi-metro/cuts/phone.jpg"
				label="Delhi NCR Metro on a phone: planning a trip from AIIMS to Karkarduma Court"
				controls
			/>
		</Shot>
	</LandingHero>

	<Section id="features" title="What the app does." gap="s">
		<Pinned chapters={chapters} {...screen} />
	</Section>

	<Section
		id="web"
		title="The same app in a browser."
		lead="The web app and the Android app, planning the same trips side by side."
		gap="l"
	>
		<Shot width={1280} height={800}>
			<LandingVideo
				src="https://taf.sh/media/delhi-metro/demo.mp4"
				poster="https://taf.sh/media/delhi-metro/poster.jpg"
				label="Delhi NCR Metro walkthrough on the web and on Android"
				controls
			/>
		</Shot>
	</Section>

	<Section
		id="api"
		title="The API under it."
		lead="I wrapped both operators' services into one contract. Use it for your own app."
		layout="side"
	>
		<Rows rows={api} />
		<p class="api-try">
			<code class="ld-code">curl {webApp}/api/v1/dmrc/lines</code>
			<a class="ld-link" href={`${webApp}/api/playground`} target="_blank" rel="noopener noreferrer">
				Open the playground
			</a>
		</p>
	</Section>

	<Section id="faq" title="Before you install." layout="side" gap="l">
		<Faq items={faq} />
	</Section>

	<Section id="get" title="Get the app." layout="side">
		<Routes routes={routes} />
	</Section>
</Landing>

<style>
	.api-try {
		display: grid;
		gap: var(--ld-space-md);
		justify-items: start;
		margin-top: var(--ld-space-lg);
	}
</style>
