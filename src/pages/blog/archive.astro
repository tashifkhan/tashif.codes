---
import PageShell from "../../layouts/PageShell.astro";
import BlogFilters from "../../components/blog/BlogFilters";
import BlogCard from "../../components/blog/BlogCard.astro";
import EmptyState from "../../components/common/EmptyState.astro";
import DataFreshness from "../../components/common/DataFreshness";
import { ExternalLink } from "lucide-react";
import { blogPosts, blogFetchedAt, blogCategories, avgReadingMinutes, numBlogPosts, totalBlogWords } from "../../data/blog";
---

<PageShell
	title="Blog Archive | Tashif Ahmad Khan"
	tint="orange"
	breadcrumbs={[
		{ label: "Home", href: "/" },
		{ label: "Blog", href: "/blog" },
		{ label: "Archive" },
	]}
>
	<Fragment slot="header">
		<div class="mb-4">
			<div class="flex items-center justify-between gap-4">
				<h1
					class="font-sans text-4xl sm:text-5xl font-semibold tracking-tight text-foreground"
				>
					Blog
				</h1>
				<a
					href="https://blog.tashif.codes"
					data-haptic-external
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full bg-primary/10 text-primary ring-1 ring-primary/25 hover:bg-primary/20 hover:ring-primary/40 transition-colors shrink-0"
				>
					Full archive
					<ExternalLink className="w-3.5 h-3.5" />
				</a>
			</div>
			<p class="mt-2 sm:mt-3 max-w-xl text-sm sm:text-base text-muted-foreground">
				Guides, deep dives, and notes on web systems, tooling, and low-level
				internals.
			</p>
			<div class="mt-3">
				<DataFreshness
					client:load
					source="blog"
					fetchedAt={blogFetchedAt}
					label="Blog posts"
					description="Re-fetch titles, excerpts, tags, and reading times from the live blog API. Engagement (views, likes, comments) is only loaded on individual post pages."
				/>
			</div>
			<div
				class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs sm:text-sm text-muted-foreground"
			>
				<span>
					<span
						class="font-semibold text-foreground tabular-nums"
						data-blog-post-count>{numBlogPosts}</span
					> posts
				</span>
				{
					avgReadingMinutes > 0 && (
						<span>
							<span
								class="font-semibold text-foreground tabular-nums"
								data-blog-avg-read
							>
								{avgReadingMinutes}
							</span>
							min avg read
						</span>
					)
				}
				{
					totalBlogWords > 0 && (
						<span>
							<span class="font-semibold text-foreground tabular-nums">
								{totalBlogWords.toLocaleString("en-US")}
							</span>
							words
						</span>
					)
				}
			</div>
		</div>
	</Fragment>

	<div class="mb-10">
		<BlogFilters client:load categories={blogCategories} />
	</div>

	{
		blogPosts.length > 0 ? (
			<div class="space-y-10">
				<section class="mb-2">
					<BlogCard post={blogPosts[0]} variant="featured" index={0} />
				</section>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
					{blogPosts.slice(1).map((post, idx) => (
						<BlogCard post={post} variant="default" index={idx + 1} />
					))}
				</div>
			</div>
		) : (
			<div class="py-14">
				<EmptyState
					command="ls ./blog"
					title="no posts available"
					description="Unable to load blog posts from the external API. Try again later or visit the blog directly."
					ctaLabel="visit blog"
					ctaHref="https://blog.tashif.codes"
					ctaExternal
				/>
			</div>
		)
	}
</PageShell>

<script>
	function fuzzySearch(text: string, query: string): boolean {
		if (!query.trim()) return true;
		const textLower = text.toLowerCase();
		const queryLower = query.toLowerCase();
		if (textLower.includes(queryLower)) return true;
		let queryIndex = 0;
		for (
			let i = 0;
			i < textLower.length && queryIndex < queryLower.length;
			i++
		) {
			if (textLower[i] === queryLower[queryIndex]) queryIndex++;
		}
		return queryIndex === queryLower.length;
	}

	function applyBlogVisibility() {
		const term = (window as any).__blogSearchTerm || "";
		const categories: string[] = (window as any).__blogCategories || ["all"];
		const cards = document.querySelectorAll<HTMLElement>("[data-blog-card]");

		cards.forEach((card) => {
			const title = card.querySelector("[data-blog-title]")?.textContent || "";
			const excerpt =
				card.querySelector("[data-blog-excerpt]")?.textContent || "";
			const tags = (card.getAttribute("data-blog-tags") || "")
				.split(",")
				.map((t) => t.trim().toLowerCase())
				.filter(Boolean);

			const matchesSearch =
				!term.trim() ||
				fuzzySearch(title, term) ||
				fuzzySearch(excerpt, term) ||
				tags.some((tag) => fuzzySearch(tag, term));

			const matchesCategory =
				categories.includes("all") ||
				categories.some((c) => tags.includes(c.toLowerCase()));

			const visible = matchesSearch && matchesCategory;
			card.style.display = visible ? "" : "none";
			const parent = card.parentElement;
			if (parent && parent !== document.body) {
				// Keep grid cells tidy when a card is hidden
				if (parent.childElementCount === 1) {
					parent.style.display = visible ? "" : "none";
				}
			}
		});
	}

	document.addEventListener("blog-search", (e: Event) => {
		const detail = (e as CustomEvent).detail || {};
		(window as any).__blogSearchTerm = detail.term || "";
		applyBlogVisibility();
	});

	document.addEventListener("blog-category", (e: Event) => {
		const detail = (e as CustomEvent).detail || {};
		(window as any).__blogCategories = detail.categories || ["all"];
		applyBlogVisibility();
	});
</script>
