---
import PageShell from "../../layouts/PageShell.astro";
import BlogFilters from "../../components/blog/BlogFilters";
import BlogList from "../../components/blog/BlogList.astro";
import EmptyState from "../../components/common/EmptyState.astro";
import DataFreshness from "../../components/common/DataFreshness";
import { ExternalLink, Rss } from "lucide-react";
import { blogPosts, blogFetchedAt, blogTags, avgReadingMinutes, numBlogPosts, totalBlogWords } from "../../data/blog";
---

<PageShell
	title="Blog Archive | Tashif Ahmad Khan"
	image="/og/blog.jpg"
	tint="orange"
	compact
	noindex
	breadcrumbs={[
		{ label: "Home", href: "/" },
		{ label: "Blog", href: "/blog" },
		{ label: "Archive" },
	]}
>
	<Fragment slot="header">
		<div>
			<div class="flex items-center justify-between gap-4">
				<h1
					class="font-sans text-2xl sm:text-3xl font-bold tracking-tight text-primary leading-none pb-0.5"
				>
					Blog
				</h1>
				<div class="flex items-center gap-2 shrink-0">
				<a
					href="https://blog.tashif.codes"
					data-haptic-external
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full bg-primary/10 text-primary ring-1 ring-primary/25 hover:bg-primary/20 hover:ring-primary/40 transition-colors shrink-0"
				>
					Full archive
					<ExternalLink className="w-3.5 h-3.5" />
				</a>
				<a
					href="/rss.xml"
					data-haptic-nav
					class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full text-muted-foreground ring-1 ring-border/60 hover:text-primary hover:ring-primary/40 transition-colors shrink-0"
					aria-label="Subscribe to the blog RSS feed"
					title="Subscribe via RSS"
				>
					<Rss className="w-3.5 h-3.5" />
					RSS
				</a>
				</div>
			</div>
			<p class="mt-2 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed">
				Guides, deep dives, and notes on web systems, tooling, and low-level
				internals.
			</p>
			<div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
				<DataFreshness
					client:load
					source="blog"
					fetchedAt={blogFetchedAt}
					label="Blog posts"
					description="Re-fetch titles, excerpts, tags, and reading times from the live blog API. Engagement (views, likes, comments) is only loaded on individual post pages."
				/>
			<div
				class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs sm:text-sm text-muted-foreground"
			>
				<span>
					<span
						class="font-semibold text-foreground tabular-nums"
						data-blog-post-count>{numBlogPosts}</span
					> posts
				</span>
				{
					avgReadingMinutes > 0 && (
						<span>
							<span
								class="font-semibold text-foreground tabular-nums"
								data-blog-avg-read
							>
								{avgReadingMinutes}
							</span>
							min avg read
						</span>
					)
				}
				{
					totalBlogWords > 0 && (
						<span>
							<span class="font-semibold text-foreground tabular-nums">
								{totalBlogWords.toLocaleString("en-US")}
							</span>
							words
						</span>
					)
				}
			</div>
			</div>
		</div>
	</Fragment>

	<BlogFilters client:load tags={blogTags} listId="blog-list-archive" />

	{
		blogPosts.length > 0 ? (
			<BlogList id="blog-list-archive" posts={blogPosts} eager />
		) : (
			<div class="py-14">
				<EmptyState
					command="ls ./blog"
					title="no posts available"
					description="Unable to load blog posts from the external API. Try again later or visit the blog directly."
					ctaLabel="visit blog"
					ctaHref="https://blog.tashif.codes"
					ctaExternal
				/>
			</div>
		)
	}
</PageShell>
