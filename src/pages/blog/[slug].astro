---
/**
 * One blog post.
 *
 * Layout: the title and cover share a 65rem frame; below it the article
 * (46rem) and the contents rail (15.5rem) sit as one centered pair. Phones get
 * a collapsible contents block and a bar pinned to the bottom with Like,
 * Discuss, Share and Contents.
 *
 * Everything interactive lives in src/scripts/blogPost.ts, which wires the
 * page once per visit and tears down on navigation. The page only renders
 * markup and hands the build-time engagement snapshot to the script.
 */
import Layout from "../../layouts/Layout.astro";
import MarkdownRenderer from "../../components/common/markdown/MarkdownRenderer.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import {
	ArrowLeft,
	Calendar,
	Clock,
	ExternalLink,
	Eye,
	Github,
	Heart,
	Link2,
	Linkedin,
	ListTree,
	MessageCircle,
	Rss,
	Send,
	Twitter,
} from "lucide-react";
import {
	allBlogPosts,
	fetchFullPost,
	estimateReadingStats,
	getAdjacentPosts,
	getRelatedPosts,
	resolveCoverImage,
	resolveReadingTimeMinutes,
	BLOG_API_BASE,
	BLOG_REPO_URL,
	BLOG_SITE_ORIGIN,
} from "../../data/blog";
import { RENDERER_VERSION } from "../../components/common/markdown/index";
import { countComments, formatPostDate, topicSlug } from "../../lib/blog-shared";
import { owner, socials } from "../../data/profile";
import { absoluteUrl, resolveSocialImage } from "../../lib/seo";
import type { BlogComment, BlogHeading, BlogPost } from "@/types";
import "../../styles/blog-post.css";

export async function getStaticPaths() {
	// Unlisted posts still get a page; they are only left out of lists.
	return allBlogPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: BlogPost };

let markdown = "";
let initialViews = 0;
let initialLikes = 0;
let initialComments: BlogComment[] = [];
let fullMetadata: Record<string, unknown> = {};
let tocHeadings: BlogHeading[] = [];
let outlineMinutes = 0;
let outlineWords = 0;
let bodyHasToc = false;

try {
	const fullPost = await fetchFullPost(post.slug);
	markdown = fullPost.markdown;
	initialViews = fullPost.metrics.views;
	initialLikes = fullPost.metrics.likes;
	initialComments = fullPost.comments ?? [];
	fullMetadata = fullPost.metadata ?? {};
	outlineMinutes = fullPost.outline?.readingTimeMinutes ?? 0;
	outlineWords = fullPost.outline?.wordCount ?? 0;
	// Most posts place their own <Toc /> in the body; phones use that one.
	bodyHasToc = (fullPost.outline?.components ?? []).includes("Toc");

	// The API derives headings with the renderer's own rules, so the contents
	// list is known at build time. h2 and h3 only.
	tocHeadings = (fullPost.outline?.headings ?? []).filter(
		(heading) => heading.depth === 2 || heading.depth === 3,
	);

	// A post written against a newer component vocabulary renders unknown
	// tags as raw HTML. The fix is to port the component under
	// markdown/blocks/, so make it loud in the build log.
	const postRenderer = fullPost.outline?.renderer ?? fullPost.renderer;
	if (postRenderer && postRenderer !== RENDERER_VERSION) {
		console.warn(
			`[blog] "${post.slug}" was written for renderer ${postRenderer}, ` +
				`but this site's renderer is ${RENDERER_VERSION}. ` +
				`Any component added since then needs porting to ` +
				`src/components/common/markdown/blocks/.`,
		);
	}
} catch (err) {
	console.error("Error fetching full post:", err);
}

// Same number the list card shows: the API outline skips code and component
// tags. The raw-markdown estimate is only a last resort.
const readingTime =
	outlineMinutes > 0
		? outlineMinutes
		: post.readingTimeMinutes
			? resolveReadingTimeMinutes(post)
			: estimateReadingStats(markdown).readingTimeMinutes;

const tags = Array.isArray(post.tags) ? post.tags : [];
const authorName = post.author || owner.name;
const dateText = formatPostDate(post.date, "long");
const postUrl = absoluteUrl(`/blog/${post.slug}`);
const originalUrl = `${BLOG_SITE_ORIGIN}/blog/${post.slug}`;
const coverUrl = resolveCoverImage({
	coverImage: post.coverImage,
	metadata: { ...fullMetadata, ...post.metadata },
});
const socialImage = resolveSocialImage({ image: coverUrl, blogSlug: post.slug });
const totalComments = countComments(initialComments);
const hasToc = tocHeadings.length >= 2;
// The phone contents block only appears when the post has no <Toc /> of its own.
const showMobileToc = hasToc && !bodyHasToc;

const { newer, older } = getAdjacentPosts(post.slug);
const related = getRelatedPosts(
	{ ...post, metadata: { ...fullMetadata, ...post.metadata } },
	{ exclude: [newer?.slug, older?.slug].filter((s): s is string => !!s) },
);

const followLinks = [
	{ label: "Follow on X", match: "Twitter", Icon: Twitter },
	{ label: "LinkedIn", match: "LinkedIn", Icon: Linkedin },
	{ label: "GitHub", match: "GitHub", Icon: Github },
].flatMap(({ label, match, Icon }) => {
	const link = socials.find((s) => s.label === match)?.link;
	return link ? [{ label, href: link, Icon }] : [];
});

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	...(post.excerpt ? { description: post.excerpt } : {}),
	datePublished: post.date,
	image: socialImage,
	url: postUrl,
	mainEntityOfPage: postUrl,
	...(tags.length ? { keywords: tags.join(", ") } : {}),
	...(outlineWords > 0 ? { wordCount: outlineWords } : {}),
	author: { "@type": "Person", name: authorName, url: absoluteUrl("/") },
};

// Build-time engagement, shown until the live values arrive.
const initialData = JSON.stringify({
	views: initialViews,
	likes: initialLikes,
	comments: initialComments,
}).replace(/</g, "\\u003c");

const tocLinkClass = "toc-link";
---

<Layout
	title={`${post.title} | Blog | ${owner.name}`}
	description={post.excerpt || undefined}
	image={socialImage}
	url={`/blog/${post.slug}`}
	type="article"
	publishedTime={post.date}
	tags={tags}
	noindex
	jsonLd={jsonLd}
>
	<div
		id="reading-progress"
		class="fixed top-0 left-0 h-[3px] bg-primary z-[60]"
		style="width:0;transition:width 80ms linear,opacity 180ms ease"
	>
	</div>

	<div
		data-page-surface
		data-blog-post
		data-slug={post.slug}
		data-api-base={BLOG_API_BASE}
		class="relative min-h-screen bg-background"
	>
		<script type="application/json" data-blog-post-initial set:html={initialData} />

		<header
			class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
		>
			<div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
				<a
					href="/blog"
					data-haptic-back
					class="group inline-flex shrink-0 items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
				>
					<ArrowLeft size={15} className="transition-transform duration-200 group-hover:-translate-x-0.5" />
					<span class="font-medium">Blog</span>
				</a>
				<p
					class="post-head-title hidden min-w-0 flex-1 truncate text-center font-mono text-xs text-muted-foreground sm:block"
					data-post-head-title
					aria-hidden="true"
				>
					{post.title}
				</p>
				<div class="ml-auto flex shrink-0 items-center gap-3">
					<span class="hidden items-center gap-1.5 font-mono text-xs text-muted-foreground md:flex">
						<Clock size={12} />{readingTime} min
					</span>
					<a
						href="https://taf.sh"
						target="_blank"
						rel="noopener noreferrer"
						data-haptic-external
						class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/5 px-3 py-1.5 text-xs font-medium text-primary transition-all hover:bg-primary/15"
					>
						taf.sh <ExternalLink size={11} />
					</a>
				</div>
			</div>
		</header>

		<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
			<div
				class:list={[
					"rise-in grid items-center gap-6",
					coverUrl && "md:grid-cols-[minmax(0,1fr)_minmax(0,19rem)] lg:grid-cols-[minmax(0,1fr)_21.25rem]",
				]}
			>
				{
					coverUrl && (
						<div class="aspect-[16/9] overflow-hidden rounded-xl border border-border/60 bg-muted/20 shadow-sm md:order-2">
							<img
								src={coverUrl}
								alt=""
								width="1200"
								height="675"
								fetchpriority="high"
								decoding="async"
								class="h-full w-full object-cover"
							/>
						</div>
					)
				}
				<div class="min-w-0">
					{
						tags.length > 0 && (
							<div class="mb-4 flex flex-wrap gap-2">
								{tags.map((tag) => (
									<a
										href={`/blog?topic=${topicSlug(tag)}`}
										data-haptic-nav
										class="rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 font-mono text-[11px] font-semibold tracking-wider text-primary transition-colors hover:border-primary/50"
									>
										{tag}
									</a>
								))}
							</div>
						)
					}
					<h1
						class="font-display text-balance text-3xl font-bold leading-[1.12] tracking-tight text-foreground sm:text-4xl lg:text-[2.75rem]"
						data-post-title
					>
						{post.title}
					</h1>
					<div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
						<span class="font-medium text-foreground/85">{authorName}</span>
						<span class="flex items-center gap-1.5">
							<Calendar size={13} className="text-primary" />
							<time datetime={post.date}>{dateText}</time>
						</span>
						<span class="flex items-center gap-1.5">
							<Clock size={13} className="text-primary" />
							{readingTime} min read
						</span>
						<span class="flex items-center gap-1.5">
							<Eye size={13} className="text-primary" />
							<span data-post-views class="tabular-nums">{initialViews}</span>&thinsp;views
						</span>
						<span class="flex items-center gap-1.5">
							<Heart size={13} className="text-primary" />
							<span data-post-likes-count class="tabular-nums">{initialLikes}</span>&thinsp;likes
						</span>
					</div>
				</div>
			</div>

			<div
				class="mt-9 border-t border-border/60 pt-8 lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-10 xl:gap-14"
			>
				<article id="article-content" class="blog-article w-full min-w-0">
					{
						showMobileToc && (
							<details class="mb-8 rounded-xl border border-border/60 bg-card/60 lg:hidden" data-post-toc-mobile>
								<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-mono text-[13px] font-semibold">
									Contents
									<span class="font-normal text-muted-foreground">{tocHeadings.length} sections</span>
								</summary>
								<nav aria-label="Contents" class="px-4 pb-4">
									{tocHeadings.map((h) => (
										<a href={`#${h.slug}`} class={tocLinkClass} data-toc-link data-depth={h.depth}>
											{h.text}
										</a>
									))}
								</nav>
							</details>
						)
					}

					{
						markdown ? (
							<MarkdownRenderer
								content={markdown}
								githubBaseUrl={BLOG_REPO_URL}
								githubProfileUrl="https://github.com/tashifkhan"
								source="post"
								assetBaseUrl={BLOG_SITE_ORIGIN}
							/>
						) : (
							<div class="rounded-xl border border-border/60 bg-card/50 py-20 text-center text-muted-foreground">
								<p class="mb-3 text-base">Content couldn't be loaded.</p>
								<a href={originalUrl} class="text-sm text-primary hover:underline">
									Read it on blog.tashif.codes
								</a>
							</div>
						)
					}

					<section class="mt-14" aria-label="About the author">
						<div class="flex flex-wrap items-center gap-4 border-y border-border/60 py-5">
							<img
								src={owner.avatar}
								alt=""
								width="48"
								height="48"
								loading="lazy"
								class="h-12 w-12 rounded-full border border-border/60"
							/>
							<div class="min-w-0">
								<p class="font-semibold text-foreground">{authorName}</p>
								<p class="text-sm text-muted-foreground">More at tashif.codes and taf.sh.</p>
							</div>
							<div class="flex w-full flex-wrap gap-2 sm:ml-auto sm:w-auto">
								{followLinks.map(({ label, href, Icon }) => (
									<a
										href={href}
										target="_blank"
										rel="noopener noreferrer"
										data-haptic-external
										class="follow-link"
									>
										<Icon size={14} />
										{label}
									</a>
								))}
								<a href="/rss.xml" data-haptic-nav class="follow-link">
									<Rss size={14} />
									RSS
								</a>
							</div>
						</div>
						<div class="flex flex-wrap items-center gap-2.5 border-b border-border/60 py-4">
							<p class="mr-auto w-full text-[15px] text-muted-foreground sm:w-auto">Found this useful?</p>
							<button type="button" class="post-act-row" data-post-like data-haptic="selection" aria-pressed="false">
								<Heart size={15} />
								Like · <span data-post-likes-count class="tabular-nums">{initialLikes}</span>
							</button>
							<button type="button" class="post-act-row" data-post-share data-haptic>
								<Link2 size={15} />
								<span data-share-label>Share</span>
							</button>
						</div>

						{
							(newer || older) && (
								<nav aria-label="More posts" class="mt-7 grid gap-3 sm:grid-cols-2">
									{newer ? (
										<a href={`/blog/${newer.slug}`} data-haptic-nav class="adjacent-link">
											<span class="font-mono text-[11px] text-muted-foreground">← Newer</span>
											<span class="adjacent-title">{newer.title}</span>
										</a>
									) : (
										<span class="hidden sm:block" />
									)}
									{older && (
										<a href={`/blog/${older.slug}`} data-haptic-nav class="adjacent-link sm:text-right">
											<span class="font-mono text-[11px] text-muted-foreground">Older →</span>
											<span class="adjacent-title">{older.title}</span>
										</a>
									)}
								</nav>
							)
						}

						{
							related.length > 0 && (
								<div class="mt-10">
									<h2 class="mb-4 font-mono text-[13px] font-semibold text-muted-foreground">Read next</h2>
									<div class="grid gap-4 sm:grid-cols-3">
										{related.map((p) => (
											<BlogCard post={p} variant="compact" />
										))}
									</div>
								</div>
							)
						}
					</section>

					<section id="comments-section" class="mt-14 scroll-mt-20" aria-labelledby="comments-heading">
						<div class="mb-1 flex items-center gap-2.5">
							<h2 id="comments-heading" class="text-xl font-bold tracking-tight">Discussion</h2>
							<span
								class="rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 font-mono text-[11px] text-primary"
								data-comment-count
							>
								{totalComments}
							</span>
						</div>
						<p class="mb-5 flex items-center gap-2 font-mono text-[11.5px] text-muted-foreground" data-comments-status>
							<span class="h-1.5 w-1.5 rounded-full bg-muted-foreground/60" data-comments-dot></span>
							<span data-comments-status-text>Loading the latest comments</span>
						</p>

						<form class="grid gap-3 rounded-xl border border-border/60 bg-card/60 p-5 backdrop-blur-sm" data-comment-form novalidate>
							<label class="grid gap-1.5 text-sm font-medium">
								Name
								<input name="name" autocomplete="name" maxlength="120" required class="post-input" />
							</label>
							<label class="grid gap-1.5 text-sm font-medium">
								Comment
								<textarea name="text" rows="4" maxlength="5000" required class="post-input resize-y"></textarea>
							</label>
							<div class="flex items-center gap-3">
								<p class="flex-1 text-xs text-destructive" data-comment-error role="alert"></p>
								<button
									type="submit"
									data-haptic
									class="ml-auto inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-all hover:bg-primary/90 active:scale-[0.97] disabled:cursor-not-allowed disabled:opacity-50"
								>
									<Send size={13} />
									<span data-comment-submit-label>Post comment</span>
								</button>
							</div>
						</form>

						<div class="mt-6 flex flex-col gap-4" data-comments-list></div>
					</section>
				</article>

				<aside class="hidden lg:block" aria-label="Post tools">
					<div class="rise-in sticky top-20 flex flex-col gap-4">
						{
							hasToc && (
								<div class="rounded-xl border border-border/60 bg-card/60 p-4 backdrop-blur-sm">
									<p class="mb-3 font-mono text-[10px] font-bold tracking-widest text-muted-foreground">On this page</p>
									<nav aria-label="On this page" class="toc-rail max-h-[calc(100vh-17rem)] overflow-y-auto pr-0.5" data-toc-rail>
										{tocHeadings.map((h) => (
											<a href={`#${h.slug}`} class={tocLinkClass} data-toc-link data-depth={h.depth}>
												{h.text}
											</a>
										))}
									</nav>
								</div>
							)
						}
						<div class="rounded-xl border border-border/60 bg-card/60 p-3.5 backdrop-blur-sm">
							<div class="grid grid-cols-3 gap-1.5">
								<button type="button" class="post-act" data-post-like data-haptic="selection" aria-pressed="false">
									<span class="post-act-count">
										<Heart size={15} />
										<span data-post-likes-count class="tabular-nums">{initialLikes}</span>
									</span>
									<span>Like</span>
								</button>
								<button type="button" class="post-act" data-post-discuss data-haptic>
									<span class="post-act-count">
										<MessageCircle size={15} />
										<span data-comment-count class="tabular-nums">{totalComments}</span>
									</span>
									<span>Discuss</span>
								</button>
								<button type="button" class="post-act" data-post-share data-haptic>
									<Link2 size={15} />
									<span data-share-label>Copy link</span>
								</button>
							</div>
							<div class="mt-3 flex items-center justify-between gap-2 border-t border-border/60 pt-3">
								<span class="text-xs text-muted-foreground">Follow</span>
								<div class="flex gap-1">
									{followLinks.map(({ label, href, Icon }) => (
										<a
											href={href}
											target="_blank"
											rel="noopener noreferrer"
											data-haptic-external
											class="follow-icon"
											aria-label={label}
											title={label}
										>
											<Icon size={14} />
										</a>
									))}
									<a href="/rss.xml" data-haptic-nav class="follow-icon" aria-label="RSS feed" title="RSS feed">
										<Rss size={14} />
									</a>
								</div>
							</div>
							<a
								href={originalUrl}
								target="_blank"
								rel="noopener noreferrer"
								data-haptic-external
								class="mt-3 inline-flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-primary"
							>
								Also on blog.tashif.codes <ExternalLink size={11} />
							</a>
						</div>
					</div>
				</aside>
			</div>
		</div>

		<!--
			Left padding clears the collapsed settings dock in the bottom-left corner.
			The bar is 52px tall like the dock button (42px buttons, 4px padding,
			1px border), and uses the same bottom-4 / sm:bottom-6 offsets, so the
			two line up top and bottom.
		-->
		<div class="pointer-events-none sticky bottom-4 z-30 flex justify-center pl-[4.5rem] pr-3 sm:bottom-6 sm:px-3 lg:hidden" data-post-bar>
			<div
				class="pointer-events-auto flex gap-0.5 rounded-full border border-border/70 bg-card/90 p-1 shadow-lg backdrop-blur-md"
				role="toolbar"
				aria-label="Post actions"
			>
				<button type="button" class="post-bar-btn" data-post-like data-haptic="selection" aria-pressed="false" aria-label="Like">
					<Heart size={16} />
					<span data-post-likes-count class="tabular-nums">{initialLikes}</span>
				</button>
				<button type="button" class="post-bar-btn" data-post-discuss data-haptic aria-label="Discussion">
					<MessageCircle size={16} />
					<span data-comment-count class="tabular-nums">{totalComments}</span>
				</button>
				<button type="button" class="post-bar-btn" data-post-share data-haptic>
					<Link2 size={16} />
					<span data-share-label>Share</span>
				</button>
				{
					hasToc && (
						<button type="button" class="post-bar-btn" data-post-contents data-haptic>
							<ListTree size={16} />
							Contents
						</button>
					)
				}
			</div>
		</div>
	</div>
</Layout>

<script>
	import "../../scripts/blogPost";
</script>
