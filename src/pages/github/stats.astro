---
import PageShell from "../../layouts/PageShell.astro";
import GitHubStats from "../../components/github/GitHubStats.astro";
import OrgContributions from "../../components/github/OrgContributions.astro";
import DataFreshness from "../../components/common/DataFreshness";
import { githubFetchedAt } from "../../data/github";
import { githubUsernames, personalGithubUsername } from "../../data/profile";
import { ExternalLink } from "lucide-react";
---

<PageShell
	title="GitHub Stats | Tashif Ahmad Khan"
	image="/og/github-stats.jpg"
	tint="blue"
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "GitHub", href: "/github" }, { label: "Stats" }]}
>
	<Fragment slot="header">
		<div class="flex items-center justify-between gap-4">
			<h1 class="font-sans text-4xl sm:text-5xl font-semibold tracking-tight text-foreground">GitHub</h1>
			<a
				href={`https://github.com/${personalGithubUsername}`}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-primary/10 px-4 py-2 text-sm font-medium text-primary ring-1 ring-primary/25 transition-colors hover:bg-primary/20 hover:ring-primary/40"
			>
				<ExternalLink className="w-4 h-4" />
				Profile
			</a>
		</div>
		<p class="mt-2 sm:mt-3 max-w-xl text-sm sm:text-base text-muted-foreground">
			Commits, streaks, languages and pull requests across my {githubUsernames.length} GitHub accounts.
		</p>
		<div class="mt-3">
			<DataFreshness
				client:load
				source="github"
				fetchedAt={githubFetchedAt}
				label="GitHub stats"
				description="Re-fetch commits, streaks, stars, PRs, profile views and the contribution graph from the live GitHub stats API."
			/>
		</div>
	</Fragment>

	<GitHubStats>
		<OrgContributions slot="after-graph" />
	</GitHubStats>
</PageShell>
