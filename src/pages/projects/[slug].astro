---
import Layout from "../../layouts/Layout.astro";
import {
	Github,
	ExternalLink,
	ArrowLeft,
	FileText,
	GitFork,
	BarChart3,
	Tag,
	Download,
	Package,
	Calendar,
} from "lucide-react";
import { allProjects, type Project } from "../../data/projects";
import MarkdownRenderer from "../../components/MarkdownRenderer.astro";
import { fetchAnalyticsProjects, hasAnalytics, getAnalyticsSlug } from "../../data/analyticsProjects";

import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { AnimatedTooltip } from "@/components/ui/animated-tooltip";

const { project, projectHasAnalytics, analyticsSlug } = Astro.props as { project: Project; projectHasAnalytics: boolean; analyticsSlug: string };

// Readme is now plain markdown (not Base64). Graceful fallback: if the content
// looks like Base64 (all base64 chars, no markdown markers), decode it.
let readmeContent = project.readme || "";
if (readmeContent) {
	const trimmed = readmeContent.trim();
	const looksLikeBase64 =
		trimmed.length > 0 &&
		!trimmed.startsWith("#") &&
		!trimmed.startsWith("-") &&
		!trimmed.startsWith("*") &&
		!/\s/.test(trimmed.slice(0, 20)) &&
		/^[A-Za-z0-9+/\r\n]+=*$/.test(trimmed);
	if (looksLikeBase64) {
		try {
			readmeContent = Buffer.from(trimmed, "base64").toString("utf-8");
		} catch {
			// keep raw
		}
	}
}

const releases = project.releases ?? [];

function formatBytes(bytes: number): string {
	if (bytes < 1024) return `${bytes} B`;
	if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
	return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function formatDate(dateStr: string | null): string {
	if (!dateStr) return "";
	return new Date(dateStr).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

export async function getStaticPaths() {
	const analyticsProjects = await fetchAnalyticsProjects();
	return allProjects.map((project: Project) => ({
		params: { slug: project.slug },
		props: { 
			project,
			projectHasAnalytics: hasAnalytics(project.slug, analyticsProjects),
			analyticsSlug: getAnalyticsSlug(project.slug)
		},
	}));
}
---

<Layout title={project.title}>
	<div
		class="relative min-h-screen bg-gradient-to-b from-muted to-background dark:from-background dark:to-card text-foreground dark:text-foreground transition-colors duration-300 font-sans"
	>
		<div
			class="pointer-events-none absolute inset-0 [mask-image:radial-gradient(80%_60%_at_50%_0%,black,transparent)]"
		>
			<div
				class="h-40 bg-gradient-to-b from-orange-200/40 to-transparent dark:from-orange-900/20"
			>
			</div>
		</div>
		<header
			class="relative bg-card/80 dark:bg-card/80 backdrop-blur border-b border-border/60 dark:border-border/60 transition-colors duration-300"
		>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
			<a
				href="/projects"
				data-haptic-back
				class="flex items-center text-primary dark:text-primary hover:text-primary/80 hover:underline mb-4 sm:mb-6 text-sm sm:text-base font-medium"
			>
					<ArrowLeft className="w-4 h-4 mr-2" /> Back to Projects
				</a>
			<h1
				class="text-3xl sm:text-4xl lg:text-5xl font-bold bg-gradient-to-r from-primary to-primary/80 dark:from-foreground dark:to-muted-foreground bg-clip-text text-transparent mb-4 pb-1"
			>
					{project.title}
				</h1>
				<p
					class="text-muted-foreground dark:text-muted-foreground mb-6 text-base sm:text-lg leading-relaxed max-w-3xl"
				>
					{project.description}
				</p>
				{
					project.parentRepo && (
					<a
						href={`https://github.com/${project.parentRepo}`}
						target="_blank"
						rel="noopener noreferrer"
						data-haptic-external
					>
							<div class="flex items-center gap-1.5 text-sm text-muted-foreground dark:text-muted-foreground mb-6 -mt-4 bg-muted/50 dark:bg-secondary/50 w-fit px-3 py-1 rounded-full border border-border dark:border-border">
								<GitFork className="w-4 h-4" />
								<span>
									Forked from{" "}
									<strong class="font-medium text-muted-foreground dark:text-muted-foreground">
										{project.parentRepo}
									</strong>
								</span>
							</div>
						</a>
					)
				}
				<div class="flex flex-wrap gap-2 mb-6">
					{
						project.languages.map((lang: string) => (
							<Badge
								variant="secondary"
								className="text-[10px] font-medium bg-secondary/50 hover:bg-secondary/70 transition-colors"
							>
								{lang}
							</Badge>
						))
					}
				</div>

				{
					project.contributors && project.contributors.length > 1 && (
						<div class="flex items-center gap-4 mb-6">
							<span class="text-sm font-medium text-muted-foreground dark:text-muted-foreground">
								Contributors
							</span>
							<div class="flex flex-row items-center justify-start">
								<AnimatedTooltip
									client:load
									items={project.contributors.map((c) => ({
										id: c.login === "tashifkhan" ? 1 : Math.random(), // Ensure stable ID for main user if needed, or just unique
										name: c.login,
										designation: `${c.contributions} contributions`,
										image: c.avatar_url,
										url: c.html_url,
									}))}
								/>
							</div>
						</div>
					)
				}

				<div class="flex flex-row flex-wrap items-center gap-3 sm:gap-6">
					{
						project.live_website_url && (
							<Button
								variant="default"
								size="sm"
								className="h-8 text-xs gap-1.5 shadow-sm"
								data-live-link
								data-url={project.live_website_url}
							>
							<a
								class="flex items-center gap-1"
								href={project.live_website_url}
								target="_blank"
								rel="noopener noreferrer"
								data-haptic-external
							>
									<ExternalLink className="w-3.5 h-3.5" />
									Live Demo
								</a>
							</Button>
						)
					}
					<Button
						variant="outline"
						size="sm"
						className="h-8 text-xs gap-1.5 bg-background/50 backdrop-blur-sm"
						data-github-link
						data-url={project.github_link}
					>
						<a
							class="flex items-center gap-1"
							href={project.github_link}
							target="_blank"
							rel="noopener noreferrer"
							data-haptic-external
						>
							<Github className="w-3.5 h-3.5" />
							Source
						</a>
					</Button>
					{
						project.docs_slug && (
							<Button
								variant="outline"
								size="sm"
								className="h-8 text-xs gap-1.5 shadow-sm hover:bg-secondary/70 transition-colors"
								asChild
							>
							<a
								href={`/docs/${project.docs_slug}`}
								class="flex items-center gap-1"
								data-haptic-nav
							>
									<FileText className="w-3.5 h-3.5" />
									Docs
								</a>
							</Button>
						)
					}
					{
						projectHasAnalytics && (
							<Button
								variant="outline"
								size="sm"
								className="h-8 text-xs gap-1.5 shadow-sm hover:bg-blue-500/10 hover:border-blue-500/30 transition-colors"
								asChild
							>
							<a
								href={`/projects/stats?project=${analyticsSlug}`}
								class="flex items-center gap-1"
								data-haptic-nav
							>
									<BarChart3 className="w-3.5 h-3.5" />
									Stats
								</a>
							</Button>
						)
					}
					{
						releases.length > 0 && (
							<Button
								variant="outline"
								size="sm"
								className="h-8 text-xs gap-1.5 shadow-sm hover:bg-emerald-500/10 hover:border-emerald-500/30 transition-colors"
								asChild
							>
								<a
									href="#releases"
									class="flex items-center gap-1"
									data-haptic-nav
								>
									<Tag className="w-3.5 h-3.5" />
									{releases.length} {releases.length === 1 ? "Release" : "Releases"}
								</a>
							</Button>
						)
					}
				</div>
			</div>
		</header>

		<main transition:animate="fade" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
			<!-- README -->
			<div
				class="bg-card/80 dark:bg-card/80 backdrop-blur-xl p-6 sm:p-8 lg:p-10 rounded-2xl border border-border/50 dark:border-border/50 shadow-lg"
			>
				{
					readmeContent ? (
						<MarkdownRenderer
							content={readmeContent}
							githubBaseUrl={project.github_link}
						/>
					) : (
						<div class="text-center py-12">
							<p class="text-muted-foreground dark:text-muted-foreground text-lg">
								No documentation available for this project.
							</p>
							<p class="text-muted-foreground dark:text-muted-foreground text-sm mt-2">
								Check the GitHub repository for more details.
							</p>
						</div>
					)
				}
			</div>

			<!-- Releases -->
			{releases.length > 0 && (
				<section id="releases" class="scroll-mt-8">
					<div class="flex items-center gap-3 mb-5">
						<div class="h-9 w-9 rounded-lg bg-emerald-500/10 flex items-center justify-center text-emerald-500 ring-1 ring-emerald-500/20">
							<Tag className="w-4 h-4" />
						</div>
						<div>
							<h2 class="text-xl font-semibold text-foreground tracking-tight">Releases</h2>
							<p class="text-xs text-muted-foreground">{releases.length} published {releases.length === 1 ? "release" : "releases"}</p>
						</div>
					</div>

					<div class="space-y-4">
						{releases.map((release) => (
							<details class="group rounded-2xl border border-border/50 bg-card/80 backdrop-blur-xl shadow-sm overflow-hidden open:shadow-md transition-shadow duration-300">
								<summary class="flex items-center gap-3 px-5 py-4 cursor-pointer list-none select-none hover:bg-muted/30 transition-colors">
									<div class="flex items-center gap-2.5 flex-1 min-w-0">
										<span class="font-mono text-sm font-semibold text-emerald-500 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full shrink-0">
											{release.tag_name}
										</span>
										<span class="text-sm font-medium text-foreground truncate">
											{release.name ?? release.tag_name}
										</span>
										{release.draft && (
											<span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-yellow-500/15 text-yellow-500 border border-yellow-500/20 shrink-0">Draft</span>
										)}
										{release.prerelease && (
											<span class="text-[10px] font-semibold uppercase tracking-wide px-2 py-0.5 rounded-full bg-orange-500/15 text-orange-500 border border-orange-500/20 shrink-0">Pre-release</span>
										)}
									</div>
									<div class="flex items-center gap-3 shrink-0">
										{release.published_at && (
											<span class="hidden sm:flex items-center gap-1.5 text-xs text-muted-foreground">
												<Calendar className="w-3.5 h-3.5" />
												{formatDate(release.published_at)}
											</span>
										)}
										{release.assets.length > 0 && (
											<span class="flex items-center gap-1 text-xs text-muted-foreground bg-muted/50 px-2 py-0.5 rounded-full border border-border/40">
												<Download className="w-3 h-3" />
												{release.assets.length}
											</span>
										)}
										<a
											href={release.url}
											target="_blank"
											rel="noopener noreferrer"
											data-haptic-external
											class="text-xs text-muted-foreground hover:text-primary transition-colors hover:underline"
											onclick="event.stopPropagation()"
										>
											<ExternalLink className="w-3.5 h-3.5" />
										</a>
										<svg class="w-4 h-4 text-muted-foreground transition-transform duration-300 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
										</svg>
									</div>
								</summary>

								<div class="border-t border-border/50 px-5 py-5 space-y-5">
									<!-- Release notes -->
									{release.body ? (
										<div class="prose-sm max-w-none">
											<MarkdownRenderer content={release.body} />
										</div>
									) : (
										<p class="text-sm text-muted-foreground italic">No release notes provided.</p>
									)}

									<!-- Assets -->
									<div>
										<div class="flex items-center gap-2 mb-3">
											<Package className="w-4 h-4 text-muted-foreground" />
											<span class="text-sm font-semibold text-foreground">Assets</span>
										</div>
										{release.assets.length > 0 ? (
											<div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
												{release.assets.map((asset) => (
													<a
														href={asset.download_url}
														target="_blank"
														rel="noopener noreferrer"
														data-haptic-external
														class="group/asset flex items-center gap-3 px-3.5 py-2.5 rounded-xl border border-border/40 bg-background/50 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all duration-200"
													>
														<div class="h-8 w-8 rounded-lg bg-muted flex items-center justify-center shrink-0 group-hover/asset:bg-emerald-500/10 transition-colors">
															<Download className="w-3.5 h-3.5 text-muted-foreground group-hover/asset:text-emerald-500 transition-colors" />
														</div>
														<div class="flex-1 min-w-0">
															<p class="text-sm font-medium text-foreground truncate group-hover/asset:text-emerald-500 transition-colors">{asset.name}</p>
															<div class="flex items-center gap-2 text-[11px] text-muted-foreground mt-0.5">
																<span>{formatBytes(asset.size)}</span>
																<span>·</span>
																<span>{asset.download_count.toLocaleString()} downloads</span>
															</div>
														</div>
													</a>
												))}
											</div>
										) : (
											<p class="text-sm text-muted-foreground italic">No release assets available.</p>
										)}
									</div>
								</div>
							</details>
						))}
					</div>
				</section>
			)}
		</main>
	</div>
</Layout>

<script>
	import { WebHaptics } from "web-haptics";
	const haptics = new WebHaptics();

	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll("[data-haptic-back]").forEach((el) =>
			el.addEventListener("click", () => haptics.trigger("light"))
		);
		document.querySelectorAll("[data-haptic-nav]").forEach((el) =>
			el.addEventListener("click", () => haptics.trigger("light"))
		);
		document.querySelectorAll("[data-haptic-external]").forEach((el) =>
			el.addEventListener("click", () => haptics.trigger("light"))
		);
	});
</script>
