---
import PageShell from "../../layouts/PageShell.astro";
import ProjectFilters from "../../components/projects/ProjectFilters.tsx";
import DataFreshness from "../../components/common/DataFreshness";
import { starLists } from "../../data/starLists";
import { ChartPie } from "lucide-react";
import ProjectGrid from "../../components/projects/ProjectGrid.astro";
import { allProjects, projectsFetchedAt } from "../../data/projects";
import { fetchAnalyticsProjects } from "../../data/analyticsProjects";
import type { Project } from "@/types";

const projects: Project[] = allProjects;
const analyticsProjects = await fetchAnalyticsProjects();
const liveCount = projects.filter((p) => Boolean(p.live_website_url)).length;
---

<PageShell
	title="Projects | Tashif Ahmad Khan"
	image="/og/projects.jpg"
	tint="orange"
	compact
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Projects" }]}
>
	<Fragment slot="header">
		<div>
			<div class="flex items-center justify-between gap-4">
				<h1
					class="font-sans text-2xl sm:text-3xl font-bold tracking-tight text-primary leading-none pb-0.5"
				>
					Projects
				</h1>
				<a
					href="/projects/stats"
					data-haptic-nav
					class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full bg-primary/10 text-primary ring-1 ring-primary/25 hover:bg-primary/20 hover:ring-primary/40 transition-colors shrink-0"
				>
					<ChartPie className="w-4 h-4" />
					Analytics
				</a>
			</div>
			<p class="mt-2 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed">
				Web apps, tools and experiments I've built and shipped.
			</p>
			<div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
				<DataFreshness
					client:load
					source="projects"
					fetchedAt={projectsFetchedAt}
					label="Projects data"
					description="Re-fetch star and fork counts (and star lists) from the live GitHub stats API. Project cards update in place."
				/>
			<div
				class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs sm:text-sm text-muted-foreground"
			>
				<span>
					<span class="font-semibold text-foreground tabular-nums"
						>{projects.length}</span
					> projects
				</span>
				<span class="inline-flex items-center gap-1.5">
					<span class="relative flex h-1.5 w-1.5">
						<span
							class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
						></span>
						<span
							class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"
						></span>
					</span>
					<span class="font-semibold text-foreground tabular-nums"
						>{liveCount}</span
					> live
				</span>
			</div>
			</div>
		</div>
	</Fragment>

	<div class="mb-10">
		<ProjectFilters client:load starLists={starLists} />
	</div>

	<ProjectGrid projects={projects} analyticsProjects={analyticsProjects} gap="gap-6 sm:gap-8" />
	<p data-project-empty role="status" hidden class="py-8 text-center text-sm text-muted-foreground">No projects match these filters. Try clearing a filter or changing your search.</p>
</PageShell>

<script>
	import { initProjectSearch } from "../../scripts/projectSearch";

	initProjectSearch();

	document.addEventListener("astro:page-load", () => {
		document.dispatchEvent(
			new CustomEvent("project-search", { detail: { term: "", showLiveOnly: false } })
		);
	});
</script>
