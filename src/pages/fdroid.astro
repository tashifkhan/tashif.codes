---
import fs from "node:fs";
import path from "node:path";
import PageShell from "../layouts/PageShell.astro";
import EmptyState from "../components/EmptyState.astro";
import { allProjects } from "../data/projects";
import { slugify } from "../utils/slugify";
import {
	Card,
	CardContent,
	CardHeader,
	CardTitle,
	CardDescription,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import {
	Check,
	Copy,
	Download,
	Github,
	Globe,
	HardDrive,
	Package,
	RefreshCw,
	Scale,
	ShieldCheck,
	Smartphone,
	Tag,
} from "lucide-react";

const fallbackRepoUrl = "https://tashif.codes/fdroid/repo";

interface RepoApp {
	name: string;
	packageName: string;
	summary?: string;
	license?: string;
	categories: string[];
	sourceCode?: string;
	changelog?: string;
	versionName?: string;
	sizeBytes?: number;
	minSdk?: number;
	apkUrl?: string;
	updatedAt?: number;
	icon?: string;
	projectSlug?: string;
}

// The F-Droid index is generated and committed by the Publish F-Droid Repo
// workflow, so it may not exist on fresh checkouts.
let repoUrl = fallbackRepoUrl;
let repoName = "Tashif Codes";
let repoDescription = "Android apps published by Tashif Khan.";
let indexUpdatedAt: number | undefined;
let apps: RepoApp[] = [];

try {
	const indexPath = path.resolve("public/fdroid/repo/index-v1.json");
	if (fs.existsSync(indexPath)) {
		const index = JSON.parse(fs.readFileSync(indexPath, "utf-8"));
		repoUrl = index.repo?.address ?? fallbackRepoUrl;
		repoName = index.repo?.name ?? repoName;
		repoDescription = index.repo?.description ?? repoDescription;
		indexUpdatedAt = index.repo?.timestamp;
		apps = (index.apps ?? [])
			.map((app: any): RepoApp => {
				const versions = index.packages?.[app.packageName] ?? [];
				const suggested =
					versions.find(
						(p: any) =>
							String(p.versionCode) === String(app.suggestedVersionCode)
					) ?? versions[0];
				return {
					name: app.name ?? app.localized?.["en-US"]?.name ?? app.packageName,
					packageName: app.packageName,
					summary: app.summary ?? app.localized?.["en-US"]?.summary,
					license: app.license,
					categories: app.categories ?? [],
					sourceCode: app.sourceCode,
					changelog: app.changelog,
					versionName: suggested?.versionName,
					sizeBytes: suggested?.size,
					minSdk: suggested?.minSdkVersion,
					apkUrl: suggested?.apkName
						? `/fdroid/repo/${suggested.apkName}`
						: undefined,
					updatedAt: app.lastUpdated,
					icon: fs.existsSync(
						path.resolve(
							`public/fdroid/metadata/${app.packageName}/en-US/icon.png`
						)
					)
						? `/fdroid/metadata/${app.packageName}/en-US/icon.png`
						: undefined,
					projectSlug: (() => {
						if (!app.sourceCode) return undefined;
						const repoName =
							app.sourceCode.split("/").filter(Boolean).pop() ?? "";
						return allProjects.find(
							(p) => p.slug === slugify(repoName)
						)?.slug;
					})(),
				};
			})
			.sort((a: RepoApp, b: RepoApp) => a.name.localeCompare(b.name));
	}
} catch {
	apps = [];
}

const totalSize = apps.reduce((sum, app) => sum + (app.sizeBytes ?? 0), 0);

function formatBytes(bytes: number): string {
	if (bytes < 1024) return `${bytes} B`;
	if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
	return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function formatDate(ts: number): string {
	return new Date(ts).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}

const sdkToAndroid: Record<number, string> = {
	21: "5.0",
	22: "5.1",
	23: "6.0",
	24: "7.0",
	25: "7.1",
	26: "8.0",
	27: "8.1",
	28: "9",
	29: "10",
	30: "11",
	31: "12",
	32: "12.1",
	33: "13",
	34: "14",
	35: "15",
	36: "16",
};

function androidLabel(sdk: number): string {
	const version = sdkToAndroid[sdk];
	return version ? `Android ${version}+` : `SDK ${sdk}+`;
}

const addRepoSteps = [
	"Open F-Droid and go to Settings → Repositories",
	"Tap + and paste the repo URL above",
	"Refresh repositories to pull the signed index",
	"Search for an app below and install it",
];

const pipeline = [
	{
		icon: Github,
		title: "Release",
		description: "APK is published to GitHub Releases.",
	},
	{
		icon: RefreshCw,
		title: "Import",
		description: "The website workflow pulls in the APK.",
	},
	{
		icon: ShieldCheck,
		title: "Sign",
		description: "fdroidserver signs and updates the index.",
	},
	{
		icon: Globe,
		title: "Serve",
		description: "Vercel serves the repo from this site.",
	},
];
---

<PageShell
	title="F-Droid Repo | Tashif Ahmad Khan"
	tint="orange"
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "F-Droid" }]}
>
	<Fragment slot="header">
		<div class="mb-4">
			<div class="flex items-center justify-between gap-4">
				<h1
					class="font-sans text-4xl sm:text-5xl font-semibold tracking-tight text-foreground"
				>
					F-Droid Repo
				</h1>
				<a
					href={repoUrl}
					data-haptic-external
					class="inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full bg-primary/10 text-primary ring-1 ring-primary/25 hover:bg-primary/20 hover:ring-primary/40 transition-colors shrink-0"
				>
					<Package className="w-4 h-4" />
					Repo index
				</a>
			</div>
			<p class="mt-2 sm:mt-3 max-w-xl text-sm sm:text-base text-muted-foreground">
				{repoDescription} Add this self-hosted repo to your F-Droid client
				once and get every update automatically.
			</p>
			<div
				class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs sm:text-sm text-muted-foreground"
			>
				<span>
					<span class="font-semibold text-foreground tabular-nums"
						>{apps.length}</span
					> apps
				</span>
				{
					totalSize > 0 && (
						<span>
							<span class="font-semibold text-foreground tabular-nums">
								{formatBytes(totalSize)}
							</span>{" "}
							hosted
						</span>
					)
				}
				{
					indexUpdatedAt && (
						<span class="inline-flex items-center gap-1.5">
							<span class="relative flex h-1.5 w-1.5">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
								<span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500" />
							</span>
							index updated {formatDate(indexUpdatedAt)}
						</span>
					)
				}
			</div>
		</div>
	</Fragment>

	<div class="space-y-8">
		<!-- Add the repo -->
		<Card
			className="relative overflow-hidden bg-card/70 dark:bg-card/50 backdrop-blur border-border/60 shadow-lg"
		>
			<div
				class="absolute -top-20 -right-16 h-48 w-48 sm:h-64 sm:w-64 rounded-full bg-primary/5 blur-3xl pointer-events-none"
			>
			</div>
			<CardHeader className="relative z-10">
				<div class="flex items-center space-x-3">
					<div class="p-2 bg-primary/10 rounded-xl">
						<Smartphone className="w-6 h-6 text-primary" />
					</div>
					<div>
						<CardTitle className="text-2xl sm:text-3xl"
							>Add to F-Droid</CardTitle
						>
						<CardDescription className="mt-1">
							{repoName} · signed index, verified by your F-Droid client
						</CardDescription>
					</div>
				</div>
			</CardHeader>
			<CardContent className="relative z-10">
				<div
					class="flex items-center gap-2 rounded-xl border border-border/70 bg-background/80 pl-4 pr-2 py-2"
				>
					<span
						class="flex-1 font-mono text-sm text-primary break-all select-all"
						>{repoUrl}</span
					>
					<button
						type="button"
						data-copy-repo-url
						data-haptic
						data-url={repoUrl}
						aria-label="Copy repo URL"
						class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-muted-foreground hover:text-primary hover:bg-accent transition-colors shrink-0"
					>
						<Copy className="w-4 h-4" data-copy-icon />
						<Check
							className="w-4 h-4 hidden text-emerald-500"
							data-check-icon
						/>
					</button>
				</div>
				<p
					data-copy-feedback
					class="mt-2 text-xs text-primary opacity-0 transition-opacity"
					aria-live="polite"
				>
					Copied to clipboard
				</p>
				<ol class="mt-3 grid gap-3 sm:grid-cols-2">
					{
						addRepoSteps.map((step, i) => (
							<li class="flex items-start gap-3 rounded-xl border border-border/50 bg-background/50 px-3.5 py-3">
								<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary text-xs font-semibold">
									{i + 1}
								</span>
								<span class="pt-0.5 text-sm text-muted-foreground">
									{step}
								</span>
							</li>
						))
					}
				</ol>
			</CardContent>
		</Card>

		<!-- Apps in the repo -->
		<section>
			<div
				class="mb-4 sm:mb-5 flex items-center gap-x-2 sm:gap-x-3 min-w-0"
			>
				<h2
					class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
				>
					Apps
				</h2>
				<span
					class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground truncate min-w-0"
				>
					<span class="font-bold text-foreground tabular-nums"
						>{apps.length}</span
					>
					in repo
				</span>
				{
					apps.length > 0 && (
						<span class="ml-auto hidden sm:inline text-xs text-muted-foreground">
							or grab the APKs directly — they're hosted right here
						</span>
					)
				}
			</div>

			{
				apps.length > 0 ? (
					<div class="grid gap-4 sm:gap-6 md:grid-cols-2 xl:grid-cols-3">
						{apps.map((app) => (
							<article data-project-card={app.projectSlug ? `/projects/${app.projectSlug}` : ""} class="group relative flex flex-col overflow-hidden rounded-2xl border border-border/60 bg-card/70 dark:bg-card/50 backdrop-blur p-5 transition-all duration-300 hover:shadow-lg hover:border-primary/30 cursor-pointer">
								<div class="flex flex-1 flex-col">
								<div class="flex items-start gap-4">
									{app.icon ? (
										<img
											src={app.icon}
											alt={`${app.name} icon`}
											width="48"
											height="48"
											loading="lazy"
											decoding="async"
											class="h-12 w-12 shrink-0 rounded-xl object-cover ring-1 ring-border/50"
										/>
									) : (
										<div
											aria-hidden="true"
											class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary/25 to-orange-400/10 text-lg font-bold text-primary ring-1 ring-primary/20"
										>
											{app.name.charAt(0)}
										</div>
									)}
									<div class="min-w-0 flex-1">
										<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
											<h3 class="font-sans font-semibold tracking-tight text-foreground">
												{app.projectSlug ? (
													<a
														href={`/projects/${app.projectSlug}`}
														class="hover:text-primary transition-colors"
													>
														{app.name}
													</a>
												) : (
													app.name
												)}
											</h3>
											{app.versionName && (
												<Badge
													variant="secondary"
													className="px-1.5 py-0 font-mono text-[10px] font-medium"
												>
													v{app.versionName}
												</Badge>
											)}
										</div>
										<p class="mt-0.5 truncate font-mono text-[11px] text-muted-foreground/70">
											{app.packageName}
										</p>
									</div>
								</div>

								{app.summary && (
									<p class="mt-3 text-sm leading-relaxed text-muted-foreground">
										{app.summary}
									</p>
								)}

								<div class="mt-3 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[11px] text-muted-foreground">
									{app.license && (
										<span class="inline-flex items-center gap-1">
											<Scale className="w-3 h-3 text-muted-foreground/70" />
											{app.license}
										</span>
									)}
									{app.sizeBytes && (
										<span class="inline-flex items-center gap-1 tabular-nums">
											<HardDrive className="w-3 h-3 text-muted-foreground/70" />
											{formatBytes(app.sizeBytes)}
										</span>
									)}
									{app.minSdk && (
										<span class="inline-flex items-center gap-1">
											<Smartphone className="w-3 h-3 text-muted-foreground/70" />
											{androidLabel(app.minSdk)}
										</span>
									)}
									{app.updatedAt && (
										<span class="inline-flex items-center gap-1">
											<RefreshCw className="w-3 h-3 text-muted-foreground/70" />
											{formatDate(app.updatedAt)}
										</span>
									)}
								</div>

								{app.categories.length > 0 && (
									<div class="mt-3 flex flex-wrap gap-1.5">
										{app.categories.slice(0, 3).map((category) => (
											<span class="rounded-full border border-border/50 bg-muted/40 px-2 py-0.5 text-[10px] font-medium text-muted-foreground">
												{category}
											</span>
										))}
									</div>
								)}

								</div>

								<div class="mt-4 flex flex-wrap items-center gap-2 border-t border-border/50 pt-4">
									{app.apkUrl && (
										<a
											href={app.apkUrl}
											download
											data-haptic
											data-stop-nav
											class={cn(
												buttonVariants({ size: "sm" }),
												"h-8 gap-1.5 text-xs shadow-sm"
											)}
										>
											<Download className="w-3.5 h-3.5" />
											APK
										</a>
									)}
									{app.sourceCode && (
										<a
											href={app.sourceCode}
											target="_blank"
											rel="noopener noreferrer"
											data-haptic-external
											data-stop-nav
											class={cn(
												buttonVariants({ variant: "outline", size: "sm" }),
												"h-8 gap-1.5 bg-background/50 text-xs"
											)}
										>
											<Github className="w-3.5 h-3.5" />
											Source
										</a>
									)}
									{app.changelog && (
										<a
											href={app.changelog}
											target="_blank"
											rel="noopener noreferrer"
											data-haptic-external
											data-stop-nav
											class={cn(
												buttonVariants({ variant: "ghost", size: "sm" }),
												"h-8 gap-1.5 text-xs text-muted-foreground hover:text-foreground"
											)}
										>
											<Tag className="w-3.5 h-3.5" />
											Releases
										</a>
									)}
								</div>
							</article>
						))}
					</div>
				) : (
					<EmptyState
						command="fdroid update"
						title="repo index not found"
						description="The signed index is generated by CI and committed to this repo, so it's missing on fresh checkouts. The repository URL above still works."
						ctaLabel="open repo"
						ctaHref={repoUrl}
						ctaExternal
					/>
				)
			}
		</section>

		<!-- How updates work -->
		<Card
			className="relative overflow-hidden bg-card/70 dark:bg-card/50 backdrop-blur border-border/60 shadow-lg"
		>
			<div
				class="absolute -top-20 -right-16 h-48 w-48 sm:h-64 sm:w-64 rounded-full bg-primary/5 blur-3xl pointer-events-none"
			>
			</div>
			<CardHeader className="relative z-10">
				<div class="flex items-center space-x-3">
					<div class="p-2 bg-primary/10 rounded-xl">
						<RefreshCw className="w-6 h-6 text-primary" />
					</div>
					<div>
						<CardTitle className="text-2xl sm:text-3xl"
							>How updates work</CardTitle
						>
						<CardDescription className="mt-1">
							Every app ships through the same automated pipeline.
						</CardDescription>
					</div>
				</div>
			</CardHeader>
			<CardContent className="relative z-10">
				<ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{
						pipeline.map((step, i) => (
							<li class="relative flex flex-col gap-3">
								<div class="flex items-center gap-3">
									<div class="p-2 bg-primary/10 rounded-xl text-primary">
										<step.icon className="w-5 h-5" />
									</div>
									<span class="font-mono text-xs text-muted-foreground/70">
										0{i + 1}
									</span>
								</div>
								<div>
									<h3 class="font-sans font-semibold">{step.title}</h3>
									<p class="mt-1 text-sm text-muted-foreground">
										{step.description}
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</CardContent>
		</Card>
	</div>
</PageShell>

<script>
	document.addEventListener("astro:page-load", () => {
		document.querySelectorAll<HTMLElement>("[data-project-card]").forEach((card) => {
			card.addEventListener("click", (e) => {
				if ((e.target as HTMLElement).closest("[data-stop-nav]")) return;
				const href = card.dataset.projectCard;
				if (href) window.location.href = href;
			});
		});

		const button = document.querySelector<HTMLButtonElement>(
			"[data-copy-repo-url]"
		);
		const feedback = document.querySelector<HTMLElement>(
			"[data-copy-feedback]"
		);
		if (!button) return;
		const copyIcon = button.querySelector<HTMLElement>("[data-copy-icon]");
		const checkIcon = button.querySelector<HTMLElement>("[data-check-icon]");
		let timer: ReturnType<typeof setTimeout>;
		button.addEventListener("click", async () => {
			const url = button.dataset.url;
			if (!url) return;
			try {
				await navigator.clipboard.writeText(url);
				feedback?.classList.remove("opacity-0");
				copyIcon?.classList.add("hidden");
				checkIcon?.classList.remove("hidden");
				clearTimeout(timer);
				timer = setTimeout(() => {
					feedback?.classList.add("opacity-0");
					copyIcon?.classList.remove("hidden");
					checkIcon?.classList.add("hidden");
				}, 2000);
			} catch {
				// Clipboard unavailable (insecure context); the URL stays selectable.
			}
		});
	});
</script>
