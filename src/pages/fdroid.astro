---
import PageShell from "../layouts/PageShell.astro";
import EmptyState from "../components/common/EmptyState.astro";
import RepoAddress from "../components/fdroid/RepoAddress.astro";
import { Landing, Section } from "@/components/landing";
import { ArrowRight, Download } from "lucide-react";
import {
	fdroidRepo,
	formatBytes,
	formatDate,
	androidVersion,
	REPO_ADD_URL,
} from "@/lib/fdroid";

const { apps, updatedAt } = fdroidRepo;
const hasBilli = apps.some((app) => app.packageName === "sh.taf.billi" && app.latest);

const steps = [
	{
		title: "Open F-Droid",
		body: "Go to Settings, then Repositories, and tap the plus button.",
	},
	{
		title: "Add this repo",
		body: "Paste the address, or scan it. F-Droid reads the fingerprint from it.",
	},
	{
		title: "Refresh",
		body: "F-Droid downloads the signed index and checks it against the fingerprint.",
	},
	{
		title: "Install",
		body: "The apps below appear in search. Updates arrive like any other F-Droid app.",
	},
];

const pipeline = [
	{
		title: "Release",
		body: "Each app's own repo builds a signed APK and attaches it to a GitHub release.",
	},
	{
		title: "Import",
		body: 'That release starts a workflow here. It downloads the APK and writes "What\'s new" from the release notes.',
	},
	{
		title: "Sign",
		body: "fdroidserver rebuilds the index and signs it with the repo key. The last three versions stay in the repo.",
	},
	{
		title: "Serve",
		body: "The index and APKs are static files on this site, so there is no server to trust beyond the signature.",
	},
];

const countWord =
	["No", "One", "Two", "Three", "Four", "Five", "Six"][apps.length] ??
	String(apps.length);
---

<PageShell
	title="F-Droid repo | Tashif Ahmad Khan"
	description="My signed F-Droid repo for Billi, Patchwork, Delhi NCR Metro and Namma Metro."
	image="/og/fdroid.jpg"
	tint="orange"
	compact
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "F-Droid" }]}
>
	<Fragment slot="header">
		<h1
			class="font-sans text-2xl sm:text-3xl font-bold tracking-tight text-primary leading-none pb-0.5"
		>
			F-Droid repo
		</h1>
		<p class="mt-2 text-sm sm:text-base text-muted-foreground leading-relaxed max-w-2xl">
			My Android apps, in a repo your F-Droid client can verify.
			{updatedAt && ` Index signed ${formatDate(updatedAt)}.`}
		</p>
	</Fragment>

	<Landing name="fdroid">
		<section class="ld-section fd-top" data-gap="s">
			<div class="ld-split" data-ratio="7-5">
				<div class="ld-split-text">
					<h2>Add the repo once.</h2>
					<p class="ld-lead">
						F-Droid checks the signing fingerprint, then keeps every app
						below updated.
					</p>
					<RepoAddress primary />
				</div>
				<ol class="fd-steps">
					{
						steps.map((step) => (
							<li>
								<h3>{step.title}</h3>
								<p>{step.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<Section
			id="apps"
			title={`${countWord} ${apps.length === 1 ? "app" : "apps"} in the repo.`}
		>
			<p>
				<a href="/projects/billi" data-haptic-nav class="underline">Billi</a> was called Paisa.
				Coming from Paisa? Install Billi and restore a Paisa backup to move your data.
				{!hasBilli && " Billi will appear here after its first release reaches the repo."}
			</p>
			{
				apps.length > 0 ? (
					<ul class="fd-apps">
						{apps.map((app) => (
							<li class="fd-app">
								<div class="fd-app-text">
									<div class="fd-app-name">
										{app.icon && (
											<img
												src={app.icon}
												alt=""
												width="56"
												height="56"
												loading="lazy"
												decoding="async"
											/>
										)}
										<h3>
											<a href={app.links.project ?? app.links.sourceCode} data-haptic-nav>
												{app.name}
											</a>
										</h3>
									</div>
									<p class="fd-app-summary">{app.summary}</p>
									{app.latest && (
										<dl class="fd-facts">
											<div>
												<dt>Version</dt>
												<dd>{app.latest.name}</dd>
											</div>
											<div>
												<dt>Size</dt>
												<dd>{formatBytes(app.latest.sizeBytes)}</dd>
											</div>
											{app.latest.minSdk && (
												<div>
													<dt>Requires</dt>
													<dd>{androidVersion(app.latest.minSdk)}</dd>
												</div>
											)}
											{app.license && (
												<div>
													<dt>Licence</dt>
													<dd>{app.license}</dd>
												</div>
											)}
										</dl>
									)}
									<div class="ld-actions">
										<a href={app.links.project ?? app.links.sourceCode} data-haptic-nav class="ld-btn">
											Project page
											<ArrowRight aria-hidden="true" />
										</a>
										{app.latest && (
											<a
												href={app.latest.apkUrl}
												download
												data-haptic
												class="ld-btn"
											>
												<Download aria-hidden="true" />
												APK
											</a>
										)}
									</div>
								</div>
								{app.screenshots.length > 0 && (
									<a
										href={app.links.project ?? app.links.sourceCode}
										class="fd-app-shots"
										aria-label={`${app.name} screens`}
										tabindex="-1"
									>
										{app.screenshots.slice(0, 3).map((src) => (
											<img src={src} alt="" loading="lazy" decoding="async" />
										))}
									</a>
								)}
							</li>
						))}
					</ul>
				) : (
					<EmptyState
						command="fdroid update"
						title="repo index not found"
						description="The signed index is generated by CI and committed to this repo, so it's missing on fresh checkouts. The repository address above still works."
						ctaLabel="open repo"
						ctaHref={REPO_ADD_URL}
						ctaExternal
					/>
				)
			}
		</Section>

		<Section
			id="updates"
			title="How an update reaches you."
			layout="side"
			gap="l"
		>
			<ol class="fd-pipeline">
				{
					pipeline.map((step) => (
						<li>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
						</li>
					))
				}
			</ol>
		</Section>
	</Landing>
</PageShell>

<style>
	.fd-top {
		padding-top: var(--ld-space-xl);
	}

	/* Numbered steps. The numerals come from the list itself. */
	.fd-steps,
	.fd-pipeline {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
		border-top: 1px solid var(--ld-rule);
	}
	:is(.fd-steps, .fd-pipeline) > li {
		position: relative;
		display: grid;
		gap: var(--ld-space-2xs);
		padding: var(--ld-space-md) 0 var(--ld-space-md) var(--ld-space-xl);
		border-bottom: 1px solid var(--ld-rule);
		counter-increment: step;
	}
	:is(.fd-steps, .fd-pipeline) > li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: var(--ld-space-md);
		font-family: var(--ld-font-display);
		font-size: var(--ld-text-title);
		font-weight: 700;
		line-height: 1.2;
		color: var(--ld-accent);
		font-variant-numeric: tabular-nums;
	}
	:is(.fd-steps, .fd-pipeline) p {
		max-width: 56ch;
		color: var(--ld-muted);
	}

	.fd-apps {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ld-rule);
	}
	.fd-app {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--ld-space-xl);
		align-items: center;
		padding-block: var(--ld-space-2xl);
		border-bottom: 1px solid var(--ld-rule);
	}
	.fd-app-text {
		display: grid;
		gap: var(--ld-space-lg);
		justify-items: start;
		min-width: 0;
	}
	.fd-app-name {
		display: flex;
		align-items: center;
		gap: var(--ld-space-md);
	}
	.fd-app-name img {
		width: 56px;
		height: 56px;
		border-radius: var(--ld-radius);
		box-shadow: 0 0 0 1px var(--ld-rule);
	}
	.fd-app-name h3 {
		font-size: var(--ld-text-section);
		line-height: 1.04;
		letter-spacing: -0.03em;
	}
	.fd-app-name a:hover {
		color: var(--ld-accent);
	}
	.fd-app-summary {
		max-width: 44ch;
		font-size: var(--ld-text-lead);
		line-height: 1.45;
		color: var(--ld-muted);
	}
	.fd-facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--ld-space-md) var(--ld-space-xl);
		margin: 0;
	}
	.fd-facts dt {
		font-size: var(--ld-text-sm);
		color: var(--ld-muted);
	}
	.fd-facts dd {
		margin: 0;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
	.fd-app-shots {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--ld-space-md);
		align-items: start;
		min-width: 0;
	}
	.fd-app-shots img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--ld-space-md);
		box-shadow: 0 0 0 1px var(--ld-rule);
	}
	@media (min-width: 60rem) {
		.fd-app {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: var(--ld-space-2xl);
		}
		.fd-app-shots img:nth-child(2) {
			margin-top: var(--ld-space-lg);
		}
		.fd-app-shots img:nth-child(3) {
			margin-top: var(--ld-space-xl);
		}
	}
</style>
