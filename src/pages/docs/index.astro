---
import PageShell from "../../layouts/PageShell.astro";
import { allProjects } from "../../data/projects";
import { getSidebar, type SidebarItem } from "../../utils/docs";
import { Badge } from "@/components/ui/badge";
import { ArrowRight } from "lucide-react";
import EmptyState from "../../components/EmptyState.astro";

// Count unique doc pages in a sidebar tree (group headers may reuse a
// child's slug, so count distinct slugs rather than nodes)
function countPages(items: SidebarItem[]): number {
	const slugs = new Set<string>();
	const walk = (arr: SidebarItem[]) => {
		for (const item of arr) {
			if (item.slug !== "#") slugs.add(item.slug);
			if (item.children) walk(item.children);
		}
	};
	walk(items);
	return slugs.size;
}

// Only projects that have documentation
const docProjects = allProjects
	.filter((p) => p.docs_slug)
	.map((p) => ({
		...p,
		pageCount: countPages(getSidebar(p.docs_slug!.split("/")[0])),
	}));
---

<PageShell
	title="Documentation | Tashif Ahmad Khan"
	tint="orange"
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Docs" }]}
>
	<Fragment slot="header">
		<h1
			class="font-sans text-4xl sm:text-5xl font-semibold tracking-tight text-foreground mb-3"
		>
			Documentation
		</h1>
		<p class="text-muted-foreground text-base sm:text-lg max-w-2xl">
			Detailed guides, API references, and architecture notes for my projects.
		</p>
	</Fragment>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
		{
			docProjects.map((project) => (
				<a
					href={`/docs/${project.docs_slug}`}
					data-haptic-nav
					class="group block h-full rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
				>
					<div class="flex h-full flex-col overflow-hidden rounded-2xl border border-border/50 bg-card/80 backdrop-blur-xl shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-md">
						<div class="flex items-start justify-between gap-3 p-5 pb-0">
							<div class="flex min-w-0 items-center gap-3">
								<h2 class="truncate text-lg font-semibold tracking-tight text-foreground transition-colors group-hover:text-primary">
									{project.title}
								</h2>
							</div>
							{project.pageCount > 0 && (
								<span class="mt-1.5 shrink-0 rounded-full border border-border/40 bg-muted/50 px-2 py-0.5 font-mono text-[10px] tabular-nums text-muted-foreground">
									{project.pageCount} {project.pageCount === 1 ? "page" : "pages"}
								</span>
							)}
						</div>

						<p class="mt-3 px-5 text-sm leading-relaxed text-muted-foreground line-clamp-2">
							{project.description}
						</p>

						<div class="mt-4 flex flex-wrap gap-1.5 px-5 pb-5">
							{project.languages.slice(0, 3).map((lang) => (
								<Badge
									variant="secondary"
									className="text-[10px] font-medium px-2 py-0.5 bg-secondary/50 text-secondary-foreground border-transparent"
								>
									{lang}
								</Badge>
							))}
						</div>

						<div class="mt-auto flex items-center justify-between border-t border-border/40 bg-muted/20 px-5 py-3">
							<span class="text-sm font-medium text-primary">
								Read the docs
							</span>
							<ArrowRight className="w-4 h-4 text-primary transition-transform group-hover:translate-x-1" />
						</div>
					</div>
				</a>
			))
		}
	</div>

	{
		docProjects.length === 0 && (
			<div class="py-20">
				<EmptyState command="ls ./docs" title="no documentation available yet" />
			</div>
		)
	}
</PageShell>
