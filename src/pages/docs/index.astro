---
import PageShell from "../../layouts/PageShell.astro";
import { getDocProjects } from "../../lib/docProjects";
import { ArrowRight, Search } from "lucide-react";
import EmptyState from "../../components/common/EmptyState.astro";
import { languageColor } from "../../lib/languageColors";

const docProjects = getDocProjects();
---

<PageShell
	title="Documentation | Tashif Ahmad Khan"
	image="/og/docs.jpg"
	tint="orange"
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Docs" }]}
>
	<Fragment slot="header">
		<h1
			class="font-sans text-4xl sm:text-5xl font-semibold tracking-tight text-foreground mb-3"
		>
			Documentation
		</h1>
		<p class="text-muted-foreground text-base sm:text-lg max-w-2xl">
			Detailed guides, API references, and architecture notes for my projects.
		</p>
	</Fragment>

	{
		docProjects.length > 0 && (
			<div class="relative mb-4 max-w-md">
				<Search className="pointer-events-none absolute z-10 left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
				<input
					type="search"
					placeholder="Search docs..."
					aria-label="Search documentation"
					autocomplete="off"
					data-docs-search
					class="flex h-10 w-full rounded-lg border border-border/70 bg-background/50 pl-9 pr-10 text-sm shadow-sm backdrop-blur-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:border-primary/50 focus-visible:ring-1 focus-visible:ring-primary/40"
				/>
				<kbd class="pointer-events-none absolute z-10 right-3 top-1/2 hidden -translate-y-1/2 rounded border border-border/60 bg-muted/40 px-1.5 font-mono text-[10px] text-muted-foreground sm:block">
					/
				</kbd>
			</div>
		)
	}

	{
		docProjects.length > 0 && (
			<div class="overflow-hidden rounded-2xl border border-border/70 bg-card dark:bg-[#101119] shadow-sm dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]">
				<div class="hidden md:grid grid-cols-[minmax(0,1fr)_15rem_4rem_1rem] gap-6 border-b border-border/60 bg-muted/20 px-6 py-2.5 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
					<span>Project</span>
					<span>Stack</span>
					<span class="text-right">Pages</span>
					<span />
				</div>
				<ul class="divide-y divide-border/40">
					{docProjects.map((project) => {
						const accent = project.languages[0] ? languageColor(project.languages[0]) : "var(--primary)";
						return (
							<li
								data-docs-row
								data-search={[project.title, project.description, ...project.languages].join(" ").toLowerCase()}
							>
								<a
									href={`/docs/${project.docs_slug}`}
									data-haptic-nav
									style={`--accent-lang: ${accent}`}
									class="group relative grid grid-cols-[minmax(0,1fr)_auto] md:grid-cols-[minmax(0,1fr)_15rem_4rem_1rem] items-center gap-x-6 gap-y-2 px-6 py-3.5 transition-colors hover:bg-[color-mix(in_oklab,var(--accent-lang)_7%,transparent)] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary"
								>
									<span
										class="absolute inset-y-2.5 left-0 w-[3px] rounded-r-full bg-[var(--accent-lang)] opacity-60 transition-all group-hover:inset-y-0 group-hover:opacity-100"
										aria-hidden="true"
									/>
									<div class="min-w-0">
										<h2 class="truncate text-[15px] font-semibold tracking-tight text-foreground transition-colors group-hover:text-primary">
											{project.title}
										</h2>
										<p class="mt-0.5 truncate text-sm text-muted-foreground">
											{project.description}
										</p>
									</div>

									<div class="hidden md:flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11.5px] font-medium leading-none text-foreground/80">
										{project.languages.slice(0, 3).map((lang) => (
											<span class="inline-flex items-center gap-1.5">
												<span
													class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-inset ring-black/10 dark:ring-white/10"
													style={`background-color: ${languageColor(lang)}`}
													aria-hidden="true"
												/>
												{lang}
											</span>
										))}
									</div>

									<span class="hidden md:block text-right font-mono text-xs tabular-nums text-foreground/80">
										{project.pageCount}
									</span>

									<ArrowRight className="w-4 h-4 text-primary/60 transition-all group-hover:translate-x-1 group-hover:text-primary" />
								</a>
							</li>
						);
					})}
				</ul>
				<p data-docs-empty hidden class="px-6 py-10 text-center font-mono text-sm text-muted-foreground">
					no docs match "<span data-docs-query class="text-foreground" />"
				</p>
			</div>
		)
	}

	{
		docProjects.length === 0 && (
			<div class="py-20">
				<EmptyState command="ls ./docs" title="no documentation available yet" />
			</div>
		)
	}
</PageShell>

<script>
	function initDocsSearch() {
		const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
		if (!input) return;
		const rows = document.querySelectorAll<HTMLElement>("[data-docs-row]");
		const empty = document.querySelector<HTMLElement>("[data-docs-empty]");
		const queryEl = document.querySelector<HTMLElement>("[data-docs-query]");

		input.addEventListener("input", () => {
			// Every word has to match somewhere in the title, description, or stack
			const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
			let visible = 0;
			rows.forEach((row) => {
				const haystack = row.dataset.search ?? "";
				const match = terms.every((t) => haystack.includes(t));
				row.hidden = !match;
				if (match) visible++;
			});
			if (empty) empty.hidden = visible > 0;
			if (queryEl) queryEl.textContent = input.value.trim();
		});
	}

	function focusOnSlash(e: KeyboardEvent) {
		if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
		const target = e.target as HTMLElement | null;
		if (target?.closest("input, textarea, [contenteditable]")) return;
		const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
		if (!input) return;
		e.preventDefault();
		input.focus();
	}

	document.addEventListener("astro:page-load", initDocsSearch);
	document.addEventListener("keydown", focusOnSlash);
</script>
