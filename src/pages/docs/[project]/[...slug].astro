---
import Layout from "../../../layouts/Layout.astro";
import Haptics from "../../../components/Haptics.astro";
import MarkdownRenderer from "../../../components/MarkdownRenderer.astro";
import DocsSidebar from "../../../components/docs/DocsSidebar.astro";
import TableOfContents from "../../../components/docs/TableOfContents.astro";
import {
	getAllDocs,
	getSidebar,
	getDocPagination,
	findSidebarTrail,
	processDocContent,
} from "../../../utils/docs";
import { buttonVariants } from "@/components/ui/button";
import { ChevronLeft, ChevronRight, Menu, Copy, Check } from "lucide-react";
import { allProjects } from "../../../data/projects";

export async function getStaticPaths() {
	return getAllDocs();
}

const { project, slug, content, title, headings } = Astro.props;
const sidebar = getSidebar(project);
const { prev, next } = getDocPagination(project, slug);

// The page renders its own title and "On this page" navigation — strip the
// leading h1 and the generated "Table of Contents" section from the body.
const processedContent = processDocContent(content);

const currentProject = allProjects.find((p) => p.slug === project);
const projectTitle = currentProject?.title || project.replace(/-/g, " ");
const pageTitle = title.replace(/^[\d.\s]+/, "");

// Sidebar slugs are always lowercase; the project dir name may not be.
const activePath = `${project.toLowerCase()}/${slug}`;

// Chevron-separated breadcrumb trail (matches PageShell's convention)
const trail = findSidebarTrail(sidebar, activePath) ?? [];
const breadcrumbs = [
	{ label: "Home", href: "/" },
	{ label: "Docs", href: "/docs" },
	{
		label: projectTitle,
		href: currentProject ? `/projects/${currentProject.slug}` : undefined,
	},
	...trail.map((item, i) => ({
		label: item.title,
		href:
			i < trail.length - 1 && item.slug !== "#"
				? `/docs/${item.slug}`
				: undefined,
	})),
];
---

<Layout title={`${pageTitle} | ${projectTitle} Docs | Tashif Ahmad Khan`}>
	<!-- Reading Progress Bar -->
	<div
		id="reading-progress"
		class="fixed top-0 left-0 h-[3px] bg-primary z-[60]"
		style="width:0;transition:width 80ms linear"
	>
	</div>

	<div
		class="flex h-screen overflow-hidden bg-gradient-to-b from-muted to-background dark:from-background dark:to-card text-foreground transition-colors duration-300 font-sans"
	>
		<!-- Desktop sidebar -->
		<aside
			class="hidden lg:block w-72 shrink-0 h-full border-r border-border/60 bg-card/60 backdrop-blur-xl"
		>
			<DocsSidebar
				project={project}
				currentProject={currentProject}
				sidebar={sidebar}
				activePath={activePath}
			/>
		</aside>

		<!-- Mobile sidebar toggle -->
		<div class="lg:hidden fixed top-4 right-4 z-40">
			<button
				id="open-sidebar"
				aria-label="Open navigation"
				data-haptic
				class={buttonVariants({
					variant: "outline",
					size: "icon",
					className: "bg-card/80 backdrop-blur border-border/60 shadow-md",
				})}
			>
				<Menu className="h-4 w-4" />
			</button>
		</div>

		<!-- Mobile sidebar overlay -->
		<div
			id="mobile-sidebar-overlay"
			class="fixed inset-0 z-50 bg-black/80 lg:hidden hidden backdrop-blur-sm transition-all duration-200 opacity-0 data-[state=open]:opacity-100"
		>
		</div>

		<!-- Mobile sidebar drawer -->
		<div
			id="mobile-sidebar"
			class="fixed inset-y-0 left-0 z-50 h-full w-80 max-w-[85vw] border-r border-border/60 bg-card shadow-xl transition-transform duration-300 ease-in-out -translate-x-full lg:hidden data-[state=open]:translate-x-0"
		>
			<DocsSidebar
				project={project}
				currentProject={currentProject}
				sidebar={sidebar}
				activePath={activePath}
				mobile
			/>
		</div>

		<main class="relative flex-1 min-w-0 h-full overflow-y-auto">
			<!-- Atmospheric wash behind the header, matching PageShell's orange tint -->
			<div
				class="pointer-events-none absolute inset-x-0 top-0 [mask-image:radial-gradient(80%_60%_at_50%_0%,black,transparent)]"
			>
				<div
					class="h-40 bg-gradient-to-b from-orange-200/40 to-transparent dark:from-orange-900/20"
				>
				</div>
			</div>

			<div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-10">
				<div class="flex flex-col xl:flex-row gap-12">
					<article class="flex-1 min-w-0 max-w-4xl">
						<nav aria-label="Breadcrumb" class="mb-5">
							<ol
								class="flex flex-wrap items-center gap-x-2 gap-y-1 font-sans text-sm"
							>
								{
									breadcrumbs.map((crumb, i) => (
										<li class="flex items-center gap-x-2 min-w-0">
											{i > 0 && (
												<ChevronRight
													className="w-3.5 h-3.5 shrink-0 text-muted-foreground/50"
													aria-hidden="true"
												/>
											)}
											{crumb.href ? (
												<a
													href={crumb.href}
													data-haptic-nav
													class="text-muted-foreground hover:text-primary transition-colors"
												>
													{crumb.label}
												</a>
											) : (
												<span
													class="text-foreground font-medium truncate max-w-[200px]"
													aria-current={
														i === breadcrumbs.length - 1 ? "page" : undefined
													}
												>
													{crumb.label}
												</span>
											)}
										</li>
									))
								}
							</ol>
						</nav>

						<div
							class="mb-8 flex flex-wrap items-start justify-between gap-4 border-b border-border/60 pb-6"
						>
							<h1
								class="font-sans text-3xl sm:text-4xl font-bold tracking-tight bg-gradient-to-r from-primary to-orange-400 bg-clip-text text-transparent pb-1"
							>
								{pageTitle}
							</h1>

							<button
								id="copy-markdown"
								data-haptic
								class={buttonVariants({
									variant: "outline",
									size: "sm",
									className:
										"h-8 px-3 text-xs gap-1.5 bg-background/50 backdrop-blur-sm hover:bg-muted transition-all shrink-0",
								})}
								data-content={content}
							>
								<span id="copy-icon-active" class="flex items-center gap-1.5">
									<Copy className="w-3.5 h-3.5" />
									Copy MD
								</span>
								<span
									id="copy-icon-success"
									class="hidden items-center gap-1.5 text-green-500"
								>
									<Check className="w-3.5 h-3.5" />
									Copied!
								</span>
							</button>
						</div>

						<MarkdownRenderer
							content={processedContent}
							project={project}
							githubBaseUrl={currentProject?.github_link ||
								`https://github.com/tashifkhan/${project}`}
						/>

						<nav
							class="mt-16 flex flex-col sm:flex-row gap-4 border-t border-border/60 pt-8"
							aria-label="Pagination"
						>
							{
								prev ? (
									<a
										href={`/docs/${prev.slug}`}
										data-haptic-nav
										class="group flex-1 min-w-0 rounded-2xl border border-border/50 bg-card/70 backdrop-blur-sm p-4 transition-all duration-200 hover:border-primary/30 hover:shadow-md"
									>
										<span class="flex items-center gap-1 text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground">
											<ChevronLeft className="w-3 h-3 transition-transform group-hover:-translate-x-0.5" />
											Previous
										</span>
										<span class="mt-1.5 block truncate text-sm font-medium text-foreground transition-colors group-hover:text-primary">
											{prev.title}
										</span>
									</a>
								) : (
									<div class="hidden sm:block flex-1" />
								)
							}
							{
								next && (
									<a
										href={`/docs/${next.slug}`}
										data-haptic-nav
										class="group flex-1 min-w-0 rounded-2xl border border-border/50 bg-card/70 backdrop-blur-sm p-4 text-right transition-all duration-200 hover:border-primary/30 hover:shadow-md"
									>
										<span class="flex items-center justify-end gap-1 text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground">
											Next
											<ChevronRight className="w-3 h-3 transition-transform group-hover:translate-x-0.5" />
										</span>
										<span class="mt-1.5 block truncate text-sm font-medium text-foreground transition-colors group-hover:text-primary">
											{next.title}
										</span>
									</a>
								)
							}
						</nav>
					</article>

					<aside class="hidden xl:block w-64 shrink-0">
						<TableOfContents headings={headings || []} />
					</aside>
				</div>
			</div>
		</main>
	</div>
	<Haptics />
</Layout>

<script>
	function toggleSidebar(show: boolean) {
		const overlay = document.getElementById("mobile-sidebar-overlay");
		const sidebar = document.getElementById("mobile-sidebar");
		if (!sidebar || !overlay) return;

		if (show) {
			sidebar.dataset.state = "open";
			overlay.classList.remove("hidden");
			// small delay to allow display:block to apply before opacity transition
			requestAnimationFrame(() => {
				overlay.dataset.state = "open";
			});
		} else {
			sidebar.removeAttribute("data-state");
			overlay.removeAttribute("data-state");
			setTimeout(() => {
				overlay.classList.add("hidden");
			}, 200);
		}
	}

	function initDocsPage() {
		// The ClientRouter swaps the DOM on navigation, so rebind every load
		document
			.getElementById("open-sidebar")
			?.addEventListener("click", () => toggleSidebar(true));
		document
			.getElementById("close-sidebar")
			?.addEventListener("click", () => toggleSidebar(false));
		document
			.getElementById("mobile-sidebar-overlay")
			?.addEventListener("click", () => toggleSidebar(false));

		// Copy Markdown
		const copyBtn = document.getElementById("copy-markdown");
		const activeIcon = document.getElementById("copy-icon-active");
		const successIcon = document.getElementById("copy-icon-success");

		if (copyBtn && activeIcon && successIcon && !copyBtn.dataset.wired) {
			copyBtn.dataset.wired = "true";
			copyBtn.addEventListener("click", async () => {
				const content = copyBtn.getAttribute("data-content") || "";
				try {
					await navigator.clipboard.writeText(content);
					activeIcon.classList.add("hidden");
					successIcon.classList.remove("hidden");
					successIcon.classList.add("flex");
					copyBtn.classList.add("border-green-500/50", "bg-green-500/5");

					setTimeout(() => {
						activeIcon.classList.remove("hidden");
						successIcon.classList.add("hidden");
						successIcon.classList.remove("flex");
						copyBtn.classList.remove("border-green-500/50", "bg-green-500/5");
					}, 2000);
				} catch (err) {
					console.error("Failed to copy markdown: ", err);
				}
			});
		}

		// Scroll the active sidebar link into view
		const activeLink = document.querySelector('[data-sidebar-active="true"]');
		activeLink?.scrollIntoView({ behavior: "auto", block: "center" });

		// Reading progress — the docs page scrolls inside <main>, not the window
		const bar = document.getElementById("reading-progress");
		const scroller = document.querySelector("main");
		if (bar && scroller && !bar.dataset.wired) {
			bar.dataset.wired = "true";
			const updateProgress = () => {
				const denom = Math.max(
					1,
					scroller.scrollHeight - scroller.clientHeight
				);
				const pct = Math.min(
					100,
					Math.max(0, (scroller.scrollTop / denom) * 100)
				);
				bar.style.width = pct + "%";
			};
			scroller.addEventListener("scroll", updateProgress, { passive: true });
			window.addEventListener("resize", updateProgress, { passive: true });
			updateProgress();
		}
	}

	initDocsPage();
	document.addEventListener("astro:page-load", initDocsPage);
</script>
