---
import PageShell from "../../layouts/PageShell.astro";
import LeetCodeStats from "../../components/leetcode/LeetCodeStats.astro";
import LeetCodeContests from "../../components/leetcode/LeetCodeContests.astro";
import LeetCodeSubmissions from "../../components/leetcode/LeetCodeSubmissions.astro";
import LeetCodeBadges from "../../components/leetcode/LeetCodeBadges.astro";
import DataFreshness from "../../components/common/DataFreshness";
import { leetCodeData, leetCodeFetchedAt } from "../../data/leetcode";

// Contests and submissions share a row; skip it when both are empty.
const hasPanels =
	(leetCodeData.contestSummary !== null && leetCodeData.contests.length > 0) ||
	leetCodeData.recentSubmissions.length > 0;
import { ExternalLink } from "lucide-react";
---

<PageShell
	title="LeetCode Stats | Tashif Ahmad Khan"
	image="/og/leetcode-stats.jpg"
	tint="orange"
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "LeetCode", href: "/leetcode" }, { label: "Stats" }]}
>
	<Fragment slot="header">
		<div class="flex items-center justify-between gap-4">
			<h1 class="font-sans text-4xl sm:text-5xl font-semibold tracking-tight text-foreground">LeetCode</h1>
			<a
				href="https://leetcode.com/u/khan_tashif/"
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-primary/10 px-4 py-2 text-sm font-medium text-primary ring-1 ring-primary/25 transition-colors hover:bg-primary/20 hover:ring-primary/40"
			>
				<ExternalLink className="w-4 h-4" />
				Profile
			</a>
		</div>
		<p class="mt-2 sm:mt-3 max-w-xl text-sm sm:text-base text-muted-foreground">
			Problems solved by difficulty, contest rating and what I've been submitting lately.
		</p>
		<div class="mt-3">
			<DataFreshness
				client:load
				source="leetcode"
				fetchedAt={leetCodeFetchedAt}
				label="LeetCode stats"
				description="Re-fetch solved counts, acceptance, ranking and the difficulty breakdown from the live LeetCode stats API."
			/>
		</div>
	</Fragment>

	<div class="space-y-6 sm:space-y-8">
		<LeetCodeStats />
		{hasPanels && (
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<LeetCodeContests limit={20} />
				<LeetCodeSubmissions limit={20} />
			</div>
		)}
		<LeetCodeBadges />
	</div>
</PageShell>
