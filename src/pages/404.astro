---
import Layout from "../layouts/Layout.astro";
import {
	Home,
	ArrowLeft,
	CornerDownLeft,
	Zap,
	FileText,
	Code2,
	BookOpen,
} from "lucide-react";

const quickLinks = [
	{ href: "/#projects-tab", label: "projects", icon: Zap },
	{ href: "/#blog-tab", label: "blog", icon: BookOpen },
	{ href: "/#leetcode-tab", label: "leetcode", icon: Code2 },
	{ href: "/#resume-tab", label: "resume", icon: FileText },
];
---

<Layout title="404 — Page Not Found | Tashif Ahmad Khan">
	<main
		class="relative min-h-screen bg-background text-foreground font-sans overflow-hidden"
	>
		<!-- Grid + glow backdrop -->
		<div
			class="pointer-events-none absolute inset-0 [mask-image:radial-gradient(80%_60%_at_50%_25%,black,transparent)]"
		>
			<div
				class="absolute inset-0 opacity-[0.6]"
				style="background-image:linear-gradient(to right,color-mix(in_oklab,var(--border)_60%,transparent) 1px,transparent 1px),linear-gradient(to bottom,color-mix(in_oklab,var(--border)_60%,transparent) 1px,transparent 1px);background-size:44px 44px;"
			>
			</div>
		</div>
		<div
			class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 h-[32rem] w-[32rem] rounded-full bg-primary/15 blur-[120px]"
		>
		</div>

		<div
			class="relative z-10 flex min-h-screen flex-col items-center justify-center px-4 py-16 sm:px-6"
		>
			<div class="w-full max-w-2xl">
				<!-- Terminal window -->
				<section
					class="overflow-hidden rounded-xl border border-border/70 bg-card/70 shadow-xl backdrop-blur-xl"
					aria-label="Error terminal"
				>
					<!-- Title bar -->
					<div
						class="flex items-center gap-2 border-b border-border/70 bg-muted/40 px-4 py-2.5"
					>
						<span class="flex gap-1.5" aria-hidden="true">
							<span class="h-3 w-3 rounded-full bg-destructive/80"></span>
							<span class="h-3 w-3 rounded-full bg-primary/70"></span>
							<span class="h-3 w-3 rounded-full bg-emerald-500/70"></span>
						</span>
						<span
							id="terminal-title"
							class="flex-1 truncate px-2 text-center font-mono text-xs text-muted-foreground/80"
							>tashif.codes — zsh — 404</span
						>
						<span class="w-[52px]" aria-hidden="true"></span>
					</div>

					<!-- Terminal body -->
					<div class="px-4 py-6 font-mono text-sm sm:px-7 sm:py-8">
						<!-- Command line -->
						<p class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
							<span class="select-none font-bold text-primary" aria-hidden="true"
								>➜</span
							>
							<span class="font-semibold text-foreground">~</span>
							<span id="requested-cmd" class="text-foreground/90">cat</span>
							<span
								id="requested-path"
								class="max-w-full truncate text-muted-foreground"
								>the-page-you-wanted</span
							>
						</p>
						<!-- Error output -->
						<p class="mt-2 break-words text-destructive/90">
							<span id="error-prefix">cat</span>: <span id="requested-path-echo"
								>route</span
							>: <span id="error-suffix">No such file or directory</span>
						</p>

						<!-- Big 404 glyph -->
						<div class="my-8 select-none text-center">
							<h1
								class="glyph-404 bg-gradient-to-b from-primary to-primary/50 bg-clip-text text-7xl font-bold leading-none tracking-tight text-transparent sm:text-8xl"
							>
								404
							</h1>
						</div>

						<!-- Message -->
						<div class="text-center">
							<h2
								id="error-title"
								class="mb-2 text-xl font-bold text-foreground sm:text-2xl"
							>
								Page Not Found
							</h2>
							<p
								id="error-message"
								class="mx-auto max-w-md font-sans text-sm leading-relaxed text-muted-foreground"
							>
								The page you're looking for wandered off into the digital void.
								Even the best explorers take a wrong turn now and then.
							</p>
						</div>

						<!-- Actions -->
						<div
							class="mt-7 flex flex-col items-stretch justify-center gap-3 sm:flex-row"
						>
							<a
								href="/"
								data-haptic-nav
								class="group inline-flex h-11 items-center justify-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-foreground shadow-sm transition-all hover:bg-primary/90 hover:shadow-md"
							>
								<Home size={16} />
								Back to Dashboard
							</a>
							<button
								id="go-back-btn"
								type="button"
								data-haptic-back
								class="group inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-border/70 bg-transparent px-5 text-sm font-semibold text-foreground transition-colors hover:bg-accent"
							>
								<ArrowLeft
									size={16}
									className="transition-transform group-hover:-translate-x-0.5"
								/>
								Go Back
							</button>
						</div>
					</div>
				</section>

				<!-- Quick nav -->
				<div class="mt-6">
					<p
						class="mb-3 px-1 font-mono text-xs uppercase tracking-[0.15em] text-muted-foreground/70"
					>
						<span class="text-primary">~</span> jump to
					</p>
					<div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
						{
							quickLinks.map((link) => (
								<a
									href={link.href}
									data-haptic-nav
									class="group flex items-center gap-2.5 rounded-lg border border-border/60 bg-card/50 px-3.5 py-3 transition-all hover:border-primary/40 hover:bg-primary/5"
								>
									<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary transition-transform group-hover:scale-110">
										<link.icon size={15} />
									</span>
									<span class="font-mono text-sm font-medium text-muted-foreground transition-colors group-hover:text-foreground">
										{link.label}
									</span>
								</a>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</main>

	<script is:inline>
		// Callers can hand us context about what they failed to resolve, so this
		// page can name it instead of showing a generic "page not found".
		//   ?from=shortlink&path=/<path>&slug=<slug>
		// The shortener (smoll-url) redirects its 404s here with those params.
		function init404() {
			const params = new URLSearchParams(window.location.search);
			// Everything below is written with textContent, never innerHTML — but
			// still clamp it so a hostile link can't stuff the page with prose.
			const param = (key) => (params.get(key) || "").trim().slice(0, 120);

			const from = param("from");
			const slug = param("slug");
			const fromPath = param("path");

			const pathname = window.location.pathname.replace(/^\/+|\/+$/g, "");
			// The shortener's path wins: our own pathname is just /404 by then.
			const requested =
				fromPath.replace(/^\/+|\/+$/g, "") || (slug ? slug : pathname);
			const route = requested ? "/" + requested : "";
			// Short links live under this domain too (the middleware resolves them),
			// so always show the canonical tashif.codes/<slug> form.
			const host = window.location.host || "tashif.codes";

			const view =
				from === "shortlink"
					? {
							title: host + " — curl — 404",
							cmd: "curl -sIL",
							target: host + (route || "/…"),
							errPrefix: "curl",
							errPath: route || "shortlink",
							errSuffix: "No such shortlink — expired, revoked, or never existed",
							heading: "Short Link Not Found",
							message:
								"That short link doesn't resolve to anything. It may have expired, been revoked, or never existed — check the link for typos and try again.",
						}
					: {
							title: "tashif.codes — zsh — 404",
							cmd: "cat",
							target: route || "the-page-you-wanted",
							errPrefix: "cat",
							errPath: route || "route",
							errSuffix: "No such file or directory",
							heading: "Page Not Found",
							message:
								"The page you're looking for wandered off into the digital void. Even the best explorers take a wrong turn now and then.",
						};

			const set = (id, text) => {
				const el = document.getElementById(id);
				if (el) el.textContent = text;
			};

			set("terminal-title", view.title);
			set("requested-cmd", view.cmd);
			set("requested-path", view.target);
			set("error-prefix", view.errPrefix);
			set("requested-path-echo", view.errPath);
			set("error-suffix", view.errSuffix);
			set("error-title", view.heading);
			set("error-message", view.message);

			document.title =
				view.heading + " — 404 | Tashif Ahmad Khan";

			const back = document.getElementById("go-back-btn");
			if (back) {
				back.addEventListener("click", () => {
					if (window.history.length > 1) window.history.back();
					else window.location.href = "/";
				});
			}
		}
		init404();
		document.addEventListener("astro:page-load", init404);
	</script>

	<style>
		.glyph-404 {
			filter: drop-shadow(0 0 28px oklch(0.6397 0.172 36.4421 / 0.35));
			animation: glyph-float 5s ease-in-out infinite;
		}

		@keyframes glyph-float {
			0%,
			100% {
				transform: translateY(0);
			}
			50% {
				transform: translateY(-6px);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.glyph-404 {
				animation: none;
			}
		}
	</style>
</Layout>
