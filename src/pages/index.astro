---
import Layout from "../layouts/Layout.astro";
import ProjectFilters from "../components/ProjectFilters.tsx";
import ProfileDropdown from "../components/ProfileDropdown";
import { starLists } from "../data/starLists";
import BlogFilters from "../components/BlogFilters";
import BlogCard from "../components/BlogCard.astro";
import LeetCodeStats from "../components/LeetCodeStats.astro";
import GitHubStats from "../components/GitHubStats.astro";
import LeetCodeContests from "../components/LeetCodeContests.astro";
import LeetCodeBadges from "../components/LeetCodeBadges.astro";
import Resume from "../components/Resume.astro";
import {
	Github,
	Twitter,
	Linkedin,
	Mail,
	Code2,
	FolderOpen,
	BookOpen,
	Users,
	ExternalLink,
	ArrowUpRight,
	FileText,
	ArrowUp,
	Trophy,
	ChartPie,
	ChevronRight,
	Star,
} from "lucide-react";
import { allProjects, projectsFetchedAt, type Project } from "../data/projects";
import { fetchAnalyticsProjects, hasAnalytics, getAnalyticsSlug } from "../data/analyticsProjects";
import {
	blogPosts,
	blogFetchedAt,
	blogCategories,
	avgReadingMinutes,
	numBlogPosts,
} from "../data/blog";
import { leetCodeData, leetCodeFetchedAt } from "../data/leetcode";
import { githubStats, githubStatsPersonal, githubFetchedAt } from "../data/github";
import ProjectCard from "../components/ProjectCard.astro";
import EmptyState from "../components/EmptyState.astro";
import DataFreshness from "../components/DataFreshness";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Badge } from "@/components/ui/badge";

import ThemeToggle from "@/components/ThemeToggle";
import { owner, socials, githubProfiles } from "../data/profile";

const socialLink = (label: string) =>
	socials.find((s) => s.label === label)?.link ?? "#";

const projects: Project[] = allProjects;
const analyticsProjects = await fetchAnalyticsProjects();

const { profile } = leetCodeData;
const { stats, stars } = githubStats;
const personalTotalCommits = githubStatsPersonal.stats?.totalCommits ?? 0;

const numProjects = projects.length;
const totalCommits = stats?.totalCommits ?? 0;
const totalSolved = leetCodeData?.stats?.totalSolved ?? 0;
const liveProjectCount = projects.filter((p) => p.live_website_url).length;

// Phrases cycled by the welcome statusline typewriter (a time-of-day
// greeting is prepended client-side)
const welcomePhrases = [
	`shipping ${numProjects} projects — ${liveProjectCount} of them live`,
	"open source, experiments & product work",
	`${totalCommits.toLocaleString()} commits into the void`,
	"currently: probably debugging something",
];
const latestBlogDate = blogPosts[0]?.date ? new Date(blogPosts[0].date) : null;

---

<Layout title={`${owner.name} | Dashboard & Portfolio`}>
	<div
		class="relative min-h-screen bg-background text-foreground dark:text-foreground transition-colors duration-300 font-sans scroll-smooth"
	>
		<div
			class="pointer-events-none absolute inset-0 [mask-image:radial-gradient(80%_60%_at_50%_0%,black,transparent)]"
		>
			<div
				class="h-40 bg-gradient-to-b from-orange-200/40 to-transparent dark:from-orange-900/20"
			>
			</div>
		</div>
		<!-- Header — scrolls away; only the tab nav below stays sticky -->
		<header
			class="relative backdrop-blur supports-[backdrop-filter]:bg-card/70 dark:supports-[backdrop-filter]:bg-card/60 bg-card/80 dark:bg-card/70 border-b border-border/60 dark:border-border/60 shadow-sm"
		>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4 relative">
				<div class="flex flex-col sm:flex-row items-center sm:justify-between gap-4 w-full">
					<!-- Left: Profile Info -->
					<div class="flex items-center space-x-4 overflow-visible w-full sm:w-auto justify-start">
						<div class="relative shrink-0">
							<span class="block p-[2.5px] rounded-full bg-primary/80">
								<img
									src={owner.avatar}
									alt={owner.name}
									class="w-14 h-14 sm:w-[60px] sm:h-[60px] rounded-full object-cover block ring-2 ring-card"
								/>
							</span>
						</div>
						<div class="flex flex-col gap-0.5">
							<h1
								class="text-2xl sm:text-[1.75rem] font-bold text-foreground leading-tight tracking-tight text-left"
								style="font-family: 'Lexend', sans-serif; letter-spacing: -0.02em;"
							>
								{owner.name}
							</h1>
							<div class="flex items-center gap-2 justify-start">
								<span class="block w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
								<p class="text-muted-foreground text-sm font-medium text-left" style="font-family: 'Lexend', sans-serif;">
									{profile.realName || owner.fallbackTitle}
								</p>
							</div>
						</div>
					</div>

					<!-- Right/Center: Social Links and Theme Button -->
					<div class="flex items-center justify-center sm:justify-end w-full sm:w-auto mt-1 sm:mt-0">
						<!-- Social Links -->
						<div class="flex items-center gap-0.5 sm:gap-1 z-10">
							{
								socials.map((social) => (
									<Button
										variant="ghost"
										size="icon"
										asChild
										className="rounded-full h-9 w-9 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
									>
										<a
											href={social.link}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={social.label}
											data-haptic-social
										>
											<social.icon size={18} />
										</a>
									</Button>
								))
							}
						</div>

						<!-- Desktop Divider -->
						<div class="hidden sm:block w-px h-5 bg-border/60 mx-3 sm:mx-4 z-10"></div>

						<!-- Theme Button (Inline on Desktop, Absolute on Mobile) -->
						<div class="absolute right-4 top-[60%] -translate-y-1/2 sm:static sm:translate-y-0 z-20">
							<div class="rounded-full bg-secondary/40 ring-1 ring-border/60 hover:ring-border transition-all">
								<ThemeToggle client:load />
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- Navigation (Styled as Shadcn Tabs) -->
		<nav
			class="sticky top-0 z-40 backdrop-blur supports-[backdrop-filter]:bg-card/70 dark:supports-[backdrop-filter]:bg-card/60 bg-card/80 dark:bg-card/70 border-b border-border/60 dark:border-border/60 transition-colors duration-300 overflow-x-auto font-sans no-scrollbar"
		>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
				<div
					class="inline-flex h-10 items-center justify-start rounded-md bg-muted p-1 text-muted-foreground w-full sm:w-auto overflow-x-auto no-scrollbar"
					style="overflow-x: auto !important;"
				>
					<button
						id="projects-tab"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm hover:text-foreground shrink-0"
						data-state="active"
					>
						<FolderOpen size={16} className="mr-2" />
						Projects
					</button>
					<button
						id="resume-tab"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm hover:text-foreground shrink-0"
						data-state="inactive"
					>
						<FileText size={16} className="mr-2" />
						About
					</button>
					<button
						id="blog-tab"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm hover:text-foreground shrink-0"
						data-state="inactive"
					>
						<BookOpen size={16} className="mr-2" />
						Blog
					</button>
					<button
						id="github-tab"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm hover:text-foreground shrink-0"
						data-state="inactive"
					>
						<Github size={16} className="mr-2" />
						GitHub
					</button>
					<button
						id="leetcode-tab"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm hover:text-foreground shrink-0"
						data-state="inactive"
					>
						<Code2 size={16} className="mr-2" />
						LeetCode
					</button>
					<button
						id="community-tab"
						class="inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow-sm hover:text-foreground shrink-0"
						data-state="inactive"
					>
						<Users size={16} className="mr-2" />
						Connect
					</button>
				</div>
			</div>
		</nav>

		<!-- Main Content -->
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
			<!-- Welcome restore pill (shown when banner is hidden) -->
			<div id="welcome-restore" class="mb-4 hidden">
				<Button
					id="welcome-restore-btn"
					variant="outline"
					size="sm"
					className="rounded-full bg-card/60 dark:bg-card/60"
					aria-controls="welcome-banner"
				>
					<span class="inline-block h-2 w-2 rounded-full bg-orange-500 mr-2"
					></span>
					Show welcome
				</Button>
			</div>

			<!-- Welcome Banner -->
			<Card
				id="welcome-banner"
				className="relative mb-6 overflow-hidden bg-card/60 dark:bg-card/60 backdrop-blur border-border/60 dark:border-border/60"
			>
				<CardContent className="relative px-4 py-3 sm:px-5">
					<h2 class="sr-only">Welcome</h2>
					<div class="flex items-center gap-x-4 lg:gap-x-6">
						<!-- Terminal prompt + typewriter -->
						<div
							class="flex items-baseline gap-1.5 font-mono text-sm flex-1 min-w-0"
							aria-label="Welcome message"
						>
							<span class="text-primary font-bold select-none" aria-hidden="true"
								>➜</span
							>
							<span class="font-semibold text-foreground whitespace-nowrap"
								><span class="hidden sm:inline">taf@</span>tashif.codes</span
							>
							<span class="text-muted-foreground/70 select-none" aria-hidden="true"
								>%</span
							>
							<span
								id="welcome-typer"
								class="text-muted-foreground truncate"
								data-phrases={JSON.stringify(welcomePhrases)}
								>{welcomePhrases[0]}</span
							>
							<span
								class="welcome-cursor inline-block w-[7px] h-3.5 self-center rounded-[1px] bg-primary/70 shrink-0"
								aria-hidden="true"></span>
						</div>
						<div class="flex items-center gap-x-4 xl:gap-x-6 shrink-0">
							{
								[
									{ icon: Code2, value: numProjects, label: "Projects" },
									{ icon: BookOpen, value: numBlogPosts, label: "Posts" },
									{ icon: Github, value: totalCommits, label: "Commits" },
									{ icon: Trophy, value: totalSolved, label: "Solved" },
								].map((stat) => (
									<div class="flex items-center gap-1.5">
										<stat.icon className="w-3.5 h-3.5 text-primary/80" />
										<span
											class="font-mono text-sm font-semibold text-foreground tabular-nums"
											data-countup={stat.value}
										>
											{stat.value.toLocaleString()}
										</span>
										<span class="hidden lg:inline text-[10px] font-medium uppercase tracking-[0.15em] text-muted-foreground/80">
											{stat.label}
										</span>
									</div>
								))
							}
						</div>
						<div class="flex items-center gap-2 shrink-0 ml-auto">
							<a
								href="/resume"
								aria-label="View resume"
								data-haptic-nav
								class="inline-flex items-center gap-1.5 h-7 px-3 text-xs font-semibold rounded-full text-primary border border-border/60 hover:bg-primary/10 hover:border-primary/30 transition-colors"
							>
								<FileText size={14} />
								<span class="hidden sm:inline">Resume</span>
							</a>
							<button
								id="welcome-dismiss"
								aria-label="Dismiss welcome"
								aria-controls="welcome-banner"
								class="inline-flex items-center justify-center h-7 w-7 rounded-full text-muted-foreground hover:text-foreground hover:bg-accent transition-colors"
							>
								<span aria-hidden="true">×</span>
							</button>
						</div>
					</div>
				</CardContent>
			</Card>

			<!-- Projects Section -->
			<div id="projects-section">
				<!-- Section heading: single compact row -->
				<div class="mb-4 sm:mb-5 flex items-center gap-x-2 sm:gap-x-3 min-w-0">
					<h2
						class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
					>
						Projects
					</h2>
					<span
						class="hidden xs:inline-flex sm:inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground truncate min-w-0"
					>
						<span class="font-bold text-foreground tabular-nums"
							>{numProjects}</span
						>
						<span class="hidden sm:inline">total</span>
						<span class="text-border select-none hidden sm:inline" aria-hidden="true">·</span>
						<span
							class="relative flex h-1.5 w-1.5 shrink-0 hidden sm:flex"
							aria-hidden="true"
						>
							<span
								class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-60"
							></span>
							<span
								class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"
							></span>
						</span>
						<span class="font-bold text-foreground tabular-nums hidden sm:inline"
							>{liveProjectCount}</span
						>
						<span class="hidden sm:inline">live</span>
					</span>
					<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
						<DataFreshness
							client:load
							source="projects"
							fetchedAt={projectsFetchedAt}
							compact
						/>
						<a
							href="/projects/stats"
							data-haptic-nav
							class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-primary/80 transition-colors shrink-0"
							aria-label="View project stats"
						>
							<ChartPie className="w-3.5 h-3.5" />
							<span class="hidden sm:inline">View Stats</span>
						</a>
					</div>
				</div>

				<ProjectFilters client:load starLists={starLists} />
				<div
					class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 auto-rows-fr"
				>
					{
						projects.map((project) => (
							<div
								class="h-full"
								data-project-item-card
								data-has-live-link={Boolean(project.live_website_url)}
							>
								<ProjectCard
									project={project}
									hasAnalytics={hasAnalytics(project.slug, analyticsProjects)}
									analyticsSlug={getAnalyticsSlug(project.slug)}
								/>
							</div>
						))
					}
				</div>
			</div>

			<!-- Resume Section -->
			<div id="resume-section" class="hidden">
				<Resume />
			</div>

			<!-- Blog Section -->
			<div id="blog-section" class="hidden relative">
				<!-- Section heading: single compact row -->
				<div class="mb-4 sm:mb-5 flex items-center gap-x-2 sm:gap-x-3 min-w-0">
					<h2
						class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
					>
						Blog
					</h2>
					<span
						class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground truncate min-w-0"
					>
						<span
							class="font-bold text-foreground tabular-nums"
							data-blog-post-count
							>{numBlogPosts}</span
						>
						posts
						{
							avgReadingMinutes > 0 && (
								<>
									<span
										class="text-border select-none hidden sm:inline"
										aria-hidden="true"
									>
										·
									</span>
									<span
										class="font-bold text-foreground tabular-nums hidden sm:inline"
										data-blog-avg-read
									>
										{avgReadingMinutes}
									</span>
									<span class="hidden sm:inline">min avg</span>
								</>
							)
						}
					</span>
					<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
						<DataFreshness
							client:load
							source="blog"
							fetchedAt={blogFetchedAt}
							label="Blog posts"
							description="Re-fetch titles, excerpts, tags, and reading times from the live blog API. Views, likes, and comments only load on individual post pages."
							compact
						/>
						<a
							href="/blog"
							data-haptic-nav
							class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-primary/80 transition-colors shrink-0"
							aria-label="Open blog page"
						>
							<span class="hidden sm:inline">View all</span>
							<ArrowUpRight size={12} />
						</a>
					</div>
				</div>
				<BlogFilters client:load categories={blogCategories} />
				{
					blogPosts.length > 0 ? (
						<div class="space-y-10">
							<section class="mb-4">
								<BlogCard post={blogPosts[0]} variant="featured" index={0} />
							</section>
							<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
								{blogPosts.slice(1).map((post, idx) => (
									<BlogCard post={post} variant="default" index={idx + 1} />
								))}
							</div>
							<div class="pt-10">
								<Card className="w-full text-center border-0 shadow-lg bg-gradient-to-br from-primary/5 via-transparent to-primary/5 dark:from-primary/10 dark:via-transparent dark:to-primary/10">
									<CardContent className="p-8 sm:p-10 space-y-6 relative overflow-hidden">
										<div class="absolute inset-0 bg-grid-slate-200/50 dark:bg-grid-slate-800/50 [mask-image:linear-gradient(to_bottom,transparent,black,transparent)] pointer-events-none" />
										<div class="space-y-3 relative z-10">
											<h3 class="text-2xl font-bold text-foreground dark:text-white tracking-tight">
												Want to read more?
											</h3>
											<p class="text-muted-foreground dark:text-muted-foreground max-w-lg mx-auto leading-relaxed">
												Browse the full post list on this site, or open the
												standalone blog archive.
											</p>
										</div>
										<div class="flex flex-wrap justify-center gap-3 relative z-10">
											<Button
												size="lg"
												className="rounded-full px-8 bg-primary text-primary-foreground hover:bg-primary/90 shadow-md transition-all hover:scale-105"
												asChild
											>
												<a
													href="/blog"
													data-haptic-nav
													class="flex items-center gap-2"
												>
													Open blog page
													<ArrowUpRight size={16} />
												</a>
											</Button>
											<Button
												size="lg"
												variant="outline"
												className="rounded-full px-8"
												asChild
											>
												<a
													href="https://blog.tashif.codes"
													data-haptic-external
													target="_blank"
													rel="noopener noreferrer"
													class="flex items-center gap-2"
												>
													blog.tashif.codes
													<ExternalLink size={16} />
												</a>
											</Button>
										</div>
									</CardContent>
								</Card>
							</div>
						</div>
					) : (
						<div class="py-14">
							<EmptyState
								command="ls ./blog"
								title="no posts available"
								description="Unable to load blog posts from the external API. Try again later or visit the blog directly."
								ctaLabel="visit blog"
								ctaHref="https://blog.tashif.codes"
								ctaExternal
							/>
						</div>
					)
				}
			</div>

			<!-- GitHub Section -->
			<div id="github-section" class="hidden space-y-8">
				<!-- Section heading (GitHub): single compact row -->
				<div class="flex items-center gap-x-2 sm:gap-x-3 min-w-0">
					<h2
						class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
					>
						GitHub
					</h2>
					<span
						class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground truncate min-w-0"
					>
						<span
							class="font-bold text-foreground tabular-nums"
							data-github-heading-commits
							data-value-all={totalCommits.toLocaleString()}
							data-value-personal={personalTotalCommits.toLocaleString()}
							>{totalCommits.toLocaleString()}</span
						>
						<span class="hidden sm:inline">commits</span>
					</span>
					<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
						<DataFreshness
							client:load
							source="github"
							fetchedAt={githubFetchedAt}
							compact
						/>
						<ProfileDropdown client:load />
						<a
							href="/github"
							data-haptic-nav
							class="inline-flex items-center gap-0.5 text-xs font-semibold text-chart-3 hover:text-chart-3/80 transition-colors shrink-0"
							aria-label="Full GitHub page"
						>
							<span class="hidden sm:inline">Full Page</span>
							<span class="sm:hidden">Full</span>
							<ChevronRight className="w-3 h-3" />
						</a>
