---
import "../styles/global.css";
import PostHog from "../components/common/posthog.astro";
import Haptics from "../components/common/Haptics.astro";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import {
	DEFAULT_DESCRIPTION,
	DEFAULT_OG_IMAGE,
	SITE_NAME,
	absoluteUrl,
	resolveSocialImageMeta,
	siteAuthor,
	type SeoProps,
} from "../lib/seo";

interface Props extends Omit<SeoProps, "title"> {
	title: string;
}

const {
	title,
	description = DEFAULT_DESCRIPTION,
	image,
	url,
	type = "website",
	publishedTime,
	tags,
} = Astro.props;

const canonical = absoluteUrl(url ?? Astro.url.pathname);
const social = resolveSocialImageMeta({
	image: image ?? DEFAULT_OG_IMAGE,
	alt: title,
});
---

<!doctype html>
<html lang="en" class="font-sans" prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<meta name="author" content={siteAuthor()} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="canonical" href={canonical} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Blog — Tashif Ahmad Khan"
			href="https://tashif.codes/rss.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Projects — Tashif Ahmad Khan"
			href="https://tashif.codes/rss-projects.xml"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!--
		  Open Graph — WhatsApp, Telegram, iMessage, Signal, Discord, Slack,
		  LinkedIn, Facebook. Width/height let WhatsApp/iMessage paint the card
		  on first share without an async image probe.
		-->
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={social.url} />
		<meta property="og:image:secure_url" content={social.url} />
		<meta property="og:image:type" content={social.type} />
		<meta property="og:image:width" content={String(social.width)} />
		<meta property="og:image:height" content={String(social.height)} />
		<meta property="og:image:alt" content={social.alt} />
		{
			type === "article" && publishedTime && (
				<meta property="article:published_time" content={publishedTime} />
			)
		}
		{
			type === "article" &&
				tags?.map((tag) => <meta property="article:tag" content={tag} />)
		}

		<!-- X / Twitter large card (+ some Discord clients) -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={social.url} />
		<meta name="twitter:image:alt" content={social.alt} />

		<!-- Schema.org itemprops — older scrapers / some iMessage paths -->
		<meta itemprop="name" content={title} />
		<meta itemprop="description" content={description} />
		<meta itemprop="image" content={social.url} />

		<ClientRouter />
	</head>
	<body>
		<slot />
		<Haptics />
		<PostHog />
		<Analytics />
		<script is:inline>
			// Apply theme before paint to avoid flash — runs on initial load and after every swap
			function applyTheme() {
				const storedTheme = localStorage.getItem("theme");
				const theme =
					storedTheme ||
					(window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");

				if (theme === "cream") {
					document.documentElement.classList.remove("dark");
					document.documentElement.classList.add("cream");
				} else if (theme === "dark") {
					document.documentElement.classList.add("dark");
					document.documentElement.classList.remove("cream");
				} else {
					document.documentElement.classList.remove("dark");
					document.documentElement.classList.remove("cream");
				}

				if (!storedTheme) {
					localStorage.setItem("theme", theme);
				}
			}

			applyTheme();
			document.addEventListener("astro:after-swap", applyTheme);
		</script>
	</body>
</html>
