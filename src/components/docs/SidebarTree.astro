---
import { ChevronRight, FileText } from "lucide-react";
import type { SidebarItem } from "@/types";

interface Props {
	items: SidebarItem[];
	activePath: string;
	depth?: number;
}

const { items, activePath, depth = 0 } = Astro.props;

const isActive = (item: SidebarItem) => item.slug === activePath;

const hasActiveDescendant = (item: SidebarItem): boolean =>
	item.children?.some(
		(child) => child.slug === activePath || hasActiveDescendant(child)
	) ?? false;

// Readable pages under a group, including nested groups' own index pages.
const countPages = (item: SidebarItem): number =>
	(item.children ?? []).reduce(
		(n, child) =>
			n + (child.slug !== "#" ? 1 : 0) + (child.children ? countPages(child) : 0),
		0
	);

// Nested rows sit inside a guide line; the active row paints its own
// segment of that line so the reader can trace where they are.
const rowClasses = (item: SidebarItem) => [
	"relative flex w-full items-start gap-2 rounded-md px-2 py-1.5 text-sm leading-snug transition-colors",
	isActive(item)
		? "bg-primary/10 font-medium text-primary"
		: "text-muted-foreground hover:bg-muted/60 hover:text-foreground",
	depth > 0 &&
		isActive(item) &&
		"before:absolute before:-left-[9px] before:inset-y-1 before:w-px before:bg-primary",
];
---

<ul class:list={[depth === 0 ? "space-y-1" : "space-y-0.5"]} role={depth === 0 ? "tree" : "group"}>
	{
		items.map((item) =>
			item.children && item.children.length > 0 ? (
				<li role="treeitem">
					<details
						open={depth === 0 || isActive(item) || hasActiveDescendant(item)}
						class="tree-group"
					>
						<summary
							class:list={[
								"group flex cursor-pointer list-none items-start gap-2 rounded-md px-2 py-1.5 text-sm leading-snug transition-colors select-none [&::-webkit-details-marker]:hidden",
								isActive(item)
									? "bg-primary/10 text-primary"
									: hasActiveDescendant(item)
										? "text-foreground hover:bg-muted/60"
										: "text-foreground/80 hover:bg-muted/60 hover:text-foreground",
								depth === 0 ? "font-semibold" : "font-medium",
							]}
						>
							<ChevronRight className="tree-chevron mt-[3px] h-3.5 w-3.5 shrink-0 text-muted-foreground transition-transform duration-150" />
							{
								item.slug !== "#" ? (
									<a
										href={`/docs/${item.slug}`}
										data-haptic-nav
										data-sidebar-active={isActive(item) ? "true" : undefined}
										aria-current={isActive(item) ? "page" : undefined}
										class="min-w-0 flex-1 hover:underline underline-offset-4 decoration-border"
									>
										{item.title}
									</a>
								) : (
									<span class="min-w-0 flex-1">{item.title}</span>
								)
							}
							<span class="mt-[2px] shrink-0 rounded-full bg-muted/60 px-1.5 text-[10px] font-medium tabular-nums text-muted-foreground">
								{countPages(item)}
							</span>
						</summary>
						<div class="ml-[15px] mt-0.5 border-l border-muted-foreground/25 pl-2">
							<Astro.self
								items={item.children}
								activePath={activePath}
								depth={depth + 1}
							/>
						</div>
					</details>
				</li>
			) : (
				<li role="treeitem">
					<a
						href={`/docs/${item.slug}`}
						data-haptic-nav
						data-sidebar-active={isActive(item) ? "true" : undefined}
						aria-current={isActive(item) ? "page" : undefined}
						class:list={rowClasses(item)}
					>
						<FileText
							className={`mt-[3px] h-3.5 w-3.5 shrink-0 ${isActive(item) ? "text-primary" : "text-muted-foreground/70"}`}
						/>
						<span class="min-w-0">{item.title}</span>
					</a>
				</li>
			)
		)
	}
</ul>

<style>
	details[open] > summary :global(.tree-chevron) {
		transform: rotate(90deg);
	}
</style>
