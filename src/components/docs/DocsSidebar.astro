---
import { ArrowUpRight, ChevronRight, Github, Star, X } from "lucide-react";

import SidebarTree from "./SidebarTree.astro";
import type { Project, SidebarItem } from "@/types";

interface Props {
	project: string;
	currentProject?: Project;
	title: string;
	description?: string;
	sidebar: SidebarItem[];
	activePath: string;
	/** Adds the drawer close button (wired by the page script via #close-sidebar) */
	mobile?: boolean;
	/** Real GitHub remote when the docs folder name is not the repo name. */
	githubUrl?: string;
}

const {
	project,
	currentProject,
	title,
	description,
	sidebar,
	activePath,
	mobile = false,
	githubUrl: githubUrlProp,
} = Astro.props;
const githubUrl =
	githubUrlProp ||
	currentProject?.github_link ||
	`https://github.com/tashifkhan/${project}`;

const chipClass =
	"inline-flex h-7 items-center gap-1.5 rounded-md border border-border/60 bg-muted/30 px-2.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/40 hover:bg-primary/10 hover:text-primary";
---

<div class="flex h-full flex-col">
	<!-- Desktop: the breadcrumb sits on the same line as the page breadcrumb -->
	<div
		class:list={[
			"border-b border-border/60 px-5 pb-5",
			mobile ? "pt-4" : "pt-10",
		]}
	>
		<nav aria-label="Breadcrumb" class="flex items-center justify-between gap-2">
			<ol class="flex items-center gap-1.5 text-sm">
				<li>
					<a href="/docs" data-haptic-back class="text-muted-foreground transition-colors hover:text-primary">Docs</a>
				</li>
				<li aria-hidden="true">
					<ChevronRight className="w-3.5 h-3.5 text-muted-foreground/50" />
				</li>
			</ol>
			{
				mobile && (
					<button
						id="close-sidebar"
						aria-label="Close navigation"
						class="-mr-1.5 flex h-7 w-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground"
					>
						<X className="w-4 h-4" />
					</button>
				)
			}
		</nav>
		<h2
			class="mt-1.5 text-lg font-bold leading-tight tracking-tight text-foreground line-clamp-2 break-words"
		>
			{title}
		</h2>
		{
			description && (
				<p class="mt-1.5 text-xs leading-relaxed text-muted-foreground line-clamp-2">
					{description}
				</p>
			)
		}

		<div class="mt-4 flex flex-wrap items-center gap-1.5">
			<a
				href={githubUrl}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				class={chipClass}
			>
				<Github className="w-3.5 h-3.5" />
				Source
				{
					!!currentProject?.stars && (
						<span class="ml-0.5 inline-flex items-center gap-0.5 border-l border-border/60 pl-1.5 tabular-nums">
							<Star className="w-3 h-3" />
							{currentProject.stars}
						</span>
					)
				}
			</a>
			{
				currentProject?.live_website_url && (
					<a
						href={currentProject.live_website_url}
						target="_blank"
						rel="noopener noreferrer"
						data-haptic-external
						class={chipClass}
					>
						<ArrowUpRight className="w-3.5 h-3.5 text-primary" />
						Live site
					</a>
				)
			}
		</div>
	</div>

	<nav class="flex-1 overflow-y-auto p-3" aria-label="Documentation navigation">
		<SidebarTree items={sidebar} activePath={activePath} />
	</nav>

</div>
