---
interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;

// Filter to only include h2 and h3
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

if (filteredHeadings.length === 0) return null;
---

<nav class="toc hidden lg:block w-64 shrink-0 h-fit sticky top-24 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pr-2 pb-10">
  <div class="flex items-center gap-2 mb-4 px-2">
    <div class="w-1 h-4 bg-primary rounded-full"></div>
    <h3 class="font-semibold text-sm tracking-tight text-foreground/80 uppercase">On This Page</h3>
  </div>
  
  <ul class="space-y-1 text-sm">
    {filteredHeadings.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class:list={[
            "block py-1.5 transition-colors hover:text-primary leading-snug",
            heading.depth === 2 
              ? "text-muted-foreground font-medium" 
              : "text-muted-foreground/70 pl-4 border-l border-border/50 ml-1"
          ]}
          data-toc-link
          data-toc-target={heading.slug}
          data-toc-depth={heading.depth}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  let cleanupToc: (() => void) | null = null;

  function getScrollContainer(element: HTMLElement): HTMLElement | Window {
    let parent = element.parentElement;

    while (parent) {
      const style = window.getComputedStyle(parent);
      const overflowY = style.overflowY;
      const canScroll = overflowY === 'auto' || overflowY === 'scroll';
      if (canScroll && parent.scrollHeight > parent.clientHeight) {
        return parent;
      }
      parent = parent.parentElement;
    }

    return window;
  }

  function initActiveTocLink() {
    if (cleanupToc) cleanupToc();

    const toc = document.querySelector<HTMLElement>('.toc');
    if (!toc) return;

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (!links.length) return;

    const sections = links.reduce<{ id: string; section: HTMLElement }[]>((acc, link) => {
        const target = link.getAttribute('data-toc-target') || link.getAttribute('href')?.replace('#', '');
        if (!target) return acc;
        const section = document.getElementById(target);
        if (!section) return acc;
        acc.push({ id: target, section });
        return acc;
      }, []);

    if (!sections.length) return;

    const scrollContainer = getScrollContainer(toc);
    const containerTop =
      scrollContainer === window
        ? 0
        : (scrollContainer as HTMLElement).getBoundingClientRect().top;

    const setActive = (id: string) => {
      links.forEach((link) => {
        const isActive = link.getAttribute('data-toc-target') === id;
        link.classList.toggle('text-primary', isActive);
        link.classList.toggle('font-semibold', isActive);
      });
    };

    let rafId = 0;

    const updateActiveByScroll = () => {
      const offset = scrollContainer === window ? 140 : containerTop + 120;
      const firstSection = sections[0];
      if (!firstSection) return;
      let activeId = firstSection.id;

      for (const item of sections) {
        if (item.section.getBoundingClientRect().top <= offset) {
          activeId = item.id;
        } else {
          break;
        }
      }

      setActive(activeId);
    };

    const onScroll = () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(updateActiveByScroll);
    };

    const onLinkClick = (event: Event) => {
      const link = event.currentTarget as HTMLAnchorElement | null;
      const id = link?.getAttribute('data-toc-target');
      if (id) setActive(id);
    };

    links.forEach((link) => link.addEventListener('click', onLinkClick));
    if (scrollContainer === window) {
      window.addEventListener('scroll', onScroll, { passive: true });
    } else {
      (scrollContainer as HTMLElement).addEventListener('scroll', onScroll, {
        passive: true,
      });
    }
    window.addEventListener('resize', onScroll);

    setActive(sections[0].id);
    onScroll();

    cleanupToc = () => {
      if (rafId) cancelAnimationFrame(rafId);
      links.forEach((link) => link.removeEventListener('click', onLinkClick));
      if (scrollContainer === window) {
        window.removeEventListener('scroll', onScroll);
      } else {
        (scrollContainer as HTMLElement).removeEventListener('scroll', onScroll);
      }
      window.removeEventListener('resize', onScroll);
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initActiveTocLink, { once: true });
  } else {
    initActiveTocLink();
  }
  document.addEventListener('astro:page-load', initActiveTocLink);
</script>

<style>
  .toc::-webkit-scrollbar {
    width: 4px;
  }
  .toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 10px;
  }
  .toc:hover::-webkit-scrollbar-thumb {
    background: var(--muted-foreground);
    opacity: 0.3;
  }
</style>
