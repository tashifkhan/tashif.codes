---
import { leetCodeData } from "../data/leetcode";
import { Award, Medal } from "lucide-react";

const { badges } = leetCodeData;
---

<section
	class="rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm overflow-hidden h-fit"
>
	<div class="px-5 py-3.5 border-b border-border/60 flex items-center gap-2">
		<Medal className="w-3.5 h-3.5 text-muted-foreground" />
		<span
			class="text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground"
		>
			Achievement Badges
		</span>
		{
			badges.length > 0 && (
				<span class="ml-auto font-mono text-[10px] text-muted-foreground bg-muted/50 border border-border/40 px-2 py-0.5 rounded-full tabular-nums">
					{badges.length}
				</span>
			)
		}
	</div>
	{
		badges.length > 0 ? (
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-border/40">
				{badges.slice(0, 6).map((badge) => (
					<div class="flex items-center gap-3 bg-card px-4 py-3.5 hover:bg-muted/30 transition-colors">
						<div class="h-9 w-9 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0">
							<Award className="w-4 h-4 text-amber-500" />
						</div>
						<div class="flex-1 min-w-0">
							<p class="text-[13px] font-medium text-foreground truncate">
								{badge.displayName}
							</p>
							<p class="mt-0.5 font-mono text-[11px] text-muted-foreground truncate">
								{new Date(badge.createdDate).toLocaleDateString()}
							</p>
						</div>
					</div>
				))}
			</div>
		) : (
			<div class="flex flex-col items-center justify-center py-12 text-muted-foreground">
				<Award className="w-6 h-6 mb-3 opacity-30" />
				<p class="text-sm">No badges earned yet</p>
			</div>
		)
	}
</section>
