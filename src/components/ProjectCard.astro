---
import { Github, ExternalLink, Pin, FileText, BarChart3, Star, Tag } from "lucide-react";
// Tag is used in the Releases footer button
import type { Project } from "../data/projects";
import {
	Card,
	CardContent,
	CardFooter,
	CardHeader,
	CardTitle,
	CardDescription,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface Props {
	project: Project;
	hasAnalytics?: boolean;
	analyticsSlug?: string;
}

const { project, hasAnalytics = false, analyticsSlug = "" } = Astro.props as Props;
const languagesToShow = project.languages.slice(0, 3);
const moreLanguages = Math.max(0, project.languages.length - 3);
const releaseCount = project.releases?.length ?? 0;
---

<div
	class="block h-full group focus-within:ring-2 focus-within:ring-primary rounded-xl relative"
	data-project-card
	data-pinned={project.pinned ? "true" : "false"}
	data-has-releases={releaseCount > 0 ? "true" : "false"}
>
	<Card
		className={cn(
			"h-full relative flex flex-col overflow-hidden transition-all duration-300 max-w-full",
			"bg-card/40 hover:bg-card/80 backdrop-blur-xl border-border/40 hover:border-border/80 shadow-sm hover:shadow-md hover:-translate-y-1",
			project.pinned && "border-primary/20 hover:border-primary/40 dark:bg-primary/[0.02]"
		)}
	>
		<CardHeader className="p-5 pb-3">
			<div class="flex items-start justify-between gap-3">
				<CardTitle
					className="text-lg font-semibold tracking-tight group-hover:text-primary transition-colors relative z-0 flex-1"
					data-project-title
				>
					<a 
						href={`/projects/${project.slug}`} 
						class="after:absolute after:inset-0 outline-none"
						data-haptic-nav
					>
						{project.title}
					</a>
				</CardTitle>
				<div class="relative z-10 flex shrink-0 items-center gap-2 mt-0.5">
					{
						project.stars !== undefined && project.stars > 0 && (
							<div class="flex items-center gap-1 bg-amber-500/10 text-amber-500 hover:bg-amber-500/20 transition-colors px-1.5 py-0.5 rounded border border-amber-500/20 text-[10px] font-medium" title="GitHub Stars">
								<Star className="w-3 h-3 fill-amber-500/40" />
								<span>{project.stars}</span>
							</div>
						)
					}
					{
						releaseCount > 0 && (
							<div class="flex items-center gap-1 bg-emerald-500/10 text-emerald-500 hover:bg-emerald-500/20 transition-colors px-1.5 py-0.5 rounded border border-emerald-500/20 text-[10px] font-medium" title={`${releaseCount} ${releaseCount === 1 ? 'Release' : 'Releases'}`}>
								<Tag className="w-3 h-3" />
								<span>{releaseCount}</span>
							</div>
						)
					}
					{
						project.pinned && (
							<div title="Pinned Project">
								<Pin className="w-3.5 h-3.5 text-primary rotate-45 opacity-80" />
							</div>
						)
					}
				</div>
			</div>
			<CardDescription
				className="line-clamp-2 text-sm leading-relaxed text-muted-foreground mt-1.5 relative z-10"
				data-project-description
			>
				{project.description}
			</CardDescription>

			<div class="flex flex-wrap gap-1.5 mt-4 relative z-10 pointer-events-none">
				{
					languagesToShow.map((lang) => (
						<Badge
							variant="secondary"
							className="text-[10px] font-medium px-2 py-0.5 bg-secondary/50 text-secondary-foreground hover:bg-secondary/70 transition-colors border-transparent"
							data-project-language
						>
							{lang}
						</Badge>
					))
				}
				{
					moreLanguages > 0 && (
						<Badge variant="secondary" className="text-[10px] font-medium px-2 py-0.5 bg-secondary/50 text-secondary-foreground hover:bg-secondary/70 transition-colors border-transparent">
							+{moreLanguages}
						</Badge>
					)
				}
			</div>
		</CardHeader>

		<CardContent className="p-0 flex-1 relative z-10 pointer-events-none">
			{/* Empty but allows Card to expand */}
		</CardContent>

		<CardFooter className="p-5 pt-0 mt-auto flex flex-wrap items-center gap-1.5 w-full relative z-20">
			{
				project.live_website_url && (
					<a
						href={project.live_website_url}
						target="_blank"
						rel="noopener noreferrer"
						data-haptic-external
						class={cn(buttonVariants({ variant: "default", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 shadow-sm")}
					>
						<ExternalLink className="w-3 h-3" />
						<span class="hidden sm:inline">Demo</span>
					</a>
				)
			}
			{
				project.docs_slug && (
					<a
						href={`/docs/${project.docs_slug}`}
						data-haptic-nav
						class={cn(buttonVariants({ variant: "secondary", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 bg-secondary/50 hover:bg-secondary/70 transition-colors")}
					>
						<FileText className="w-3 h-3" />
						<span class="hidden sm:inline">Docs</span>
					</a>
				)
			}
			<a
				href={project.github_link}
				target="_blank"
				rel="noopener noreferrer"
				data-haptic-external
				data-github-link
				data-url={project.github_link}
				class={cn(buttonVariants({ variant: "outline", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 bg-transparent border-border/40 hover:bg-muted/50 transition-colors")}
			>
				<Github className="w-3 h-3" />
				<span class="hidden sm:inline">Source</span>
			</a>
				{
				hasAnalytics && (
					<a
						href={`/projects/stats?project=${analyticsSlug}`}
						data-haptic-nav
						class={cn(buttonVariants({ variant: "outline", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 bg-transparent border-border/40 hover:bg-muted/50 transition-colors")}
					>
						<BarChart3 className="w-3 h-3" />
						<span class="hidden sm:inline">Stats</span>
					</a>
				)
			}
		</CardFooter>
	</Card>
</div>

