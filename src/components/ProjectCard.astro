---
import { Github, ExternalLink, Pin, FileText, ChartPie, Star, Tag, GitFork } from "lucide-react";
import type { Project } from "../data/projects";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { languageColor } from "../utils/languageColors";
import { formatTopic } from "../utils/formatTopic";

interface Props {
	project: Project;
	hasAnalytics?: boolean;
	analyticsSlug?: string;
}

const { project, hasAnalytics = false, analyticsSlug = "" } = Astro.props as Props;
const languagesToShow = project.languages.slice(0, 3);
const moreLanguages = Math.max(0, project.languages.length - 3);
const topics = project.topics ?? [];
const topicsToShow = topics.slice(0, 3);
const moreTopics = Math.max(0, topics.length - 3);
const releaseCount = project.releases?.length ?? 0;
// The dominant language tints the card's top edge — a quiet per-project identity
const accent = project.languages[0] ? languageColor(project.languages[0]) : null;
---

<div
	class="block h-full group focus-within:ring-2 focus-within:ring-primary rounded-2xl relative"
	data-project-card
	data-project-slug={project.slug}
	data-pinned={project.pinned ? "true" : "false"}
	data-has-releases={releaseCount > 0 ? "true" : "false"}
>
	<article
		class={cn(
			"h-full relative flex flex-col overflow-hidden rounded-2xl max-w-full",
			// dark surface is lifted a touch off the near-black page so cards read as objects
			"border border-border/70 bg-card dark:bg-[#101119] text-card-foreground",
			"dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.04)]",
			"transition-[transform,box-shadow,border-color] duration-300",
			"shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:shadow-lg hover:shadow-black/5 dark:hover:shadow-black/40",
			"hover:border-primary/40 hover:-translate-y-1"
		)}
	>
		{
			accent && (
				<span
					class="absolute inset-x-0 top-0 h-[3px] opacity-50 transition-opacity duration-300 group-hover:opacity-100"
					style={`background: linear-gradient(90deg, ${accent}, transparent 85%)`}
					aria-hidden="true"
				/>
			)
		}

		<!-- Content zone -->
		<div class="flex-1 p-5 pb-4 flex flex-col">
			<div class="flex items-start justify-between gap-3">
				<h3
					class="flex-1 font-sans text-[15px] sm:text-base font-semibold leading-snug tracking-tight text-foreground group-hover:text-primary transition-colors"
					data-project-title
				>
					<a
						href={`/projects/${project.slug}`}
						class="after:absolute after:inset-0 outline-none"
						data-haptic-nav
					>
						{project.title}
					</a>
				</h3>
				<!-- Repo signals: sit with the title so the card leads with its numbers -->
				<div class="relative z-10 flex shrink-0 items-center gap-1.5 pt-0.5 text-[11px] font-medium tabular-nums leading-none pointer-events-none">
					{
						project.stars !== undefined && (
							<span
								class="inline-flex items-center gap-1 rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-1 text-amber-500"
								title="GitHub stars"
								data-project-stars-wrap
								hidden={!(project.stars > 0)}
							>
								<Star className="w-3 h-3" />
								<span data-project-stars>{project.stars}</span>
							</span>
						)
					}
					{
						project.forks !== undefined && (
							<span
								class="inline-flex items-center gap-1 rounded-full border border-sky-500/30 bg-sky-500/10 px-2 py-1 text-sky-400"
								title="Forks"
								data-project-forks-wrap
								hidden={!(project.forks > 0)}
							>
								<GitFork className="w-3 h-3" />
								<span data-project-forks>{project.forks}</span>
							</span>
						)
					}
					{
						releaseCount > 0 && (
							<span
								class="inline-flex items-center gap-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 text-emerald-400"
								title={`${releaseCount} ${releaseCount === 1 ? "release" : "releases"}`}
							>
								<Tag className="w-3 h-3" />
								<span>{releaseCount}</span>
							</span>
						)
					}
					{
						project.pinned && (
							<span title="Pinned project" class="flex shrink-0 items-center pl-0.5">
								<Pin className="w-3.5 h-3.5 text-primary rotate-45 opacity-80" />
							</span>
						)
					}
				</div>
			</div>

			{
				project.isFork && project.parentRepo && (
					<a
						href={project.originalRepo?.url ?? `https://github.com/${project.parentRepo}`}
						target="_blank"
						rel="noopener noreferrer"
						class="relative z-10 mt-2 inline-flex w-fit items-center gap-1 text-[10px] font-medium text-muted-foreground/80 hover:text-foreground transition-colors"
						title={`Forked from ${project.parentRepo}`}
					>
						<GitFork className="w-3 h-3" />
						<span class="truncate max-w-[14rem]">forked from {project.parentRepo}</span>
					</a>
				)
			}

			<!-- Two lines reserved so every card's top block is the same height -->
			<p
				class="relative z-10 mt-2 text-[13px] leading-[1.55] text-muted-foreground line-clamp-3 min-h-[2.6em] pointer-events-none"
				data-project-description
			>
				{project.description}
			</p>

			{
				languagesToShow.length > 0 && (
					<div class="relative z-10 mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11.5px] font-medium leading-none text-foreground/80 pointer-events-none">
						{languagesToShow.map((lang) => (
							<span class="inline-flex items-center gap-1.5" data-project-language>
								<span
									class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-inset ring-black/10 dark:ring-white/10"
									style={`background-color: ${languageColor(lang)}`}
									aria-hidden="true"
								/>
								{lang}
							</span>
						))}
						{moreLanguages > 0 && (
							<span
								class="font-normal tabular-nums text-muted-foreground/70"
								title={project.languages.slice(3).join(", ")}
							>
								+{moreLanguages}
							</span>
						)}
					</div>
				)
			}

			{
				topicsToShow.length > 0 && (
					<div class="relative z-10 mt-3 -ml-2 flex flex-wrap items-center gap-1.5 pointer-events-none">
						{topicsToShow.map((topic) => (
							<span
								class="inline-flex max-w-[11rem] truncate rounded-full bg-muted px-2 py-[3px] text-[10px] font-medium leading-[1.4] text-muted-foreground/90 transition-colors group-hover:text-foreground/75"
								data-project-topic={topic}
								title={`GitHub topic: ${topic}`}
							>
								{formatTopic(topic)}
							</span>
						))}
						{moreTopics > 0 && (
							<span
								class="text-[10px] font-medium leading-[1.4] tabular-nums text-muted-foreground/60"
								title={topics.slice(3).map(formatTopic).join(", ")}
							>
								+{moreTopics}
							</span>
						)}
					</div>
				)
			}
		</div>

		<!-- Action tray -->
		<div
			class="mt-auto border-t border-border/60 bg-muted/60 dark:bg-white/[0.03] px-5 py-3"
		>
			<div class="relative z-20 flex flex-wrap items-center gap-1.5">
				{
					project.live_website_url && (
						<a
							href={project.live_website_url}
							target="_blank"
							rel="noopener noreferrer"
							data-haptic-external
							class={cn(buttonVariants({ variant: "default", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 shadow-sm")}
						>
							<ExternalLink className="w-3 h-3" />
							<span class="hidden sm:inline">Demo</span>
						</a>
					)
				}
				{
					project.docs_slug && (
						<a
							href={`/docs/${project.docs_slug}`}
							data-haptic-nav
							class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 text-muted-foreground hover:text-foreground hover:bg-background/80")}
						>
							<FileText className="w-3 h-3" />
							<span class="hidden sm:inline">Docs</span>
						</a>
					)
				}
				<a
					href={project.github_link}
					target="_blank"
					rel="noopener noreferrer"
					data-haptic-external
					data-github-link
					data-url={project.github_link}
					class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 text-muted-foreground hover:text-foreground hover:bg-background/80")}
				>
					<Github className="w-3 h-3" />
					<span class="hidden sm:inline">Source</span>
				</a>
				{
					hasAnalytics && (
						<a
							href={`/projects/stats?project=${analyticsSlug}`}
							data-haptic-nav
							class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "h-7 text-[10px] px-2 sm:px-2.5 gap-1.5 text-muted-foreground hover:text-foreground hover:bg-background/80")}
						>
							<ChartPie className="w-3 h-3" />
							<span class="hidden sm:inline">Stats</span>
						</a>
					)
				}
			</div>
		</div>
	</article>
</div>
