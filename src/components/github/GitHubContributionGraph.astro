---
import { Calendar } from "lucide-react";
import EmptyState from "../common/EmptyState.astro";
import { starLists } from "../../data/starLists";
import { githubUsernames, githubStatsApiBase, personalGithubUsername } from "../../data/profile";
import YearSelect from "../projects/YearSelect";

// Calculate date range (last 365 days from today)
const today = new Date();
const oneYearAgo = new Date(today);
oneYearAgo.setFullYear(today.getFullYear() - 1);

// Get available years for selector
const currentYear = today.getFullYear();
const availableYears = Array.from({length: 6}, (_, i) => currentYear - i);

// ── helpers ──────────────────────────────────────────────────────────────────
function localDateStr(d: Date): string {
	return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

// ── fetch: build a flat date→count map (avoids all week-merge issues) ─────────
let totalContributions = 0;
const countMap = new Map<string, number>();
let fetchOk = false;

try {
	const yearsToFetch = Array.from(new Set([
		oneYearAgo.getFullYear() - 1,
		oneYearAgo.getFullYear(),
		today.getFullYear(),
		today.getFullYear() + 1,
	]));

	await Promise.all(githubUsernames.map(async (username) => {
		try {
			const res = await fetch(`${githubStatsApiBase}/${username}/contributions`);
			if (!res.ok) return;
			const data = await res.json();
			for (const year of yearsToFetch) {
				const weeks = data.contributions?.[year]?.data?.user?.contributionsCollection?.contributionCalendar?.weeks;
				if (!weeks) continue;
				for (const week of weeks) {
					for (const day of (week.contributionDays ?? [])) {
						if (!day.date) continue;
						countMap.set(day.date, (countMap.get(day.date) ?? 0) + (day.contributionCount ?? 0));
					}
				}
			}
			fetchOk = true;
		} catch { /* individual username failure is non-fatal */ }
	}));
} catch (error) {
	console.error("Failed to fetch contribution data:", error);
}

// ── build canonical aligned grid ──────────────────────────────────────────────
// Start from the Sunday on-or-before oneYearAgo so every column is a full week
// and every row corresponds to the same day-of-week — no merging needed.
const rangeStart = localDateStr(oneYearAgo);
const rangeEnd   = localDateStr(today);

const gridStart = new Date(oneYearAgo.getFullYear(), oneYearAgo.getMonth(), oneYearAgo.getDate());
gridStart.setDate(gridStart.getDate() - gridStart.getDay()); // rewind to Sunday

type GridDay = { date: string; count: number; inRange: boolean };
const gridWeeks: GridDay[][] = [];
const cursor = new Date(gridStart);

while (localDateStr(cursor) <= rangeEnd) {
	const week: GridDay[] = [];
	for (let d = 0; d < 7; d++) {
		const ds = localDateStr(cursor);
		week.push({ date: ds, count: countMap.get(ds) ?? 0, inRange: ds >= rangeStart && ds <= rangeEnd });
		cursor.setDate(cursor.getDate() + 1);
	}
	gridWeeks.push(week);
}

// ── total & month labels ───────────────────────────────────────────────────────
totalContributions = Array.from(countMap.entries())
	.filter(([d]) => d >= rangeStart && d <= rangeEnd)
	.reduce((s, [, c]) => s + c, 0);

type MonthLabel = { month: string; index: number };
const monthLabelsList: MonthLabel[] = [];
let lastMonth = -1;
gridWeeks.forEach((week, i) => {
	// Use the first in-range day so leading out-of-range padding (e.g. Dec 28-30
	// before a Jan 1 range start) doesn't produce a phantom "Dec" label.
	const firstInRange = week.find(d => d.inRange);
	if (!firstInRange) return;
	const [y, m] = firstInRange.date.split('-').map(Number);
	const mo = m - 1;
	if (mo !== lastMonth && (i === 0 || i > 1)) {
		monthLabelsList.push({ month: new Date(y, mo, 1).toLocaleString('en-US', { month: 'short' }), index: i });
		lastMonth = mo;
	}
});

// Quantile-based intensity thresholds so the heatmap shows texture even in
// high-activity years (fixed cutoffs like ">9 = max" render a wall of solid
// orange when the daily average is already above them).
const inRangeCounts = Array.from(countMap.entries())
	.filter(([d]) => d >= rangeStart && d <= rangeEnd)
	.map(([, c]) => c)
	.filter((c) => c > 0)
	.sort((a, b) => a - b);
const quantile = (p: number) =>
	inRangeCounts.length
		? inRangeCounts[Math.min(inRangeCounts.length - 1, Math.floor(p * inRangeCounts.length))]
		: 0;
const thresholds = [quantile(0.25), quantile(0.5), quantile(0.75)];

function getContributionLevel(count: number): number {
	if (count === 0) return 0;
	if (count >= thresholds[2] && thresholds[2] > 0) return 4;
	if (count >= thresholds[1] && thresholds[1] > 0) return 3;
	if (count >= thresholds[0] && thresholds[0] > 0) return 2;
	return 1;
}

// Helper function to get color class based on contribution level
function getContributionColor(level: number): string {
	const colors = [
		"bg-muted/80 dark:bg-muted/40", // 0 contributions — visible enough to show grid
		"bg-primary/40 dark:bg-primary/40",
		"bg-primary/60 dark:bg-primary/60",
		"bg-primary/80 dark:bg-primary/80",
		"bg-primary dark:bg-primary",
	];
	return colors[level] || colors[0];
}

// Helper function to format date for tooltip
function formatDate(dateString: string): string {
	return new Date(dateString).toLocaleDateString('en-US', {
		weekday: 'long',
		year: 'numeric',
		month: 'long',
		day: 'numeric'
	});
}

// Helper function to format date range
function formatDateRange(): string {
	const fromDate = oneYearAgo.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	const toDate = today.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
	return `${fromDate} – ${toDate}`;
}

const starredLists = starLists || [];
---

<section
	class="rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm overflow-hidden"
	data-contribution-card
>
	<div class="px-4 sm:px-5 py-3.5 border-b border-border/60 flex flex-col gap-3 md:flex-row md:items-center">
		<div class="min-w-0">
			<h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-tight text-foreground">
				<Calendar className="w-4 h-4 text-muted-foreground shrink-0" aria-hidden="true" />
				Contribution activity
			</h3>
			<p
				data-contribution-range
				class="mt-1 text-xs text-muted-foreground tabular-nums"
			>
				{totalContributions.toLocaleString()} contributions · {formatDateRange()}
			</p>
		</div>

		<div class="flex flex-wrap items-center gap-2 md:ml-auto">
			<!-- Personal-only toggle (slotted from parent) -->
			<slot name="toggle" />
			<YearSelect client:visible availableYears={availableYears} defaultValue="last-year" />
		</div>
	</div>

	<div class="px-4 pb-4 pt-4 sm:p-5">
	{(fetchOk || gridWeeks.some(w => w.some(d => d.count > 0))) ? (
		<div class="relative" data-contribution-frame>
			<!-- Tooltip: hover on desktop, tap on touch. Lives outside the scroller so it is never clipped. -->
			<div
				id="contribution-tooltip"
				role="status"
				aria-live="polite"
				class="absolute z-50 whitespace-nowrap rounded-lg border border-border bg-popover px-2.5 py-1.5 text-[11px] leading-5 text-popover-foreground shadow-lg pointer-events-none opacity-0 transition-opacity duration-150"
			>
				<div id="tooltip-content"></div>
			</div>

			<div class="contribution-container" tabindex="0" aria-label="Contribution heatmap, scroll sideways for earlier months">
				<div class="contribution-grid-wrapper" style={`--weeks: ${gridWeeks.length}`}>
					<!-- Month labels: same column tracks as the weeks grid, so they can't drift -->
					<div
						class="cal-months text-[10px] sm:text-[11px] text-muted-foreground font-medium"
						id="month-labels-container"
					>
						{monthLabelsList.map((label) => (
							<span style={`grid-column: ${label.index + 1}`}>{label.month}</span>
						))}
					</div>

					<!-- Day labels (sparse, GitHub-style) -->
					<div
						class="day-labels text-[9px] sm:text-[10px] text-muted-foreground"
						aria-hidden="true"
					>
						<span style="grid-row: 2">Mon</span>
						<span style="grid-row: 4">Wed</span>
						<span style="grid-row: 6">Fri</span>
					</div>

					<!-- Contribution grid -->
					<div class="contribution-weeks" id="contribution-grid">
						{gridWeeks.map((week) => (
							<div class="contribution-week">
								{week.map((day) => {
									if (!day.inRange) return <div class="contribution-day is-empty" />;
									const level = getContributionLevel(day.count);
									const colorClass = getContributionColor(level);
									return (
										<div
											class={`contribution-day ${colorClass}`}
											data-date={day.date}
											data-count={day.count}
										></div>
									);
								})}
							</div>
						))}
					</div>
				</div>
			</div>

			<!-- Footer: swipe hint on phones, legend everywhere -->
			<div class="mt-3 flex items-center gap-3 text-[11px] text-muted-foreground">
				<span class="contribution-hint inline-flex items-center gap-1 md:hidden" data-contribution-hint>
					<span aria-hidden="true">←</span> Swipe for earlier months
				</span>
				<span class="hidden md:inline">Tap or hover a day for details</span>
				<div class="ml-auto flex items-center gap-1.5" aria-hidden="true">
					<span>Less</span>
					<div class="flex gap-[3px]">
						<div class="legend-cell bg-muted/80 dark:bg-muted/40"></div>
						<div class="legend-cell bg-primary/40"></div>
						<div class="legend-cell bg-primary/60"></div>
						<div class="legend-cell bg-primary/80"></div>
						<div class="legend-cell bg-primary"></div>
					</div>
					<span>More</span>
				</div>
			</div>
		</div>
	) : (
		<div class="py-8">
			<EmptyState
				command="git log --graph --all"
				title="unable to load contribution data"
			/>
		</div>
	)}
	</div>
</section>

<style is:global>
	/* Global (not Astro-scoped): the year selector re-renders cells via
	   innerHTML, and injected elements don't carry Astro's scope attribute. */
	/* Horizontal scroll only when the card is narrower than the minimum grid */
	.contribution-container {
		width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		border-radius: 6px;
	}

	.contribution-container::-webkit-scrollbar {
		display: none;
	}

	.contribution-container:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 4px;
	}

	/* Fade the edge that has more weeks behind it, so the scroll is visible. */
	.contribution-container[data-more-right] {
		mask-image: linear-gradient(to left, transparent, black 28px);
	}

	/*
	 * Single grid: day-label column + one 1fr column per week (--weeks).
	 * Month labels and week columns live in the same tracks, so they stay
	 * aligned at any width — the grid stretches to fill the card.
	 */
	.contribution-grid-wrapper {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		column-gap: 8px;
		row-gap: 6px;
		/* Phones scroll; ~10px cells stay readable without a 760px wall. */
		min-width: 660px;
	}

	@media (min-width: 768px) {
		.contribution-grid-wrapper {
			min-width: 760px;
		}
	}

	/* Phones scroll the weeks; pin the day names so rows stay labelled. */
	@media (max-width: 767px) {
		.day-labels {
			position: sticky;
			left: 0;
			z-index: 2;
			padding-right: 4px;
			/* Same mix as the card's bg-card/60 over the page. */
			background: color-mix(in oklab, var(--card) 60%, var(--background));
			box-shadow: 6px 0 8px -6px color-mix(in oklab, var(--foreground) 30%, transparent);
		}
	}

	.cal-months,
	.contribution-weeks {
		display: grid;
		grid-template-columns: repeat(var(--weeks, 53), 1fr);
		gap: 3px;
		grid-column: 2;
	}

	.cal-months span {
		min-width: 0;
		white-space: nowrap;
		overflow: visible;
		line-height: 1;
	}

	.day-labels {
		grid-row: 2;
		grid-column: 1;
		display: grid;
		grid-template-rows: repeat(7, 1fr);
		gap: 3px;
		align-items: center;
		line-height: 1;
	}

	.contribution-weeks {
		grid-row: 2;
	}

	.contribution-week {
		display: grid;
		grid-template-rows: repeat(7, 1fr);
		gap: 3px;
		min-width: 0;
	}

	/* Explicit radius: the Tailwind theme remaps rounded-sm to ~8px, which
	   turns 12px cells into circles. */
	.contribution-day {
		position: relative;
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 2px;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.contribution-day.is-empty {
		pointer-events: none;
		background: transparent;
	}

	.contribution-day:not(.is-empty) {
		cursor: pointer;
	}

	.contribution-day[data-active] {
		box-shadow: 0 0 0 1.5px var(--foreground);
		z-index: 10;
	}

	@media (hover: hover) and (pointer: fine) {
		.contribution-day:not(.is-empty):hover {
			transform: scale(1.3);
			box-shadow: 0 0 0 1.5px var(--primary);
			z-index: 10;
		}
	}

	.legend-cell {
		width: 10px;
		height: 10px;
		border-radius: 2px;
	}
</style>

<script>
	// Year selector + personal-only filter for contribution graph
	import { trigger } from "@/lib/haptics";
	import { githubUsernames, personalGithubUsername } from '../../data/profile';
	// Same-origin proxy avoids browser CORS issues (see vercel.json / vite proxy)
	const githubStatsApiBase = '/proxy/gh-stats';
	const PERSONAL_ONLY_EVENT = 'github-personal-only-change';

	document.addEventListener('astro:page-load', function() {
		const yearSelector = document.getElementById('year-selector') as HTMLSelectElement;
		const contributionGrid = document.getElementById('contribution-grid');
		const tooltip = document.getElementById('contribution-tooltip');
		const tooltipContent = document.getElementById('tooltip-content');

		initializeTooltip();

		if (!yearSelector || !contributionGrid) return;

		let personalOnly =
			typeof localStorage !== 'undefined' &&
			localStorage.getItem('github_personal_only') === '1';

		function activeUsernames(): string[] {
			return personalOnly ? [personalGithubUsername] : [...githubUsernames];
		}

		function initializeTooltip() {
			const frame = document.querySelector<HTMLElement>('[data-contribution-frame]');
			const container = frame?.querySelector<HTMLElement>('.contribution-container');
			if (!frame || !container || !tooltip || !tooltipContent || frame.dataset.tooltipWired) return;
			frame.dataset.tooltipWired = 'true';
			const tip: HTMLElement = tooltip;
			const tipBody: HTMLElement = tooltipContent;

			let active: HTMLElement | null = null;

			const dayFrom = (target: EventTarget | null) =>
				target instanceof Element
					? target.closest<HTMLElement>('.contribution-day[data-date]')
					: null;

			const hide = () => {
				tip.style.opacity = '0';
				active?.removeAttribute('data-active');
				active = null;
			};

			const show = (day: HTMLElement) => {
				const date = day.dataset.date;
				const count = day.dataset.count;
				if (!date || count == null) return;
				active?.removeAttribute('data-active');
				active = day;
				day.setAttribute('data-active', '');
				const noun = count === '1' ? 'contribution' : 'contributions';
				tipBody.innerHTML = `<div class="font-semibold">${count} ${noun}</div><div class="text-muted-foreground">${formatDate(date)}</div>`;
				tip.style.opacity = '1';
				position(day);
			};

			// Position against the frame (not the scroller) and keep it inside the card.
			const position = (day: HTMLElement) => {
				const frameRect = frame.getBoundingClientRect();
				const cell = day.getBoundingClientRect();
				const row = Array.from(day.parentElement?.children ?? []).indexOf(day);
				const below = row <= 2;
				const center = cell.left - frameRect.left + cell.width / 2;
				tip.style.top = below
					? `${cell.bottom - frameRect.top + 8}px`
					: `${cell.top - frameRect.top - 8}px`;
				tip.style.transform = below ? 'translate(-50%, 0)' : 'translate(-50%, -100%)';
				tip.style.left = `${center}px`;
				const half = tip.getBoundingClientRect().width / 2;
				const min = half + 4;
				const max = Math.max(min, frameRect.width - half - 4);
				tip.style.left = `${Math.min(Math.max(center, min), max)}px`;
			};

			// Mouse: hover. Touch and pen: tap to show, tap again or elsewhere to hide.
			frame.addEventListener('pointerover', (event) => {
				if (event.pointerType !== 'mouse') return;
				const day = dayFrom(event.target);
				if (day) show(day);
			});
			container.addEventListener('pointerleave', (event) => {
				if (event.pointerType === 'mouse') hide();
			});
			frame.addEventListener('click', (event) => {
				const day = dayFrom(event.target);
				if (!day) return;
				if (day === active && (event as PointerEvent).pointerType !== 'mouse') {
					hide();
					return;
				}
				show(day);
				trigger('selection');
			});
			document.addEventListener('pointerdown', (event) => {
				if (active && !dayFrom(event.target)) hide();
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') hide();
			});
			container.addEventListener('scroll', () => {
				hide();
				syncEdges();
			}, { passive: true });
			// The section is display:none on other tabs. Jump to the newest
			// weeks the first time it gets a width, then only refresh the fades.
			let lastWidth = 0;
			new ResizeObserver(() => {
				const width = container.clientWidth;
				if (lastWidth === 0 && width > 0) scrollToLatest();
				else syncEdges();
				lastWidth = width;
			}).observe(container);
		}

		// Mark which edges have more weeks behind them (drives the fade mask).
		function syncEdges() {
			const container = document.querySelector<HTMLElement>('.contribution-container');
			if (!container) return;
			const max = container.scrollWidth - container.clientWidth;
			container.toggleAttribute('data-more-left', container.scrollLeft > 2);
			container.toggleAttribute('data-more-right', max - container.scrollLeft > 2);
			document
				.querySelector<HTMLElement>('[data-contribution-hint]')
				?.toggleAttribute('hidden', max <= 2);
		}

		// The newest weeks are the interesting ones; start the scroller there.
		function scrollToLatest() {
			const container = document.querySelector<HTMLElement>('.contribution-container');
			if (!container) return;
			container.scrollLeft = container.scrollWidth;
			syncEdges();
		}

		async function loadContributions() {
			if (!contributionGrid) return;
			const selectedValue = yearSelector.value;

			contributionGrid.innerHTML = '<div class="flex items-center justify-center h-28 text-muted-foreground dark:text-muted-foreground" style="grid-column: 1 / -1">Loading...</div>';

			try {
				let fromDate: Date, toDate: Date;

				if (selectedValue === 'last-year') {
					toDate = new Date();
					fromDate = new Date(toDate);
					fromDate.setFullYear(toDate.getFullYear() - 1);
				} else {
					const year = parseInt(selectedValue);
					fromDate = new Date(year, 0, 1);
					toDate = new Date(year, 11, 31);
				}

				const countMap = new Map<string, number>();
				const y = fromDate.getFullYear();
				const yearsToFetch = Array.from(new Set([y - 1, y, toDate.getFullYear(), toDate.getFullYear() + 1]));

				await Promise.all(activeUsernames().map(async (username) => {
					try {
						const res = await fetch(`${githubStatsApiBase}/${username}/contributions`);
						if (!res.ok) return;
						const data = await res.json();
						for (const year of yearsToFetch) {
							const weeks = data.contributions?.[year]?.data?.user?.contributionsCollection?.contributionCalendar?.weeks;
							if (!weeks) continue;
							for (const week of weeks) {
								for (const day of (week.contributionDays ?? [])) {
									if (day.date) countMap.set(day.date, (countMap.get(day.date) ?? 0) + (day.contributionCount ?? 0));
								}
							}
						}
					} catch {}
				}));

				function toDS(d: Date) {
					return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
				}
				const rangeStart = toDS(fromDate), rangeEnd = toDS(toDate);
				const gridStart = new Date(fromDate.getFullYear(), fromDate.getMonth(), fromDate.getDate());
				gridStart.setDate(gridStart.getDate() - gridStart.getDay());
				const gridWeeks: { date: string; count: number; inRange: boolean }[][] = [];
				const cur = new Date(gridStart);
				while (toDS(cur) <= rangeEnd) {
					const week: { date: string; count: number; inRange: boolean }[] = [];
					for (let d = 0; d < 7; d++) {
						const ds = toDS(cur);
						week.push({ date: ds, count: countMap.get(ds) ?? 0, inRange: ds >= rangeStart && ds <= rangeEnd });
						cur.setDate(cur.getDate() + 1);
					}
					gridWeeks.push(week);
				}

				updateThresholds(countMap, rangeStart, rangeEnd);
				updateContributionGrid(gridWeeks);
				updateMonthLabels(gridWeeks);
				updateHeaderInfo(countMap, rangeStart, rangeEnd, fromDate, toDate);

				scrollToLatest();

			} catch (error) {
				console.error('Error fetching contribution data:', error);
				contributionGrid.innerHTML = '<div class="flex items-center justify-center h-28 text-muted-foreground dark:text-muted-foreground" style="grid-column: 1 / -1">Error loading data</div>';
			}
		}

		yearSelector.addEventListener('change', loadContributions);

		document.addEventListener(PERSONAL_ONLY_EVENT, ((e: CustomEvent<{ personalOnly: boolean }>) => {
			personalOnly = e.detail.personalOnly;
			loadContributions();
		}) as EventListener);

		// Re-load when DataFreshness refreshes GitHub stats
		document.addEventListener("github-stats-refreshed", () => {
			loadContributions();
		});

		// If preference was already personal-only, refresh graph to match
		if (personalOnly) {
			loadContributions();
		}

		// Quantile-based thresholds, mirroring the SSR logic
		let thresholds = [0, 0, 0];

		function updateThresholds(countMap: Map<string, number>, rangeStart: string, rangeEnd: string) {
			const counts = Array.from(countMap.entries())
				.filter(([d]) => d >= rangeStart && d <= rangeEnd)
				.map(([, c]) => c)
				.filter((c) => c > 0)
				.sort((a, b) => a - b);
			const q = (p: number) =>
				counts.length ? counts[Math.min(counts.length - 1, Math.floor(p * counts.length))] : 0;
			thresholds = [q(0.25), q(0.5), q(0.75)];
		}

		function getContributionLevel(count: number): number {
			if (count === 0) return 0;
			if (count >= thresholds[2] && thresholds[2] > 0) return 4;
			if (count >= thresholds[1] && thresholds[1] > 0) return 3;
			if (count >= thresholds[0] && thresholds[0] > 0) return 2;
			return 1;
		}

		function getContributionColor(level: number): string {
			const colors = [
				"bg-muted/80 dark:bg-muted/40",
				"bg-primary/40 dark:bg-primary/40",
				"bg-primary/60 dark:bg-primary/60",
				"bg-primary/80 dark:bg-primary/80",
				"bg-primary dark:bg-primary",
			];
			return colors[level] || colors[0];
		}

		function formatDate(dateString: string): string {
			return new Date(dateString).toLocaleDateString('en-US', {
				weekday: 'short',
				year: 'numeric',
				month: 'short',
				day: 'numeric'
			});
		}

		function updateMonthLabels(gridWeeks: { date: string; count: number; inRange: boolean }[][]) {
			const container = document.getElementById('month-labels-container');
			if (!container) return;
			let lastMonth = -1;
			const labels: { month: string; index: number }[] = [];
			gridWeeks.forEach((week, i) => {
				const firstInRange = week.find(d => d.inRange);
				if (!firstInRange) return;
				const [y, m] = firstInRange.date.split('-').map(Number);
				const mo = m - 1;
				if (mo !== lastMonth && (i === 0 || i > 1)) {
					labels.push({ month: new Date(y, mo, 1).toLocaleString('en-US', { month: 'short' }), index: i });
					lastMonth = mo;
				}
			});
			container.innerHTML = labels.map(l =>
				`<span style="grid-column: ${l.index + 1}">${l.month}</span>`
			).join('');
		}

		function updateContributionGrid(gridWeeks: { date: string; count: number; inRange: boolean }[][]) {
			const grid = document.getElementById('contribution-grid');
			if (!grid) return;
			document.querySelector<HTMLElement>('.contribution-grid-wrapper')
				?.style.setProperty('--weeks', String(gridWeeks.length));
			grid.innerHTML = gridWeeks.map(week => `
				<div class="contribution-week">
					${week.map(day => {
						if (!day.inRange) return '<div class="contribution-day is-empty"></div>';
						const level = getContributionLevel(day.count);
						const colorClass = getContributionColor(level);
						return `<div class="contribution-day ${colorClass}" data-date="${day.date}" data-count="${day.count}"></div>`;
					}).join('')}
				</div>
			`).join('');
		}

		function updateHeaderInfo(countMap: Map<string, number>, rangeStart: string, rangeEnd: string, fromDate: Date, toDate: Date) {
			const total = Array.from(countMap.entries())
				.filter(([d]) => d >= rangeStart && d <= rangeEnd)
				.reduce((s, [, c]) => s + c, 0);
			const dateRange = `${fromDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} – ${toDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}`;
			const headerInfo = document.querySelector('[data-contribution-range]');
			if (headerInfo) headerInfo.textContent = `${total.toLocaleString()} contributions · ${dateRange}`;
		}
	});
</script>

<script>
// Star list buttons -> switch to Projects tab & apply list filter
import { trigger } from "@/lib/haptics";

document.addEventListener('astro:page-load', () => {
	const buttons = document.querySelectorAll('[data-star-list-select]');
	buttons.forEach(btn => {
		btn.addEventListener('click', () => {
			trigger('selection');
			const name = (btn as HTMLElement).getAttribute('data-star-list-select');
			if (!name) return;
			localStorage.setItem('pending_star_list_select', name);
			document.dispatchEvent(new CustomEvent('open-star-list', { detail: { name } }));
		});
	});
});
</script>
