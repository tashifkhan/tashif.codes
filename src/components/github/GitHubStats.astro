---
import { githubStats, githubStatsPersonal } from "../../data/github";
import GitHubContributionGraph from "./GitHubContributionGraph.astro";
import PersonalOnlyToggle from "./PersonalOnlyToggle";
import {
	GitCommit,
	Star,
	GitPullRequest,
	Users,
	TrendingUp,
	Calendar,
	Code2,
} from "lucide-react";

const all = githubStats;
const personal = githubStatsPersonal;

function metricCardsFor(source: typeof all) {
	return [
		{
			key: "commits",
			label: "Commits",
			value: source.stats.totalCommits.toLocaleString(),
			sub: "lifetime",
			icon: GitCommit,
		},
		{
			key: "streak",
			label: "Streak",
			value: source.stats.currentStreak.toString(),
			sub: "current",
			icon: TrendingUp,
		},
		{
			key: "longest",
			label: "Longest",
			value: source.stats.longestStreak.toString(),
			sub: "streak",
			icon: Calendar,
		},
		{
			key: "stars",
			label: "Stars",
			value: source.stars.total_stars.toLocaleString(),
			sub: "total",
			icon: Star,
		},
		{
			key: "prs",
			label: "PRs",
			value: source.prs.length.toString(),
			sub: "opened",
			icon: GitPullRequest,
		},
		{
			key: "views",
			label: "Views",
			value: source.stats.profile_visitors.toLocaleString(),
			sub: "profile",
			icon: Users,
		},
	];
}

const metricCardsAll = metricCardsFor(all);
const metricCardsPersonal = metricCardsFor(personal);

const topLanguagesAll = all.stats.topLanguages.slice(0, 6).map((lang) => ({
	...lang,
	color: lang.color || "var(--color-primary)",
	pct: Math.max(0, Math.min(100, Number(lang.percentage) || 0)),
}));
const topLanguagesPersonal = personal.stats.topLanguages.slice(0, 6).map((lang) => ({
	...lang,
	color: lang.color || "var(--color-primary)",
	pct: Math.max(0, Math.min(100, Number(lang.percentage) || 0)),
}));

function pctLabel(pct: number): string {
	if (pct > 0 && pct < 1) return "<1%";
	return `${Math.round(pct)}%`;
}

function formatDay(iso: string): string {
	return new Date(iso).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
	});
}

function prStateText(state: string): string {
	switch (state.toLowerCase()) {
		case "open":
			return "text-emerald-600 dark:text-emerald-400";
		case "merged":
			return "text-purple-600 dark:text-purple-400";
		case "closed":
			return "text-rose-600 dark:text-rose-400";
		default:
			return "";
	}
}

function prStateColor(state: string): string {
	switch (state.toLowerCase()) {
		case "open":
			return "bg-emerald-500";
		case "merged":
			return "bg-purple-500";
		case "closed":
			return "bg-rose-500";
		default:
			return "bg-muted-foreground/50";
	}
}

const languagePanes = [
	{ attr: "data-github-languages-all", langs: topLanguagesAll, note: "authored code only", hidden: false },
	{ attr: "data-github-languages-personal", langs: topLanguagesPersonal, note: "personal account only", hidden: true },
];

type ActivityItem = {
	url: string;
	title: string;
	repo: string;
	date: string;
	dot: string;
	state?: string;
	stateClass?: string;
};

// Commit messages carry the full body; the row only needs the subject line.
const commitItems = (source: typeof all): ActivityItem[] =>
	source.commits.slice(0, 5).map((commit) => ({
		url: commit.url,
		title: commit.message.split("\n")[0].trim(),
		repo: commit.repo,
		date: commit.timestamp,
		dot: "bg-primary/60 group-hover:bg-primary",
	}));

const prItems = (source: typeof all): ActivityItem[] =>
	source.prs.slice(0, 5).map((pr) => ({
		url: pr.url,
		title: pr.title,
		repo: pr.repo,
		date: pr.created_at,
		dot: prStateColor(pr.state),
		state: pr.state.charAt(0).toUpperCase() + pr.state.slice(1).toLowerCase(),
		stateClass: prStateText(pr.state),
	}));

const activityPanels = [
	{
		title: "Recent commits",
		icon: GitCommit,
		lists: [
			{ attr: "data-github-commits-all", items: commitItems(all), hidden: false },
			{ attr: "data-github-commits-personal", items: commitItems(personal), hidden: true },
		],
	},
	{
		title: "Recent pull requests",
		icon: GitPullRequest,
		lists: [
			{ attr: "data-github-prs-all", items: prItems(all), hidden: false },
			{ attr: "data-github-prs-personal", items: prItems(personal), hidden: true },
		],
	},
];

function getLanguageIcon(languageName: string): string {
	const iconMap: { [key: string]: string } = {
		JavaScript: "javascript",
		TypeScript: "typescript",
		Python: "python",
		Java: "openjdk",
		"C++": "cplusplus",
		"C#": "csharp",
		C: "c",
		PHP: "php",
		Ruby: "ruby",
		Go: "go",
		Rust: "rust",
		Swift: "swift",
		Kotlin: "kotlin",
		Dart: "dart",
		HTML: "html5",
		CSS: "css3",
		SCSS: "sass",
		Vue: "vuedotjs",
		React: "react",
		Angular: "angular",
		"Node.js": "nodedotjs",
		Express: "express",
		"Next.js": "nextdotjs",
		"Nuxt.js": "nuxtdotjs",
		Svelte: "svelte",
		Flutter: "flutter",
		"React Native": "react",
		Ionic: "ionic",
		Electron: "electron",
		MongoDB: "mongodb",
		PostgreSQL: "postgresql",
		MySQL: "mysql",
		Redis: "redis",
		Docker: "docker",
		Kubernetes: "kubernetes",
		AWS: "amazonaws",
		GCP: "googlecloud",
		Azure: "microsoftazure",
		Firebase: "firebase",
		Vercel: "vercel",
		Netlify: "netlify",
		Shell: "gnubash",
		PowerShell: "powershell",
		"Vim script": "vim",
		Lua: "lua",
		R: "r",
		MATLAB: "matlab",
		"Objective-C": "objectivec",
		Scala: "scala",
		Haskell: "haskell",
		Clojure: "clojure",
		Elixir: "elixir",
		Erlang: "erlang",
		"F#": "fsharp",
		Assembly: "assemblyscript",
		WebAssembly: "webassembly",
		Solidity: "solidity",
		YAML: "yaml",
		JSON: "json",
		XML: "xml",
		Markdown: "markdown",
		LaTeX: "latex",
		"Jupyter Notebook": "jupyter",
		Notebook: "jupyter",
		IPython: "jupyter",
		Astro: "astro",
	};

	const iconName =
		iconMap[languageName] ||
		languageName.toLowerCase().replace(/[^a-z0-9]/g, "");
	return `https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/${iconName}.svg`;
}

function getFallbackIcon(): string {
	return `data:image/svg+xml,${encodeURIComponent(`
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
			<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
		</svg>
	`)}`;
}
---

<div class="space-y-6 sm:space-y-8" data-github-stats-root>
	<!-- Metrics: three across on phones (two rows), six across on desktop -->
	<div class="grid grid-cols-3 lg:grid-cols-6 gap-2 sm:gap-4">
		{
			metricCardsAll.map((card, i) => (
				<div
					class="relative min-w-0 overflow-hidden rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm px-3 py-3 sm:p-4 hover:border-primary/30 transition-colors"
					data-github-metric
					data-metric={card.key}
					data-value-all={card.value}
					data-value-personal={metricCardsPersonal[i].value}
				>
					<p class="flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
						<card.icon className="w-3.5 h-3.5 shrink-0 text-primary/80" aria-hidden="true" />
						<span class="truncate">{card.label}</span>
					</p>
					<p
						class="mt-2 font-mono text-lg sm:text-2xl font-bold text-foreground tabular-nums leading-none tracking-tight"
						data-github-metric-value
					>
						{card.value}
					</p>
					<p class="mt-1.5 truncate text-[11px] sm:text-xs text-muted-foreground">{card.sub}</p>
				</div>
			))
		}
	</div>

	<!-- GitHub Contribution Graph (includes personal-only toggle) -->
	<GitHubContributionGraph>
		<PersonalOnlyToggle client:visible slot="toggle" />
	</GitHubContributionGraph>

	<!-- Optional content placed directly below the contribution graph (e.g. Star Lists) -->
	<slot name="after-graph" />

	<!-- Top Languages: one pane per source, swapped by the toggle -->
	{
		languagePanes.map((pane) => (
			<section
				class:list={[
					"rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm overflow-hidden",
					pane.hidden && "hidden",
				]}
				{...{ [pane.attr]: "" }}
			>
				<div class="px-4 sm:px-5 py-3 border-b border-border/60 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
					<h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-tight text-foreground">
						<Code2 className="w-4 h-4 text-muted-foreground" aria-hidden="true" />
						Top languages
					</h3>
					<span class="text-xs text-muted-foreground">{pane.note}</span>
				</div>
				<div class="p-4 sm:p-5">
					<div
						class="flex h-2 w-full rounded-full overflow-hidden bg-secondary mb-5"
						role="img"
						aria-label={`Language distribution: ${pane.langs.map((l) => `${l.name} ${pctLabel(l.pct)}`).join(", ")}`}
					>
						{pane.langs.map((lang) => (
							<div
								class="h-full first:rounded-l-full last:rounded-r-full"
								style={`width:${lang.pct}%; background-color:${lang.color};`}
							/>
						))}
					</div>

					<ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-3.5">
						{pane.langs.map((lang) => (
							<li class="flex items-center gap-3 min-w-0">
								<div class="relative flex items-center justify-center w-8 h-8 rounded-lg bg-background/60 border border-border/40 overflow-hidden shrink-0">
									<img
										src={getLanguageIcon(lang.name)}
										alt=""
										loading="lazy"
										class="w-4.5 h-4.5 object-contain language-icon"
										data-fallback={getFallbackIcon()}
									/>
								</div>
								<div class="flex-1 min-w-0">
									<div class="flex items-baseline justify-between gap-2">
										<p class="text-sm font-medium text-foreground truncate">{lang.name}</p>
										<span class="font-mono text-xs font-semibold tabular-nums text-muted-foreground shrink-0">
											{pctLabel(lang.pct)}
										</span>
									</div>
									<div class="mt-1.5 h-1 w-full bg-secondary rounded-full overflow-hidden">
										<div
											class="h-full rounded-full"
											style={`background-color:${lang.color}; width:${Math.max(lang.pct, 1)}%;`}
										/>
									</div>
								</div>
							</li>
						))}
					</ul>
				</div>
			</section>
		))
	}

	<!-- Recent activity: titles wrap to two lines, metadata wraps instead of clipping -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
		{
			activityPanels.map((panel) => (
				<section class="rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm overflow-hidden">
					<div class="px-4 sm:px-5 py-3 border-b border-border/60">
						<h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-tight text-foreground">
							<panel.icon className="w-4 h-4 text-muted-foreground" aria-hidden="true" />
							{panel.title}
						</h3>
					</div>
					{panel.lists.map((list) => (
						<ul class:list={["divide-y divide-border/40", list.hidden && "hidden"]} {...{ [list.attr]: "" }}>
							{list.items.length === 0 && (
								<li class="px-4 sm:px-5 py-4 text-sm text-muted-foreground">Nothing recent.</li>
							)}
							{list.items.map((item) => (
								<li>
									<a
										href={item.url}
										target="_blank"
										rel="noopener noreferrer"
										data-haptic-external
										class="group flex items-start gap-3 px-4 sm:px-5 py-3 hover:bg-muted/30 focus-visible:bg-muted/30 focus-visible:outline-none transition-colors"
									>
										<span class:list={["mt-[7px] h-2 w-2 rounded-full shrink-0", item.dot]} aria-hidden="true" />
										<div class="flex-1 min-w-0">
											<p class="line-clamp-2 break-words text-sm font-medium leading-snug text-foreground group-hover:text-primary transition-colors">
												{item.title}
											</p>
											<p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-muted-foreground">
												<span class="font-mono break-all">{item.repo}</span>
												{item.state && (
													<span class:list={["font-medium", item.stateClass]}>{item.state}</span>
												)}
												<time datetime={item.date}>{formatDay(item.date)}</time>
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					))}
				</section>
			))
		}
	</div>
</div>

<script>
	// Handle language icon loading and styling
	document.addEventListener("astro:page-load", function () {
		const languageIcons = document.querySelectorAll(".language-icon");

		languageIcons.forEach((icon) => {
			const img = icon as HTMLImageElement;

			function applyThemeStyle() {
				const isDark = document.documentElement.classList.contains("dark");

				if (img.src.startsWith("data:image/svg+xml")) {
					img.style.filter = "none";
					img.style.color = isDark ? "#9CA3AF" : "#6B7280";
					return;
				}

				if (isDark) {
					img.style.filter = "invert(1) brightness(0.9)";
				} else {
					img.style.filter = "brightness(0.7)";
				}
			}

			img.style.opacity = "0.9";
			img.style.transition = "all 0.3s ease";
			applyThemeStyle();

			img.addEventListener("load", function () {
				this.style.opacity = "1";
				applyThemeStyle();
			});

			img.addEventListener("error", function () {
				const fallbackUrl = this.dataset.fallback;
				if (fallbackUrl && this.src !== fallbackUrl) {
					this.src = fallbackUrl;
					applyThemeStyle();
				}
			});

			const observer = new MutationObserver(() => {
				applyThemeStyle();
			});

			observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["class"],
			});
		});
	});
</script>

<script>
	// Swap metric cards / languages / activity lists when personal-only toggles
	const EVENT = "github-personal-only-change";

	function applyPersonalOnly(personalOnly: boolean) {
		document.querySelectorAll("[data-github-metric]").forEach((el) => {
			const valueEl = el.querySelector("[data-github-metric-value]");
			if (!valueEl) return;
			const key = personalOnly ? "valuePersonal" : "valueAll";
			const val = (el as HTMLElement).dataset[key];
			if (val != null) valueEl.textContent = val;
		});

		const pairs: [string, string][] = [
			["[data-github-languages-all]", "[data-github-languages-personal]"],
			["[data-github-commits-all]", "[data-github-commits-personal]"],
			["[data-github-prs-all]", "[data-github-prs-personal]"],
		];

		for (const [allSel, personalSel] of pairs) {
			document.querySelectorAll(allSel).forEach((el) => {
				el.classList.toggle("hidden", personalOnly);
			});
			document.querySelectorAll(personalSel).forEach((el) => {
				el.classList.toggle("hidden", !personalOnly);
			});
		}

		// Section heading commit count on home page
		const headingCommits = document.querySelector("[data-github-heading-commits]");
		if (headingCommits) {
			const key = personalOnly ? "valuePersonal" : "valueAll";
			const val = (headingCommits as HTMLElement).dataset[key];
			if (val != null) headingCommits.textContent = val;
		}
	}

	document.addEventListener("astro:page-load", () => {
		const saved = localStorage.getItem("github_personal_only") === "1";
		applyPersonalOnly(saved);

		document.addEventListener(EVENT, ((e: CustomEvent<{ personalOnly: boolean }>) => {
			applyPersonalOnly(e.detail.personalOnly);
		}) as EventListener);
	});
</script>
