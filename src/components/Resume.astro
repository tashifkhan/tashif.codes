---
import { InteractiveResume } from "./InteractiveResume";
import { experiences } from "../data/experiences";
import {
	resumeProjects,
	education,
	positions,
	skillCategories,
} from "../data/resume";
---

<div class="resume-container w-full">
	<InteractiveResume
		client:load
		experiences={experiences}
		projects={resumeProjects}
		education={education}
		positions={positions}
		skillCategories={skillCategories}
	/>
</div>
