---
/**
 * The README view of a project: the rendered README beside a rail of
 * releases, topics and languages. Used at /projects/<slug> for projects
 * without a landing, and at /projects/<slug>/readme for those with one.
 */
import { Tag, Download, ChevronRight } from "lucide-react";
import MarkdownRenderer from "../common/markdown/MarkdownRenderer.astro";
import EmptyState from "../common/EmptyState.astro";
import { languageColor } from "../../lib/languageColors";
import { formatTopic } from "../../lib/formatTopic";
import {
	formatBytes,
	formatReleaseDate as formatDate,
	releaseHref,
	releaseSummary,
} from "@/lib/releases";
import type { Project } from "@/types";

interface Props {
	project: Project;
}

const { project } = Astro.props;

// Readme is plain markdown. Graceful fallback: if the content looks like
// Base64 (all base64 chars, no markdown markers), decode it.
let readmeContent = project.readme || "";
if (readmeContent) {
	const trimmed = readmeContent.trim();
	const looksLikeBase64 =
		trimmed.length > 0 &&
		!trimmed.startsWith("#") &&
		!trimmed.startsWith("-") &&
		!trimmed.startsWith("*") &&
		!/\s/.test(trimmed.slice(0, 20)) &&
		/^[A-Za-z0-9+/\r\n]+=*$/.test(trimmed);
	if (looksLikeBase64) {
		try {
			readmeContent = Buffer.from(trimmed, "base64").toString("utf-8");
		} catch {
			// keep raw
		}
	}
}

const releases = project.releases ?? [];
const latestRelease = releases[0];
const latestSummary = latestRelease ? releaseSummary(latestRelease.body) : "";
---

<div
	class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-6 lg:gap-8 items-start"
>
	<!-- README -->
	<article
		id="project-readme"
		class="bg-card/80 backdrop-blur-xl p-4 sm:p-8 lg:p-10 rounded-2xl border border-border/50 shadow-lg min-w-0"
	>
		{
			readmeContent ? (
				<MarkdownRenderer
					content={readmeContent}
					githubBaseUrl={project.github_link}
				/>
			) : (
				<div class="py-16">
					<EmptyState
						command="cat README.md"
						title="no such file or directory"
						description="No documentation is available for this project yet. Check the GitHub repository for more details."
						ctaLabel="view on github"
						ctaHref={project.github_link}
						ctaExternal
					/>
				</div>
			)
		}
	</article>

	<!-- Metadata sidebar — sticks below the compact header, scrolls internally if tall -->
	<aside
		class="space-y-5 min-w-0 lg:sticky lg:top-[4.5rem] lg:max-h-[calc(100vh-5.5rem)] lg:overflow-y-auto"
		style="scrollbar-width: none;"
	>
		{
			latestRelease && (
				<section
					id="releases"
					class="scroll-mt-8 rounded-2xl border border-border/50 bg-card/80 backdrop-blur-xl p-5"
				>
					<div class="flex items-center justify-between mb-3.5">
						<h2 class="text-[10px] font-bold tracking-[0.18em] text-muted-foreground">
							Releases
						</h2>
						<span class="font-mono text-[10px] text-muted-foreground bg-muted/50 border border-border/40 px-2 py-0.5 rounded-full tabular-nums">
							{releases.length}
						</span>
					</div>

					<!-- Latest release: opens its own page, which this card morphs into -->
					<a
						href={releaseHref(project.slug, latestRelease.tag_name)}
						data-haptic-nav
						class="group/rel block -mx-2 px-2 py-2 rounded-xl hover:bg-muted/40 transition-colors"
					>
						<span class="flex items-center gap-2">
							<span
								class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-emerald-500 bg-emerald-500/10 border border-emerald-500/25 px-2 py-0.5 rounded-md shrink-0"
							>
								<Tag className="w-3 h-3" />
								{latestRelease.tag_name}
							</span>
							{latestRelease.prerelease && (
								<span class="text-[10px] font-semibold tracking-wide px-2 py-0.5 rounded-md bg-orange-500/15 text-orange-500 border border-orange-500/20 shrink-0">
									Pre-release
								</span>
							)}
							{latestRelease.published_at && (
								<span class="text-[11px] text-muted-foreground truncate">
									{formatDate(latestRelease.published_at)}
								</span>
							)}
							<ChevronRight className="ml-auto w-3.5 h-3.5 text-muted-foreground group-hover/rel:text-primary group-hover/rel:translate-x-0.5 transition-all shrink-0" />
						</span>
						{latestSummary && (
							<span class="mt-2 block text-[13px] leading-snug text-foreground/80 line-clamp-3">
								{latestSummary}
							</span>
						)}
						<span class="mt-1.5 block text-[11px] font-medium text-primary">
							Read release notes
						</span>
					</a>

					{latestRelease.assets.length > 0 && (
						<div class="space-y-2 mt-3">
							{latestRelease.assets.map((asset) => (
								<a
									href={asset.download_url}
									target="_blank"
									rel="noopener noreferrer"
									data-haptic-external
									class="group/asset flex items-center gap-2.5 px-3 py-2 rounded-xl border border-border/40 bg-background/50 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all duration-200"
								>
									<Download className="w-3.5 h-3.5 shrink-0 text-muted-foreground group-hover/asset:text-emerald-500 transition-colors" />
									<div class="flex-1 min-w-0">
										<p class="text-xs font-medium text-foreground truncate group-hover/asset:text-emerald-500 transition-colors">
											{asset.name}
										</p>
										<p class="text-[10px] text-muted-foreground">
											{formatBytes(asset.size)} ·{" "}
											{asset.download_count.toLocaleString()} downloads
										</p>
									</div>
								</a>
							))}
						</div>
					)}

					<!-- Older releases: a short git log, each row its own page -->
					{releases.length > 1 && (
						<ol class="relative mt-4 pt-3 border-t border-border/40">
							<span aria-hidden="true" class="absolute left-[5px] top-6 bottom-3 w-px bg-border/70" />
							{releases.slice(1).map((release) => (
								<li>
									<a
										href={releaseHref(project.slug, release.tag_name)}
										data-haptic-nav
										class="group/rel relative flex items-center gap-2.5 -mx-2 px-2 py-1.5 rounded-lg hover:bg-muted/40 transition-colors"
									>
										<span class="relative z-10 h-[7px] w-[7px] ml-[2px] rounded-full bg-emerald-500/60 ring-[3px] ring-card shrink-0 group-hover/rel:bg-emerald-500" />
										<span
											class="font-mono text-xs font-semibold text-muted-foreground group-hover/rel:text-foreground transition-colors"
										>
											{release.tag_name}
										</span>
										{release.prerelease && (
											<span class="text-[9px] font-semibold uppercase tracking-wide text-orange-500">pre</span>
										)}
										{release.draft && (
											<span class="text-[9px] font-semibold uppercase tracking-wide text-yellow-500">draft</span>
										)}
										{release.published_at && (
											<span class="ml-auto text-[10px] text-muted-foreground/80 tabular-nums">
												{formatDate(release.published_at)}
											</span>
										)}
									</a>
								</li>
							))}
						</ol>
					)}
				</section>
			)
		}

		{
			(project.topics?.length ?? 0) > 0 && (
				<section class="rounded-2xl border border-border/50 bg-card/80 backdrop-blur-xl p-5">
					<h2 class="text-[10px] font-bold tracking-[0.18em] text-muted-foreground mb-3.5">
						GitHub Topics
					</h2>
					<div class="flex flex-wrap gap-1.5">
						{project.topics!.map((topic: string) => (
							<a
								href={`https://github.com/topics/${encodeURIComponent(topic)}`}
								target="_blank"
								rel="noopener noreferrer"
								title={`#${topic} on GitHub`}
								class="inline-flex items-center rounded-full border border-border/60 bg-muted/40 px-2.5 py-1 text-[11px] font-medium leading-none text-muted-foreground transition-colors hover:border-primary/40 hover:bg-primary/10 hover:text-primary"
								data-haptic-external
							>
								{formatTopic(topic)}
							</a>
						))}
					</div>
				</section>
			)
		}


		{
			project.languages.length > 0 && (
				<section class="rounded-2xl border border-border/50 bg-card/80 backdrop-blur-xl p-5">
					<h2 class="text-[10px] font-bold tracking-[0.18em] text-muted-foreground mb-3.5">
						Built With
					</h2>
					<ul class="flex flex-col gap-2.5">
						{project.languages.map((lang: string) => (
							<li class="flex items-center gap-2.5 text-[13px] leading-none text-foreground/85">
								<span
									class="w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-inset ring-black/10 dark:ring-white/10"
									style={`background-color: ${languageColor(lang)}`}
									aria-hidden="true"
								/>
								{lang}
							</li>
						))}
					</ul>
				</section>
			)
		}
	</aside>
</div>
