---
/**
 * Frame shared by every page of one project: the landing or README at
 * /projects/<slug>, and the README at /projects/<slug>/readme when a landing
 * owns the first URL. The header, tabs and sticky bar are the same on both, so
 * a custom landing still reads as part of the site.
 */
import PageShell from "../../layouts/PageShell.astro";
import {
	Github,
	ExternalLink,
	FileText,
	GitFork,
	ChartPie,
	Tag,
	Star,
	ChevronRight,
	BookOpen,
	LayoutPanelTop,
} from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { releaseHref } from "@/lib/releases";
import { accentCss, getLanding } from "@/lib/landings";
import type { Project } from "@/types";

interface Props {
	project: Project;
	projectHasAnalytics: boolean;
	analyticsSlug: string;
	/** Which tab this page is. */
	view: "overview" | "readme";
}

const { project, projectHasAnalytics, analyticsSlug, view } = Astro.props;

const meta = getLanding(project.slug)?.landing;
const landing = Boolean(getLanding(project.slug));
const base = `/projects/${project.slug}`;
const pageUrl = view === "readme" && landing ? `${base}/readme` : base;

const releases = project.releases ?? [];
const latestRelease = releases[0];
const contributors = project.contributors ?? [];
const description = meta?.tagline || project.description;

// The repo's homepage often points back at this page. A "Live demo" button
// that reloads the page you are on is noise, so drop it.
const selfLink = /^https?:\/\/(www\.)?tashif\.codes\/projects\//i;
const liveUrl =
	project.live_website_url && !selfLink.test(project.live_website_url)
		? project.live_website_url
		: undefined;

const facts = [
	{ icon: Star, label: "stars", value: project.stars },
	{ icon: GitFork, label: "forks", value: project.forks },
].filter((f) => typeof f.value === "number" && f.value > 0);

const tabs = [
	landing && {
		id: "overview",
		label: "Overview",
		href: base,
		icon: LayoutPanelTop,
	},
	{
		id: "readme",
		label: "README",
		href: landing ? `${base}/readme` : base,
		icon: BookOpen,
	},
	latestRelease && {
		id: "releases",
		label: "Releases",
		href: releaseHref(project.slug, latestRelease.tag_name),
		icon: Tag,
		count: releases.length,
	},
].filter(Boolean) as {
	id: string;
	label: string;
	href: string;
	icon: typeof Tag;
	count?: number;
}[];

const activeTab = landing ? view : "readme";
const accent = accentCss(meta?.accent);

const title =
	view === "readme" && landing
		? `${project.title} README | Projects | Tashif Ahmad Khan`
		: `${project.title} | Projects | Tashif Ahmad Khan`;
---

<PageShell
	title={title}
	description={description || undefined}
	url={pageUrl}
	image={`/og/projects/${project.slug}.jpg`}
	tint="orange"
	compact
	breadcrumbs={[
		{ label: "Home", href: "/" },
		{ label: "Projects", href: "/projects" },
		{ label: project.title },
	]}
>
	<Fragment slot="header">
		{accent && <style is:inline set:html={accent} />}

		<div
			data-project-header
			class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-8"
		>
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
					<h1
						class="font-sans text-2xl sm:text-3xl font-bold tracking-tight text-primary leading-none pb-0.5"
					>
						{project.title}
					</h1>

					{
						facts.map(({ icon: Icon, label, value }) => (
							<span
								class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground"
								title={`${value} ${label}`}
							>
								<Icon className="w-3.5 h-3.5" />
								<span class="text-foreground font-semibold tabular-nums">
									{value}
								</span>
								<span class="sr-only">{label}</span>
							</span>
						))
					}

					{
						contributors.length > 1 && (
							<span class="inline-flex items-center gap-2">
								<span class="flex -space-x-1.5">
									{contributors.slice(0, 5).map((c) => (
										<a
											href={c.html_url}
											target="_blank"
											rel="noopener noreferrer"
											title={`${c.login}, ${c.contributions} contributions`}
											data-haptic-external
											class="block rounded-full ring-2 ring-card transition-transform hover:z-10 hover:-translate-y-0.5"
										>
											<img
												src={`${c.avatar_url}${c.avatar_url.includes("?") ? "&" : "?"}s=48`}
												alt={c.login}
												width="22"
												height="22"
												loading="lazy"
												decoding="async"
												class="h-[22px] w-[22px] rounded-full bg-muted object-cover"
											/>
										</a>
									))}
								</span>
								{contributors.length > 5 && (
									<span class="font-mono text-xs text-muted-foreground tabular-nums">
										+{contributors.length - 5}
									</span>
								)}
							</span>
						)
					}

					{
						project.parentRepo && (
							<a
								href={
									project.originalRepo?.url ??
									`https://github.com/${project.parentRepo}`
								}
								target="_blank"
								rel="noopener noreferrer"
								title={`Forked from ${project.parentRepo}`}
								data-haptic-external
								class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground hover:text-primary transition-colors"
							>
								<GitFork className="w-3.5 h-3.5" />
								{project.parentRepo}
							</a>
						)
					}
				</div>

				{
					description && (
						<p class="mt-2 text-sm sm:text-base text-muted-foreground leading-relaxed max-w-2xl text-pretty">
							{description}
						</p>
					)
				}
			</div>

			<div class="flex flex-wrap items-center gap-2 shrink-0">
				{
					meta?.cta && (
						<a
							href={meta.cta.href}
							target={meta.cta.external ? "_blank" : undefined}
							rel={meta.cta.external ? "noopener noreferrer" : undefined}
							data-haptic-nav
							class={cn(
								buttonVariants({ variant: "default", size: "sm" }),
								"h-8 text-xs gap-1.5 shadow-sm shrink-0",
							)}
						>
							{meta.cta.label}
						</a>
					)
				}
				{
					liveUrl && (
						<a
							href={liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-haptic-external
							class={cn(
								buttonVariants({
									variant: meta?.cta ? "outline" : "default",
									size: "sm",
								}),
								"h-8 text-xs gap-1.5 shadow-sm shrink-0",
							)}
						>
							<ExternalLink className="w-3.5 h-3.5" />
							Live demo
						</a>
					)
				}
				<a
					href={project.github_link}
					target="_blank"
					rel="noopener noreferrer"
					data-haptic-external
					class={cn(
						buttonVariants({ variant: "outline", size: "sm" }),
						"h-8 text-xs gap-1.5 bg-background/50 backdrop-blur-sm shrink-0",
					)}
				>
					<Github className="w-3.5 h-3.5" />
					Source
				</a>
				{
					project.docs_slug && (
						<a
							href={`/docs/${project.docs_slug}`}
							data-haptic-nav
							class={cn(
								buttonVariants({ variant: "outline", size: "sm" }),
								"h-8 text-xs gap-1.5 shadow-sm shrink-0",
							)}
						>
							<FileText className="w-3.5 h-3.5" />
							Docs
						</a>
					)
				}
				{
					projectHasAnalytics && (
						<a
							href={`/projects/stats?project=${analyticsSlug}`}
							data-haptic-nav
							class={cn(
								buttonVariants({ variant: "outline", size: "sm" }),
								"h-8 text-xs gap-1.5 shadow-sm shrink-0",
							)}
						>
							<ChartPie className="w-3.5 h-3.5" />
							Stats
						</a>
					)
				}
			</div>
		</div>

		{
			tabs.length > 1 && (
				<nav
					aria-label={`${project.title} sections`}
					class="project-tabs -mb-4 sm:-mb-5 mt-4 flex gap-1 overflow-x-auto"
				>
					{tabs.map((tab) => {
						const Icon = tab.icon;
						const current = tab.id === activeTab;
						return (
							<a
								href={tab.href}
								data-haptic-nav
								aria-current={current ? "page" : undefined}
								class:list={[
									"project-tab relative inline-flex items-center gap-1.5 px-3 py-2.5 text-sm font-medium whitespace-nowrap transition-colors",
									current
										? "text-foreground"
										: "text-muted-foreground hover:text-foreground",
								]}
							>
								<Icon className="w-3.5 h-3.5" />
								{tab.label}
								{tab.count !== undefined && (
									<span class="font-mono text-[10px] tabular-nums text-muted-foreground">
										{tab.count}
									</span>
								)}
							</a>
						);
					})}
				</nav>
			)
		}
	</Fragment>

	<!-- Reading progress, wired only when a README article is on the page -->
	<div
		slot="overlay"
		id="reading-progress"
		class="fixed top-0 left-0 h-[3px] bg-primary z-[60]"
		style="width:0;transition:width 80ms linear,opacity 180ms ease"
	>
	</div>

	<!-- Sticky bar, slides in once the header scrolls out of view -->
	<div
		slot="overlay"
		id="compact-header"
		class="fixed inset-x-0 top-0 z-50 -translate-y-full transition-transform duration-300 border-b border-border/60 bg-background/85 backdrop-blur-md supports-[backdrop-filter]:bg-background/70"
	>
		<div
			class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 flex items-center justify-between gap-4"
		>
			<nav
				aria-label="Breadcrumb"
				class="flex items-center gap-x-2 min-w-0 font-sans text-sm"
			>
				<a
					href="/projects"
					data-haptic-nav
					class="hidden sm:inline text-muted-foreground hover:text-primary transition-colors shrink-0"
					>Projects</a
				>
				<ChevronRight
					className="hidden sm:block w-3.5 h-3.5 shrink-0 text-muted-foreground/50"
					aria-hidden="true"
				/>
				<span class="font-semibold text-foreground truncate">
					{project.title}
				</span>
				{
					tabs.length > 1 && (
						<span class="hidden md:flex items-center gap-1 ml-3 pl-3 border-l border-border/60">
							{tabs.map((tab) => (
								<a
									href={tab.href}
									data-haptic-nav
									aria-current={tab.id === activeTab ? "page" : undefined}
									class:list={[
										"px-2 py-1 rounded-md text-xs font-medium transition-colors",
										tab.id === activeTab
											? "text-foreground bg-muted"
											: "text-muted-foreground hover:text-foreground",
									]}
								>
									{tab.label}
								</a>
							))}
						</span>
					)
				}
			</nav>

			<div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
				{
					meta?.cta && (
						<a
							href={meta.cta.href}
							target={meta.cta.external ? "_blank" : undefined}
							rel={meta.cta.external ? "noopener noreferrer" : undefined}
							data-haptic-nav
							class={cn(
								buttonVariants({ variant: "default", size: "sm" }),
								"h-8 text-xs shadow-sm",
							)}
						>
							{meta.cta.label}
						</a>
					)
				}
				{
					liveUrl && (
						<a
							href={liveUrl}
							target="_blank"
							rel="noopener noreferrer"
							data-haptic-external
							aria-label="Live demo"
							title="Live demo"
							class={cn(
								buttonVariants({
									variant: meta?.cta ? "outline" : "default",
									size: "icon",
								}),
								"h-8 w-8 shadow-sm",
							)}
						>
							<ExternalLink className="w-3.5 h-3.5" />
						</a>
					)
				}
				<a
					href={project.github_link}
					target="_blank"
					rel="noopener noreferrer"
					data-haptic-external
					aria-label="Source on GitHub"
					title="Source"
					class={cn(
						buttonVariants({ variant: "outline", size: "icon" }),
						"h-8 w-8 bg-background/50",
					)}
				>
					<Github className="w-3.5 h-3.5" />
				</a>
				{
					project.docs_slug && (
						<a
							href={`/docs/${project.docs_slug}`}
							data-haptic-nav
							aria-label="Documentation"
							title="Docs"
							class={cn(
								buttonVariants({ variant: "outline", size: "icon" }),
								"h-8 w-8",
							)}
						>
							<FileText className="w-3.5 h-3.5" />
						</a>
					)
				}
				{
					projectHasAnalytics && (
						<a
							href={`/projects/stats?project=${analyticsSlug}`}
							data-haptic-nav
							aria-label="Stats"
							title="Stats"
							class={cn(
								buttonVariants({ variant: "outline", size: "icon" }),
								"h-8 w-8",
							)}
						>
							<ChartPie className="w-3.5 h-3.5" />
						</a>
					)
				}
			</div>
		</div>
	</div>

	<slot />
</PageShell>

<style>
	/* The active tab's underline sits on the header's bottom border. */
	.project-tabs {
		scrollbar-width: none;
	}
	.project-tab::after {
		content: "";
		position: absolute;
		inset: auto 0.75rem 0 0.75rem;
		height: 2px;
		border-radius: 2px 2px 0 0;
		background: var(--primary);
		transform: scaleX(0);
		transition: transform 180ms ease;
	}
	.project-tab[aria-current="page"]::after {
		transform: scaleX(1);
	}
</style>

<script>
	function initProjectChrome() {
		// Reading progress across the README article (same pattern as blog)
		const bar = document.getElementById("reading-progress");
		const article = document.getElementById("project-readme");
		if (bar && article && !bar.dataset.wired) {
			bar.dataset.wired = "true";
			let hideTimer: number | undefined;
			const updateProgress = () => {
				const rect = article.getBoundingClientRect();
				const denom = Math.max(1, article.offsetHeight - window.innerHeight);
				const pct = Math.min(100, Math.max(0, (-rect.top / denom) * 100));
				bar.style.width = pct + "%";

				// Show the bar only while scrolling, then let it fade away.
				if (hideTimer) clearTimeout(hideTimer);
				if (pct > 0) {
					bar.classList.add("is-visible");
					hideTimer = window.setTimeout(
						() => bar.classList.remove("is-visible"),
						800,
					);
				} else {
					bar.classList.remove("is-visible");
				}
			};
			window.addEventListener("scroll", updateProgress, { passive: true });
			window.addEventListener("resize", updateProgress, { passive: true });
			updateProgress();
		}

		// Sticky bar slides in once the header leaves the viewport
		const compact = document.getElementById("compact-header");
		const hero = document.querySelector("[data-page-header]");
		if (compact && hero && !compact.dataset.wired) {
			compact.dataset.wired = "true";
			new IntersectionObserver(
				([entry]) => {
					compact.classList.toggle("-translate-y-full", entry.isIntersecting);
				},
				{ rootMargin: "-1px 0px 0px 0px" },
			).observe(hero);
		}
	}

	initProjectChrome();
	document.addEventListener("astro:page-load", initProjectChrome);
</script>
