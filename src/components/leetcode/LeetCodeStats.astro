---
import { leetCodeData } from "../../data/leetcode";
import { Trophy, Target, Calendar, Award } from "lucide-react";

const { stats } = leetCodeData;

const metricCards = [
	{
		key: "totalSolved",
		subKey: "totalQuestions",
		label: "Total Solved",
		value: stats.totalSolved.toString(),
		sub: `of ${stats.totalQuestions} problems`,
		icon: Trophy,
	},
	{
		key: "ranking",
		label: "Global Ranking",
		value: `#${stats.ranking.toLocaleString()}`,
		sub: "out of millions",
		icon: Target,
	},
	{
		key: "reputation",
		label: "Reputation",
		value: stats.reputation.toString(),
		sub: "contribution points",
		icon: Award,
	},
	{
		key: "contribution",
		label: "Contribution",
		value: stats.contributionPoints.toString(),
		sub: "points earned",
		icon: Calendar,
	},
];

// LeetCode's own difficulty palette
const difficulties = [
	{
		key: "easy",
		label: "Easy",
		solved: stats.easySolved,
		total: stats.totalEasy,
		text: "text-emerald-500",
		bar: "bg-emerald-500",
	},
	{
		key: "medium",
		label: "Medium",
		solved: stats.mediumSolved,
		total: stats.totalMedium,
		text: "text-amber-500",
		bar: "bg-amber-500",
	},
	{
		key: "hard",
		label: "Hard",
		solved: stats.hardSolved,
		total: stats.totalHard,
		text: "text-rose-500",
		bar: "bg-rose-500",
	},
];
---

<!-- Metric Grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6" data-lc-stats>
	{
		metricCards.map((card) => (
			<div class="relative overflow-hidden rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm p-4 sm:p-5 hover:border-primary/30 transition-colors">
				<div class="absolute left-0 top-4 bottom-4 w-[2px] rounded-r-full bg-primary/70" />
				<p class="pl-3 text-[10px] font-bold uppercase tracking-[0.15em] text-muted-foreground flex items-center gap-1.5 truncate">
					<card.icon className="w-3 h-3 shrink-0" />
					{card.label}
				</p>
				<p
					class="pl-3 mt-2.5 font-mono text-2xl sm:text-[1.7rem] font-bold text-foreground tabular-nums leading-none"
					data-lc-metric={card.key}
				>
					{card.value}
				</p>
				<p
					class="pl-3 mt-1.5 text-[10px] text-muted-foreground truncate"
					data-lc-metric={card.subKey}
				>
					{card.sub}
				</p>
			</div>
		))
	}
</div>

<!-- Difficulty Breakdown -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mb-8">
	{
		difficulties.map((diff) => {
			const pct =
				diff.total > 0 ? Math.round((diff.solved / diff.total) * 100) : 0;
			return (
				<div
					class="rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm p-5 hover:border-primary/30 transition-colors"
					data-lc-diff={diff.key}
				>
					<div class="flex items-baseline justify-between mb-3">
						<span
							class:list={[
								"text-[10px] font-bold uppercase tracking-[0.15em]",
								diff.text,
							]}
						>
							{diff.label}
						</span>
						<span class="font-mono text-lg font-bold text-foreground tabular-nums">
							<span data-lc-diff-solved>{diff.solved}</span>
							<span
								class="text-xs font-medium text-muted-foreground"
								data-lc-diff-total
							>
								/{diff.total}
							</span>
						</span>
					</div>
					<div class="h-1.5 rounded-full bg-secondary overflow-hidden">
						<div
							class:list={["h-full rounded-full", diff.bar]}
							style={`width:${pct}%`}
							data-lc-diff-bar
						/>
					</div>
					<p
						class="mt-2 font-mono text-[11px] text-muted-foreground tabular-nums"
						data-lc-diff-pct
					>
						{pct}% solved
					</p>
				</div>
			);
		})
	}
</div>
