---
/**
 * Renders Markdown from three sources: blog post bodies fetched from the blog
 * API, project READMEs, and the generated docs under src/data/docs.
 *
 * Parsing, directives, callouts, anchors, and diagram detection come from
 * src/lib/markdown, which is mirrored from the Blog repo's packages/markdown so
 * a post renders identically here, on blog.tashif.codes, and in the editor.
 * This file supplies only the site's class names.
 */
import { renderMarkdown, type MarkdownTheme } from "../lib/markdown";
import "../styles/markdown-theme.css";

interface Props {
  content?: string;
  githubBaseUrl?: string;
  project?: string;
  /**
   * `repo` reads a root-relative URL as repository-root-relative, which is what
   * a README means by it. `post` leaves it as a site path.
   */
  source?: "repo" | "post";
  /** Origin serving root-relative assets when `source` is `post`. */
  assetBaseUrl?: string;
  class?: string;
}

const {
  content,
  githubBaseUrl,
  project,
  source,
  assetBaseUrl,
  class: className = "",
} = Astro.props;

// READMEs and docs always arrive with a repository URL; post bodies do not.
const resolvedSource = source ?? (githubBaseUrl ? "repo" : "post");

const theme: MarkdownTheme = {
  headingWrap: "group",
  h1: "mt-10 mb-6 first:mt-0 border-b border-border pb-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground",
  h2: "mt-10 mb-4 text-2xl sm:text-3xl font-semibold tracking-tight text-foreground",
  h3: "mt-8 mb-3 text-xl sm:text-2xl font-semibold text-foreground",
  h4: "mt-8 mb-3 text-lg sm:text-xl font-medium text-foreground",
  h5: "mt-8 mb-3 text-base font-medium text-foreground",
  h6: "mt-8 mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground",

  paragraph: "leading-7 text-foreground/90 mb-6 last:mb-0",
  paragraphTight: "leading-7 text-foreground/90",
  strong: "font-bold text-foreground",
  em: "italic text-muted-foreground font-medium",
  link: "text-primary underline underline-offset-4 hover:text-primary/80 transition-colors",

  codeInline:
    "inline-flex items-center rounded-lg border border-slate-300 bg-slate-100 px-2.5 py-1 font-mono text-[0.92em] font-semibold text-slate-800 shadow-sm dark:border-slate-600/40 dark:bg-slate-800/90 dark:text-slate-100",
  codeLang: "font-mono",
  codePre: "text-[0.9rem]",
  codeTag: "font-mono text-foreground/90",

  listItem: "leading-relaxed text-foreground/90",

  td: "text-sm text-foreground/90 whitespace-pre-wrap",

  image:
    "shadow-md transition-all duration-300 group-hover:shadow-lg",

  // Callouts/panels/phases are rail-only. Taped panels pick up a quiet surface.
  panel: "",
  toc: "bg-card/50 backdrop-blur-sm border-border/60",
  checklist: "bg-card/40 border-border/60",
  meter: "bg-card/50 backdrop-blur-sm border-border/60",
  phase: "",
  bars: "bg-card/50 backdrop-blur-sm border-border/60",
  stat: "bg-card/50 backdrop-blur-sm border-border/60",
  tabs: "bg-card/50 backdrop-blur-sm border-border/60",
  details: "bg-card/50 backdrop-blur-sm border-border/60",
  ascii: "bg-card/60 border-border/60",
  callout: "",

  lede: "text-lg text-foreground/90",
};

const html = content
  ? renderMarkdown(content, {
      githubBaseUrl,
      project,
      rootRelative: resolvedSource === "repo" ? "repo" : "site",
      assetBaseUrl,
      mermaid: true,
      theme,
    })
  : "<p>No content provided.</p>";
---

<link
  href="https://cdnjs.cloudflare.com/ajax/libs/prism-themes/1.9.0/prism-one-dark.min.css"
  rel="stylesheet"
/>

<div
  class:list={[
    "markdown-body",
    "max-w-none text-base font-sans antialiased",
    className,
  ]}
  set:html={html}
/>

<script>
  import Prism from "prismjs";
  import "prismjs/plugins/autoloader/prism-autoloader";

  import {
    initCopyButtons,
    initTabs,
    isDarkTheme,
    renderMermaidBlocks,
    watchThemeChanges,
  } from "../lib/markdown/client";

  // @ts-ignore - the autoloader plugin adds this property at runtime
  if (Prism.plugins.autoloader) {
    // @ts-ignore
    Prism.plugins.autoloader.languages_path =
      "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/";
  }

  // Diagrams are only pulled in when the page actually has one, which keeps the
  // mermaid bundle off pages that are pure prose.
  async function drawDiagrams(force = false) {
    if (!document.querySelector(".md-mermaid")) return;
    const { default: mermaid } = await import("mermaid");
    await renderMermaidBlocks(mermaid, { dark: isDarkTheme(), force });
  }

  initCopyButtons();
  initTabs();
  watchThemeChanges(() => void drawDiagrams(true));

  // Re-run on every view transition: the article element is swapped wholesale,
  // so the previous page's tab strips and highlighting go with it.
  document.addEventListener("astro:page-load", () => {
    initTabs();
    void drawDiagrams();
    Prism.highlightAll();
  });
</script>
