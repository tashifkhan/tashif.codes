---
/**
 * One post in a list. Four shapes share the same data hooks, so search,
 * topic filters and live refresh treat them alike:
 *
 * - `featured`: newest post, cover at its own 16:9 beside the text.
 * - `default`: grid card.
 * - `row`: dense list row, grouped by year by the caller.
 * - `compact`: smaller card for "related posts" under an article.
 *
 * Every title is a real heading (h3 unless `headingLevel` says otherwise), so
 * screen-reader heading navigation reaches every post, not just the first.
 */
import { ArrowRight } from "lucide-react";
import { cn } from "@/lib/utils";
import { resolveCoverImage, resolveReadingTimeMinutes } from "../../data/blog";
import { formatPostDate, postYear } from "../../lib/blog-shared";
import type { BlogPost } from "@/types";

type Props = {
	post: BlogPost;
	variant?: "default" | "featured" | "row" | "compact";
	headingLevel?: 2 | 3 | 4;
	/** Load the cover eagerly; only for a card above the fold. */
	eager?: boolean;
	/** Kept for callers that still pass a position; unused. */
	index?: number;
};

const { post, variant = "default", headingLevel = 3, eager = false } = Astro.props;

const Heading = headingLevel === 2 ? "h2" : headingLevel === 4 ? "h4" : "h3";
const url = `/blog/${post.slug}`;
const tags = Array.isArray(post.tags) ? post.tags : [];
const dateText = formatPostDate(post.date);
const readTime = resolveReadingTimeMinutes(post);
const wordCount =
	post.wordCount ??
	(typeof post.metadata?.wordCount === "number" ? (post.metadata.wordCount as number) : 0);
const coverUrl = resolveCoverImage(post);

const linkAttrs = {
	href: url,
	"data-blog-card": "",
	"data-blog-variant": variant,
	"data-blog-tags": tags.join(","),
	"data-blog-slug": post.slug,
	"data-blog-year": postYear(post.date),
	"data-haptic": "",
};

const coverImg = (extra: string) => ({
	src: coverUrl ?? "",
	alt: "",
	width: 1200,
	height: 675,
	decoding: "async" as const,
	loading: eager ? ("eager" as const) : ("lazy" as const),
	fetchpriority: eager ? ("high" as const) : undefined,
	"data-blog-cover": "",
	class: cn(
		"h-full w-full object-cover transition-transform duration-200 motion-safe:group-hover:scale-[1.015]",
		!coverUrl && "hidden",
		extra,
	),
});
---

{
	variant === "featured" ? (
		<a {...linkAttrs} class="group block focus-visible:outline-none">
			<div class="motion-card grid overflow-hidden rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm hover:border-primary/30 hover:shadow-lg dark:hover:shadow-primary/5 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
				<div
					class={cn(
						"relative aspect-[16/9] overflow-hidden border-b border-border/50 bg-muted/30 md:border-b-0 md:border-r",
						!coverUrl && "hidden",
					)}
					data-blog-cover-wrap
				>
					<img {...coverImg("")} />
				</div>
				<div class="flex flex-col justify-center gap-3 p-6 sm:p-7">
					<p class="font-mono text-[11px] text-primary">
						Latest{tags.length > 0 && ` · ${tags.join(" · ")}`}
					</p>
					<Heading
						class="text-balance text-2xl font-bold tracking-tight transition-colors group-hover:text-primary sm:text-[1.7rem] sm:leading-tight"
						data-blog-title
					>
						{post.title}
					</Heading>
					{post.excerpt && (
						<p class="line-clamp-3 leading-relaxed text-muted-foreground" data-blog-excerpt>
							{post.excerpt}
						</p>
					)}
					<div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
						<time datetime={post.date} data-blog-date>{dateText}</time>
						<span data-reading-time><span>{readTime}</span> min read</span>
						{wordCount > 0 && <span class="hidden sm:inline">{wordCount.toLocaleString("en-US")} words</span>}
					</div>
					<span class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
						Read the post
						<ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
					</span>
				</div>
			</div>
		</a>
	) : variant === "row" ? (
		<a {...linkAttrs} class="group block border-b border-border/60 focus-visible:outline-none">
			<div class="grid grid-cols-1 items-center gap-x-5 gap-y-1 py-4 sm:grid-cols-[6.5rem_minmax(0,1fr)_10rem]">
				<time datetime={post.date} class="font-mono text-xs text-muted-foreground" data-blog-date>
					{dateText}
				</time>
				<div class="min-w-0">
					<Heading
						class="text-[17px] font-semibold leading-snug tracking-tight transition-colors group-hover:text-primary"
						data-blog-title
					>
						{post.title}
					</Heading>
					{post.excerpt && (
						<p class="mt-1 line-clamp-2 text-sm text-muted-foreground sm:line-clamp-1" data-blog-excerpt>
							{post.excerpt}
						</p>
					)}
					<p class="mt-1.5 font-mono text-[11px] text-muted-foreground">
						{tags.join(" · ")}
						{tags.length > 0 && " · "}
						<span data-reading-time><span>{readTime}</span> min</span>
					</p>
				</div>
				<div
					class={cn(
						"hidden aspect-[16/9] overflow-hidden rounded-lg border border-border/50 bg-muted/30 sm:block",
						!coverUrl && "sm:hidden",
					)}
				>
					<img {...coverImg("")} />
				</div>
			</div>
		</a>
	) : (
		<a {...linkAttrs} class="group block h-full focus-visible:outline-none">
			<div class="motion-card flex h-full flex-col overflow-hidden rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm hover:border-primary/30 hover:shadow-lg dark:hover:shadow-primary/5">
				<div
					class={cn(
						"relative aspect-[16/9] w-full overflow-hidden border-b border-border/40 bg-muted/30",
						!coverUrl && "hidden",
					)}
					data-blog-cover-wrap
				>
					<img {...coverImg("")} />
				</div>
				<div class={cn("flex flex-1 flex-col gap-2", variant === "compact" ? "p-4" : "p-5")}>
					{tags.length > 0 && (
						<p class="font-mono text-[11px] text-primary">{tags.join(" · ")}</p>
					)}
					<Heading
						class={cn(
							"line-clamp-2 font-semibold leading-snug tracking-tight transition-colors group-hover:text-primary",
							variant === "compact" ? "text-[15px]" : "text-lg",
						)}
						data-blog-title
					>
						{post.title}
					</Heading>
					{post.excerpt && (
						<p
							class={cn(
								"text-sm leading-relaxed text-muted-foreground",
								variant === "compact" ? "line-clamp-2" : "line-clamp-3",
							)}
							data-blog-excerpt
						>
							{post.excerpt}
						</p>
					)}
					<div class="mt-auto flex items-center justify-between pt-3 font-mono text-xs text-muted-foreground">
						<span class="flex items-center gap-3">
							<time datetime={post.date} data-blog-date>{dateText}</time>
							<span data-reading-time><span>{readTime}</span> min</span>
						</span>
						<span class="motion-card-arrow flex -translate-x-2 items-center gap-1 text-primary opacity-0 transition-[opacity,translate] duration-200 group-hover:translate-x-0 group-hover:opacity-100">
							Read <ArrowRight className="h-3 w-3" />
						</span>
					</div>
				</div>
			</div>
		</a>
	)
}
