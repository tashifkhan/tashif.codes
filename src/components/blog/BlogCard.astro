---
import { Calendar, Clock, ArrowRight } from "lucide-react";
import {
	Card,
	CardContent,
	CardFooter,
	CardHeader,
	CardTitle,
} from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { cn } from "@/lib/utils";
import { resolveCoverImage, resolveReadingTimeMinutes } from "../../data/blog";
import type { BlogPost } from "@/types";

type Props = {
	post: BlogPost;
	variant?: "default" | "featured" | "compact" | "spotlight";
	index?: number;
};

const { post, variant = "default", index = 0 } = Astro.props as Props;

const url = `/blog/${post.slug}`;
const dateObj = new Date(post.date);
const dateText = dateObj.toLocaleDateString("en-US", {
	month: "short",
	day: "numeric",
	year: "numeric",
});

const wordCount =
	post.wordCount ??
	(typeof post.metadata?.wordCount === "number"
		? (post.metadata.wordCount as number)
		: 0);
const readTime = resolveReadingTimeMinutes(post);
const coverUrl = resolveCoverImage(post);
---

{
	variant === "featured" ? (
		<a
			href={url}
			class="block h-full group focus:outline-none"
			data-blog-card
			data-blog-tags={post.tags?.join(",")}
			data-blog-slug={post.slug}
			data-haptic
		>
			<Card
				className={cn(
					"h-full overflow-hidden border-border/50 bg-card/50 backdrop-blur-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 dark:hover:shadow-primary/5 hover:border-primary/20",
					"animate-in fade-in slide-in-from-bottom-4"
				)}
				style={{ animationDelay: `${index * 100}ms` }}
			>
				<div class="flex flex-col md:flex-row h-full">
					<div class="relative md:w-1/3 min-h-[10rem] md:min-h-0 flex flex-col justify-between bg-muted/30 border-b md:border-b-0 md:border-r border-border/50 overflow-hidden">
						{coverUrl ? (
							<>
								{/* object-left: poster wordmarks sit on the left; center-crop clipped them in the 1/3 pane */}
								<img
									src={coverUrl}
									alt=""
									data-blog-cover
									class="absolute inset-0 w-full h-full object-cover object-left transition-transform duration-500 group-hover:scale-[1.03]"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-background/80 via-background/20 to-transparent md:bg-gradient-to-r md:from-transparent md:via-transparent md:to-background/40" />
							</>
						) : (
							<>
								{/* Empty cover target for live refresh when a cover appears later */}
								<img
									src=""
									alt=""
									data-blog-cover
									class="absolute inset-0 w-full h-full object-cover hidden"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-50" />
							</>
						)}
						<div class="relative z-10 flex flex-wrap gap-2 p-6">
							{post.tags?.slice(0, 3).map((tag) => (
								<Badge
									variant="secondary"
									className={cn(
										"text-[10px] font-medium tracking-wide",
										coverUrl && "backdrop-blur-sm bg-background/70"
									)}
									data-blog-tag
								>
									{tag}
								</Badge>
							))}
						</div>
					</div>
					<div class="flex-1 flex flex-col p-6 gap-4">
						<div class="space-y-2">
							<h2
								class="text-2xl font-bold tracking-tight group-hover:text-primary transition-colors"
								data-blog-title
							>
								{post.title}
							</h2>
							{post.excerpt && (
								<p
									class="text-muted-foreground leading-relaxed line-clamp-3"
									data-blog-excerpt
								>
									{post.excerpt}
								</p>
							)}
						</div>
						<div class="mt-auto pt-4 flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
							<span class="flex items-center gap-1.5">
								<Calendar className="w-4 h-4" />
								<span data-blog-date>{dateText}</span>
							</span>
							<span class="flex items-center gap-1.5" data-reading-time>
								<Clock className="w-4 h-4" />
								<span>{readTime}</span> min read
							</span>
							{wordCount > 0 && (
								<span class="hidden sm:inline text-xs font-mono opacity-70">
									{wordCount.toLocaleString("en-US")} words
								</span>
							)}
							<span class="ml-auto flex items-center gap-1.5 text-primary font-medium group-hover:translate-x-1 transition-transform">
								Read Article <ArrowRight className="w-4 h-4" />
							</span>
						</div>
					</div>
				</div>
			</Card>
		</a>
	) : (
		<a
			href={url}
			class="block h-full group focus:outline-none"
			data-blog-card
			data-blog-tags={post.tags?.join(",")}
			data-blog-slug={post.slug}
			data-haptic
		>
			<Card
				className={cn(
					"h-full flex flex-col overflow-hidden border-border/50 bg-card/50 backdrop-blur-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-1 dark:hover:shadow-primary/5 hover:border-primary/20",
					"animate-in fade-in slide-in-from-bottom-4"
				)}
				style={{ animationDelay: `${index * 100}ms` }}
			>
				<div
					class={cn(
						"relative w-full aspect-[16/9] overflow-hidden border-b border-border/40 bg-muted/30",
						coverUrl ? "" : "hidden"
					)}
					data-blog-cover-wrap
				>
					<img
						src={coverUrl || ""}
						alt=""
						data-blog-cover
						class={cn(
							"w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]",
							coverUrl ? "" : "hidden"
						)}
						loading="lazy"
					/>
				</div>
				<CardHeader className="p-5 pb-2 space-y-3">
					<div class="flex flex-wrap gap-2">
						{post.tags?.slice(0, 3).map((tag) => (
							<Badge
								variant="outline"
								className="text-[10px] font-normal bg-background/50 backdrop-blur-sm"
								data-blog-tag
							>
								{tag}
							</Badge>
						))}
					</div>
					<CardTitle
						className="text-lg leading-tight group-hover:text-primary transition-colors line-clamp-2"
						data-blog-title
					>
						{post.title}
					</CardTitle>
				</CardHeader>
				<CardContent className="p-5 py-2 flex-1">
					{post.excerpt && (
						<p
							class="text-sm text-muted-foreground leading-relaxed line-clamp-3"
							data-blog-excerpt
						>
							{post.excerpt}
						</p>
					)}
				</CardContent>
				<CardFooter className="p-5 pt-2 text-xs text-muted-foreground flex items-center justify-between border-t border-border/30 mt-auto bg-muted/20">
					<div class="flex items-center gap-3">
						<span class="flex items-center gap-1.5">
							<Calendar className="w-3.5 h-3.5" />
							<span data-blog-date>{dateText}</span>
						</span>
						<span class="flex items-center gap-1.5" data-reading-time>
							<Clock className="w-3.5 h-3.5" />
							<span>{readTime}</span>m
						</span>
					</div>
					<span class="flex items-center gap-1.5 text-primary opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 group-hover:translate-x-0">
						Read <ArrowRight className="w-3 h-3" />
					</span>
				</CardFooter>
			</Card>
		</a>
	)
}
