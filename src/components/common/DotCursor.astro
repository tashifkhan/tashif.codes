---
/**
 * The single accent dot that follows the pointer. It stays out of the
 * accessibility tree, never blocks clicks, and only runs on fine pointers in
 * either skin when motion is allowed. The color comes from the active skin's
 * primary token.
 *
 * The native cursor stays visible. This is an accent, not a replacement.
 */
---

<div class="dot-cursor" data-dot-cursor data-visible="false" aria-hidden="true">
	<span></span>
</div>

<script>
	import { motionReduced } from "../../lib/motion";

	(() => {
		if (!(window as Window & { __dotCursorWired?: boolean }).__dotCursorWired) {
			(window as Window & { __dotCursorWired?: boolean }).__dotCursorWired = true;

			const finePointer = matchMedia("(hover: hover) and (pointer: fine)");

			let root: HTMLElement | null = null;
			let dot: HTMLElement | null = null;
			let x = innerWidth / 2;
			let y = innerHeight / 2;
			let targetX = x;
			let targetY = y;
			let raf = 0;
			let visible = false;
			let seen = false;

			const bind = () => {
				root = document.querySelector<HTMLElement>("[data-dot-cursor]");
				dot = root?.querySelector<HTMLElement>("span") ?? null;
				visible = false;
				seen = false;
				if (root) root.dataset.visible = "false";
			};

			const setVisible = (next: boolean) => {
				visible = next;
				if (root) root.dataset.visible = String(next);
			};

			const frame = () => {
				raf = 0;
				if (!dot) return;

				x += (targetX - x) * 0.35;
				y += (targetY - y) * 0.35;
				dot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;

				if (Math.abs(targetX - x) + Math.abs(targetY - y) > 0.1) {
					raf = requestAnimationFrame(frame);
				}
			};

			const move = (event: PointerEvent) => {
				if (event.pointerType === "touch") return;
				if (!finePointer.matches) return;
				if (motionReduced()) return;

				if (!dot) bind();
				if (!dot) return;

				if (!seen) {
					x = targetX = event.clientX;
					y = targetY = event.clientY;
					seen = true;
				} else {
					targetX = event.clientX;
					targetY = event.clientY;
				}

				if (!visible) setVisible(true);
				if (!raf) raf = requestAnimationFrame(frame);
			};

			window.addEventListener("pointermove", move, { passive: true });
			document.documentElement.addEventListener("mouseleave", () => setVisible(false));
			window.addEventListener("blur", () => setVisible(false));
			document.addEventListener("astro:page-load", bind);

			bind();
		}
	})();
</script>
