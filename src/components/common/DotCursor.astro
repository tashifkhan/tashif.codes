---
/**
 * The ring that follows the pointer, ported from taf.sh. At rest it's a hollow
 * ring that inverts what's under it; over anything clickable it grows into an
 * accent-colored ring, and it tightens while the button is held. It stays out
 * of the accessibility tree, never blocks clicks, and only runs on fine
 * pointers when motion is allowed. Styles live in studio-skin.css.
 *
 * The native cursor stays visible. This is an accent, not a replacement.
 */
---

<div class="dot-cursor" data-dot-cursor data-visible="false" aria-hidden="true">
	<span></span>
</div>

<script>
	import { motionReduced } from "../../lib/motion";

	(() => {
		if (!(window as Window & { __dotCursorWired?: boolean }).__dotCursorWired) {
			(window as Window & { __dotCursorWired?: boolean }).__dotCursorWired = true;

			const finePointer = matchMedia("(hover: hover) and (pointer: fine)");

			let root: HTMLElement | null = null;
			let dot: HTMLElement | null = null;
			let x = innerWidth / 2;
			let y = innerHeight / 2;
			let targetX = x;
			let targetY = y;
			let raf = 0;
			let visible = false;
			let seen = false;
			let hovering = false;
			const INTERACTIVE = "a[href], button, input, textarea, select, label, summary, [role='button'], [role='tab'], [data-cursor-hover]";

			const bind = () => {
				root = document.querySelector<HTMLElement>("[data-dot-cursor]");
				dot = root?.querySelector<HTMLElement>("span") ?? null;
				visible = false;
				seen = false;
				hovering = false;
				if (root) {
					root.dataset.visible = "false";
					root.dataset.hover = "false";
					root.dataset.pressed = "false";
				}
			};

			const setVisible = (next: boolean) => {
				visible = next;
				if (root) root.dataset.visible = String(next);
			};

			const frame = () => {
				raf = 0;
				if (!dot) return;

				x += (targetX - x) * 0.35;
				y += (targetY - y) * 0.35;
				dot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;

				if (Math.abs(targetX - x) + Math.abs(targetY - y) > 0.1) {
					raf = requestAnimationFrame(frame);
				}
			};

			const move = (event: PointerEvent) => {
				if (event.pointerType === "touch") return;
				if (!finePointer.matches) return;
				if (motionReduced()) return;

				if (!dot) bind();
				if (!dot) return;

				if (!seen) {
					x = targetX = event.clientX;
					y = targetY = event.clientY;
					seen = true;
				} else {
					targetX = event.clientX;
					targetY = event.clientY;
				}

				const over = event.target instanceof Element && event.target.closest(INTERACTIVE) !== null;
				if (over !== hovering && root) {
					hovering = over;
					root.dataset.hover = String(over);
				}

				if (!visible) setVisible(true);
				if (!raf) raf = requestAnimationFrame(frame);
			};

			window.addEventListener("pointermove", move, { passive: true });
			const press = (down: boolean) => (event: PointerEvent) => {
				if (event.pointerType === "touch" || !root) return;
				root.dataset.pressed = String(down);
			};
			window.addEventListener("pointerdown", press(true), { passive: true });
			window.addEventListener("pointerup", press(false), { passive: true });
			document.documentElement.addEventListener("mouseleave", () => setVisible(false));
			window.addEventListener("blur", () => setVisible(false));
			document.addEventListener("astro:page-load", bind);

			bind();
		}
	})();
</script>
