---
/**
 * A hairline grid of short features. Icons are lucide-react components.
 */
import type { LucideIcon } from "lucide-react";

export interface Feature {
	icon: LucideIcon;
	title: string;
	body: string;
}

interface Props {
	features: Feature[];
}

const { features } = Astro.props;
---

<ul
	role="list"
	class="grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3"
>
	{
		features.map(({ icon: Icon, title, body }) => (
			<li class="group bg-card p-6 sm:p-7 transition-colors hover:bg-muted/60">
				<span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary transition-transform duration-300 group-hover:-translate-y-0.5">
					<Icon className="w-[18px] h-[18px]" />
				</span>
				<h3 class="mt-4 text-base font-semibold tracking-tight text-foreground">
					{title}
				</h3>
				<p class="mt-1.5 text-sm text-muted-foreground leading-relaxed text-pretty">
					{body}
				</p>
			</li>
		))
	}
</ul>
