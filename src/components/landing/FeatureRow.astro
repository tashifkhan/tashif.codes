---
/**
 * Copy on one side, media on the other. Set `flip` on every second row to
 * alternate sides. The default slot is the body copy, `media` is the visual.
 */
interface Props {
	eyebrow?: string;
	title: string;
	flip?: boolean;
}

const { eyebrow, title, flip = false } = Astro.props;
---

<div
	data-feature-row
	class="grid items-center gap-8 lg:gap-16 lg:grid-cols-2 py-8 sm:py-12 first:pt-0 last:pb-0"
>
	<div class:list={["min-w-0", flip && "lg:order-2"]}>
		{
			eyebrow && (
				<p class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground mb-3">
					{eyebrow}
				</p>
			)
		}
		<h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight leading-[1.08] text-balance text-foreground">
			{title}
		</h3>
		<div class="feature-copy mt-4 space-y-3 text-base sm:text-lg text-muted-foreground leading-relaxed text-pretty max-w-xl">
			<slot />
		</div>
	</div>
	<div
		class:list={["feature-media min-w-0 flex justify-center", flip && "lg:order-1"]}
	>
		<slot name="media" />
	</div>
</div>

<style>
	.feature-media {
		--device-width: 270px;
	}
	.feature-copy :global(strong) {
		color: var(--foreground);
		font-weight: 600;
	}
	.feature-copy :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		padding: 0.1em 0.4em;
		border-radius: 0.4em;
		background: var(--muted);
		border: 1px solid var(--border);
		color: var(--foreground);
	}
</style>
