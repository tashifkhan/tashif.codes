---
/**
 * A device outline around a screenshot or video. The bezel colours come from
 * the theme tokens, so the frame follows the skin and the light or dark mode.
 * Use `card` for media that already shows its own device, such as a composed
 * promo clip. It gets rounded corners and a hairline, no bezel.
 */
interface Props {
	kind?: "phone" | "tablet" | "browser" | "card";
	/** Address shown in the browser bar. */
	url?: string;
	/** CSS aspect-ratio of the screen. Defaults per kind. */
	aspect?: string;
	class?: string;
}

const { kind = "phone", url, aspect, class: className } = Astro.props;
const portrait = kind === "phone" || kind === "card";
const ratio = aspect ?? (portrait ? "9 / 16" : "16 / 10");
---

<figure
	data-device={kind}
	class:list={["device", `device-${kind}`, className]}
>
	{
		kind === "browser" && (
			<div class="device-bar">
				<span class="device-dots" aria-hidden="true">
					<i />
					<i />
					<i />
				</span>
				{url && <span class="device-url">{url}</span>}
			</div>
		)
	}
	<div class="device-screen" style={`aspect-ratio:${ratio}`}>
		<slot />
	</div>
</figure>

<style>
	.device {
		--bezel: color-mix(in oklab, var(--foreground) 92%, var(--background));
		--bezel-edge: color-mix(in oklab, var(--foreground) 30%, transparent);
		position: relative;
		margin: 0;
		background: var(--bezel);
		box-shadow:
			0 0 0 1px var(--bezel-edge),
			0 30px 60px -30px color-mix(in oklab, var(--foreground) 45%, transparent);
	}
	:global(.dark) .device {
		--bezel: color-mix(in oklab, var(--foreground) 12%, var(--background));
		--bezel-edge: color-mix(in oklab, var(--foreground) 22%, transparent);
		box-shadow:
			0 0 0 1px var(--bezel-edge),
			0 30px 70px -30px #000;
	}
	.device-screen {
		position: relative;
		overflow: hidden;
		background: var(--muted);
	}
	.device-screen :global(:is(video, img)) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.device-phone {
		width: min(100%, var(--device-width, 300px));
		padding: 9px;
		border-radius: 2.6rem;
	}
	.device-phone .device-screen {
		border-radius: 2.05rem;
	}

	.device-card {
		width: min(100%, var(--device-width, 340px));
		border-radius: 1.75rem;
		overflow: hidden;
		background: var(--card);
		box-shadow:
			0 0 0 1px var(--border),
			0 30px 60px -34px color-mix(in oklab, var(--foreground) 45%, transparent);
	}
	:global(.dark) .device-card {
		background: var(--card);
		box-shadow:
			0 0 0 1px var(--border),
			0 30px 70px -30px #000;
	}

	.device-tablet {
		width: 100%;
		padding: 12px;
		border-radius: 1.6rem;
	}
	.device-tablet .device-screen {
		border-radius: 0.9rem;
	}

	.device-browser {
		width: 100%;
		border-radius: 0.9rem;
		overflow: hidden;
		background: var(--card);
		box-shadow:
			0 0 0 1px var(--border),
			0 30px 60px -34px color-mix(in oklab, var(--foreground) 45%, transparent);
	}
	:global(.dark) .device-browser {
		background: var(--card);
		box-shadow:
			0 0 0 1px var(--border),
			0 30px 70px -30px #000;
	}
	.device-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 2.25rem;
		padding: 0 0.85rem;
		border-bottom: 1px solid var(--border);
		background: var(--muted);
	}
	.device-dots {
		display: inline-flex;
		gap: 0.35rem;
	}
	.device-dots i {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 9999px;
		background: color-mix(in oklab, var(--foreground) 22%, transparent);
	}
	.device-url {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--muted-foreground);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
