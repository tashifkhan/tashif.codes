---
/**
 * Questions that open in place. Native <details>, so it works without script.
 */
import { Plus } from "lucide-react";

export interface FaqItem {
	q: string;
	/** Plain text or trusted HTML. */
	a: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-border border-y border-border">
	{
		items.map((item) => (
			<details class="faq group">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-base sm:text-lg font-semibold tracking-tight text-foreground">
					{item.q}
					<Plus className="faq-icon w-4 h-4 shrink-0 text-muted-foreground transition-transform duration-200" />
				</summary>
				<div
					class="faq-answer pb-6 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed text-pretty"
					set:html={item.a}
				/>
			</details>
		))
	}
</div>

<style>
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq summary:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
		border-radius: 0.375rem;
	}
	.faq[open] :global(.faq-icon) {
		transform: rotate(45deg);
	}
	.faq-answer :global(a) {
		color: var(--primary);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.faq-answer :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		color: var(--foreground);
	}
</style>
