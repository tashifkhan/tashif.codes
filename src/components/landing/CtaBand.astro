---
/**
 * Closing band on the accent colour. Buttons go in the default slot.
 */
interface Props {
	title: string;
	lead?: string;
}

const { title, lead } = Astro.props;
---

<section
	data-landing-cta
	class="relative overflow-hidden rounded-3xl bg-primary text-primary-foreground px-6 py-12 sm:px-12 sm:py-16 my-14 sm:my-20"
>
	<div aria-hidden="true" class="cta-rings"></div>
	<div class="relative max-w-2xl">
		<h2 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.02] text-balance">
			{title}
		</h2>
		{
			lead && (
				<p class="mt-4 text-base sm:text-lg leading-relaxed opacity-85 text-pretty">
					{lead}
				</p>
			)
		}
		<div class="mt-7 flex flex-wrap items-center gap-3">
			<slot />
		</div>
	</div>
</section>

<style>
	[data-landing-cta] :global(h2) {
		color: inherit;
	}
	.cta-rings {
		position: absolute;
		right: -12%;
		top: 50%;
		width: min(70%, 34rem);
		aspect-ratio: 1;
		transform: translateY(-50%);
		border-radius: 9999px;
		background: repeating-radial-gradient(
			circle,
			transparent 0 2.4rem,
			color-mix(in oklab, var(--primary-foreground) 14%, transparent) 2.4rem
				calc(2.4rem + 1px)
		);
		mask-image: radial-gradient(circle, #000 20%, transparent 72%);
		pointer-events: none;
	}
</style>
