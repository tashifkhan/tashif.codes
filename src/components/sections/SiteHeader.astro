---
import { ArrowUpRight } from "lucide-react";
import { owner, socials } from "../../data/profile";
import { leetCodeData } from "../../data/leetcode";

// The LeetCode profile supplies the tagline when it loaded; otherwise fall
// back to the statically configured one.
const { profile } = leetCodeData;
---

<header
	class="relative z-50 border-b border-border/60 bg-card/80 shadow-sm backdrop-blur supports-[backdrop-filter]:bg-card/70 dark:border-border/60 dark:bg-card/70 dark:supports-[backdrop-filter]:bg-card/60"
>
	<div class="relative mx-auto max-w-7xl px-4 py-3 sm:px-6 sm:py-4 lg:px-8">
		<div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5">
			<div
				class="inline-flex w-fit max-w-full items-center gap-3 rounded-[1.75rem] border border-border/60 bg-background/70 p-1.5 pr-4 shadow-sm backdrop-blur"
			>
				<span class="shrink-0 rounded-full bg-primary/80 p-[2px]">
					<img
						src={owner.avatar}
						alt={owner.name}
						class="block h-12 w-12 rounded-full object-cover object-top ring-2 ring-card sm:h-[52px] sm:w-[52px]"
					/>
				</span>
				<div class="flex min-w-0 flex-col">
					<h1
						class="truncate text-lg font-bold leading-tight tracking-tight text-foreground sm:text-xl"
						style="letter-spacing: -0.02em;"
					>
						{owner.name}
					</h1>
					<div class="mt-0.5 flex items-center gap-1.5">
						<span class="block h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
						<p class="truncate text-xs font-medium text-muted-foreground sm:text-sm">
							{profile.realName || owner.fallbackTitle}
						</p>
					</div>
				</div>
			</div>

			<nav
				aria-label="Social links"
				class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:gap-x-5 sm:border-l sm:border-border/60 sm:pl-5"
			>
				{
					socials.map((social) => (
						<a
							href={social.link}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.label}
							data-haptic-social
							class="group inline-flex items-center gap-1 rounded-sm font-mono text-[11px] font-medium tracking-wide text-muted-foreground transition-colors hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
						>
							{social.label}
							<ArrowUpRight className="h-3 w-3 text-muted-foreground/60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" />
						</a>
					))
				}
			</nav>
		</div>
	</div>
</header>

