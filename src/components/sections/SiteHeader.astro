---
import { owner, socials } from "../../data/profile";
import { leetCodeData } from "../../data/leetcode";
import { ArrowRight } from "lucide-react";

// The LeetCode profile supplies the tagline when it loaded; otherwise fall
// back to the statically configured one.
const { profile } = leetCodeData;
const role = profile.realName || owner.fallbackTitle;
---

<header data-site-header class="relative z-50">
	<div
		class="mx-auto flex max-w-7xl items-center gap-3 px-4 pb-3 pt-4 sm:px-6 md:py-4 lg:px-8"
	>
		<!-- Contact bubble: avatar, name and role in one glass capsule -->
		<div class="header-glass header-bubble flex min-w-0 items-center gap-3 rounded-full p-1.5 pr-5">
			<span class="relative shrink-0">
				<img
					src={owner.avatar}
					alt=""
					width="44"
					height="44"
					class="block h-11 w-11 rounded-full object-cover object-top"
				/>
				<span
					class="absolute bottom-0 right-0 h-3 w-3 rounded-full bg-primary ring-2 ring-card"
					aria-hidden="true"
				></span>
			</span>
			<div class="min-w-0">
				<p class="header-name truncate text-[1.0625rem] font-semibold leading-tight text-foreground">
					{owner.name}
				</p>
				<p class="truncate text-[0.8125rem] leading-snug text-muted-foreground">
					{role}
				</p>
			</div>
		</div>

		<!-- Social links plus the taf.sh studio link. Phones stack them beside
		     the bubble: GitHub and LinkedIn on top, taf.sh underneath. From sm
		     up they sit in one row with all four circles. -->
		<nav
			aria-label="Social links"
			class="header-socials ml-auto grid w-fit shrink-0 grid-cols-2 gap-1.5 sm:flex sm:items-center sm:gap-2"
		>
			<a
				href="https://taf.sh"
				target="_blank"
				rel="noopener noreferrer"
				style="--i:0"
				class="header-glass header-link header-studio group order-last col-span-2 inline-flex h-7 items-center justify-center gap-1.5 rounded-full px-3 font-mono text-xs text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:order-first sm:h-10 sm:px-4 sm:text-[0.8125rem]"
			>
				taf.sh
				<ArrowRight
					className="h-3.5 w-3.5 text-primary transition-transform duration-200 group-hover:translate-x-0.5"
					aria-hidden="true"
				/>
			</a>
			{
				socials.map((social, i) => {
					const isMail = social.link.startsWith("mailto:");
					return (
						<a
							href={social.link}
							target={isMail ? undefined : "_blank"}
							rel={isMail ? undefined : "noopener noreferrer"}
							data-haptic-social
							aria-label={social.label}
							title={social.label}
							style={`--i:${i + 1}`}
							class:list={[
								"header-glass header-link h-7 w-full shrink-0 items-center justify-center rounded-full text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:h-10 sm:w-10",
								i > 1 ? "hidden sm:inline-flex" : "inline-flex",
							]}
						>
							<social.icon className="h-3.5 w-3.5 sm:h-4 sm:w-4" aria-hidden="true" />
						</a>
					);
				})
			}
		</nav>
	</div>
</header>

<style>
	/* Liquid-glass capsules built from the skin tokens, so both skins and both
	   modes get the right tint without per-skin colours. */
	.header-glass {
		background: color-mix(in oklab, var(--card) 66%, transparent);
		border: 1px solid color-mix(in oklab, var(--foreground) 9%, transparent);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.6),
			var(--shadow-sm);
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
	}

	:global(.dark) .header-glass {
		background: color-mix(in oklab, var(--card) 58%, transparent);
		border-color: color-mix(in oklab, var(--foreground) 11%, transparent);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.07),
			0 14px 34px -18px rgb(0 0 0 / 0.8);
	}

	/* Simple headings are mono by default; the name reads as a contact card,
	   so it takes the body face. Studio's display rule still wins there. */
	.header-name {
		font-family: var(--font-sans);
		letter-spacing: -0.015em;
	}

	:global(html[data-skin="studio"]) .header-name {
		font-family: var(--font-display);
		font-weight: 650;
		letter-spacing: -0.035em;
	}

	.header-link {
		transition:
			background-color var(--motion-fast) var(--motion-ease),
			color var(--motion-fast) var(--motion-ease);
	}

	/* The old global nav rule stretches every nav to 100% on phones. The
	   social links are a small cluster, not a scrolling tab bar. */
	.header-socials {
		width: fit-content;
		overflow: visible;
	}

	.header-link:hover,
	.header-link:focus-visible {
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		color: var(--foreground);
	}

	@media (prefers-reduced-motion: no-preference) {
		.header-bubble {
			animation: header-pop 520ms cubic-bezier(0.34, 1.4, 0.64, 1) both;
		}

		.header-link {
			animation: header-fade 420ms var(--motion-ease) both;
			animation-delay: calc(140ms + var(--i, 0) * 50ms);
		}
	}

	@keyframes header-pop {
		from {
			opacity: 0;
			transform: scale(0.94);
		}
	}

	@keyframes header-fade {
		from {
			opacity: 0;
			transform: translateX(-6px);
		}
	}
</style>

<style is:global>
	/* The header floats on the page field; only the capsules carry glass.
	   Beats the studio skin's header bar rule. */
	html[data-skin] [data-site-header] {
		background: transparent;
		border: 0;
		box-shadow: none;
		backdrop-filter: none;
	}
</style>
