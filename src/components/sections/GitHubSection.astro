---
import GitHubStats from "../github/GitHubStats.astro";
import DataFreshness from "../common/DataFreshness";
import ProfileDropdown from "../github/ProfileDropdown";
import { Star, ChevronRight, ChevronDown } from "lucide-react";
import { starLists } from "../../data/starLists";
import { githubStats, githubStatsPersonal, githubFetchedAt } from "../../data/github";
import { slugify } from "../../lib/slugify";
import { formatTitle } from "../../lib/formatTitle";

const totalCommits = githubStats.stats?.totalCommits ?? 0;
const personalTotalCommits = githubStatsPersonal.stats?.totalCommits ?? 0;

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="github-section" class:list={["space-y-8", !active && "hidden"]}>
	<!-- Section heading (GitHub): single compact row -->
	<div class="flex items-center gap-x-2 sm:gap-x-3 min-w-0">
		<h2
			class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
		>
			GitHub
		</h2>
		<span
			class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground truncate min-w-0"
		>
			<span
				class="font-bold text-foreground tabular-nums"
				data-github-heading-commits
				data-value-all={totalCommits.toLocaleString()}
				data-value-personal={personalTotalCommits.toLocaleString()}
				>{totalCommits.toLocaleString()}</span
			>
			<span class="hidden sm:inline">commits</span>
		</span>
		<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
			<DataFreshness
				client:visible
				source="github"
				fetchedAt={githubFetchedAt}
				compact
			/>
			<ProfileDropdown client:visible />
			<a
				href="/github/stats"
				data-haptic-nav
				class="inline-flex items-center gap-0.5 text-xs font-semibold text-chart-3 hover:text-chart-3/80 transition-colors shrink-0"
				aria-label="Full GitHub stats page"
			>
				<span class="hidden sm:inline">Full Page</span>
				<span class="sm:hidden">Full</span>
				<ChevronRight className="w-3 h-3" />
			</a>
		</div>
	</div>

	<!-- Stats + Graph / Languages etc. -->
	<GitHubStats>
		<!-- Star Lists: expand a list to browse its repos; each repo opens the project detail page. -->
		<section
			slot="after-graph"
			class="rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm overflow-hidden"
			data-star-lists
		>
		<div class="px-4 sm:px-5 pt-3.5 pb-2.5 flex items-center gap-2">
			<Star className="w-3.5 h-3.5 text-muted-foreground shrink-0" />
			<span
				class="text-[10px] font-bold uppercase tracking-[0.18em] text-foreground/80 shrink-0"
			>
				Star Lists
			</span>
			<span
				class="hidden md:inline text-[10px] text-muted-foreground/60 truncate before:content-['·'] before:mr-1.5 before:text-muted-foreground/40"
			>
				pick a list to see its repos
			</span>
			<button
				data-open-projects
				class="ml-auto inline-flex items-center gap-0.5 text-[11px] font-semibold text-primary hover:text-primary/80 transition-colors shrink-0"
			>
				All projects
				<ChevronRight className="w-3 h-3" />
			</button>
		</div>
		{
			starLists.length > 0 ? (
				<div>
					<div class="p-4 sm:p-5 flex flex-wrap gap-2">
						{starLists.map((list) => {
							const repos = list.repositories || [];
							const count = list.num_repos ?? repos.length;
							return (
								<button
									type="button"
									data-star-list={list.name}
									aria-expanded="false"
									aria-controls={`star-list-panel-${slugify(list.name)}`}
									title={list.description || `Show repos in ${list.name}`}
									class="group inline-flex items-center gap-2 rounded-lg border border-border/60 bg-background/50 px-3 py-2 font-mono text-xs text-muted-foreground hover:text-foreground hover:border-primary/40 hover:bg-primary/5 transition-colors aria-expanded:text-foreground aria-expanded:border-primary/50 aria-expanded:bg-primary/5"
								>
									<Star className="w-3 h-3 text-primary/60 transition-colors group-hover:text-primary group-aria-expanded:text-primary" />
									<span class="font-medium">{list.name}</span>
									{count > 0 && (
										<span class="rounded-full bg-secondary/80 px-1.5 py-0.5 text-[10px] leading-none tabular-nums text-muted-foreground/80 transition-colors group-hover:text-primary group-aria-expanded:text-primary">
											{count}
										</span>
									)}
									<ChevronDown className="w-3 h-3 text-muted-foreground/60 transition-transform duration-200 group-aria-expanded:rotate-180 group-aria-expanded:text-primary" />
								</button>
							);
						})}
					</div>
					{starLists.map((list) => {
						const repos = list.repositories || [];
						return (
							<div
								id={`star-list-panel-${slugify(list.name)}`}
								data-star-list-panel
								hidden
								class="star-list-panel border-t border-border/40 px-4 sm:px-5 pt-3 pb-4"
							>
								{list.description && (
									<p class="mb-1 text-[11px] leading-relaxed text-muted-foreground/45">
										{list.description}
									</p>
								)}
								{repos.length > 0 ? (
									<ul class="max-h-72 overflow-y-auto overscroll-contain grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8">
										{repos.map((fullName) => {
											const parts = fullName.split("/");
											const ownerName = parts[0] || "";
											const repoName = parts[parts.length - 1] || fullName;
											const projectSlug = slugify(repoName);
											const label = formatTitle(repoName);
											const isExternal =
												ownerName &&
												ownerName.toLowerCase() !== "tashifkhan";
											return (
												<li class="border-b border-border/20">
													<a
														href={`/projects/${projectSlug}`}
														data-haptic-nav
														title={fullName}
														class="group/repo flex items-center gap-2 py-2 text-[11px] text-muted-foreground/75 hover:text-foreground transition-colors"
													>
														<span class="min-w-0 flex-1 truncate">
															{label}
														</span>
														{isExternal && (
															<span class="shrink-0 font-mono text-[10px] text-muted-foreground/30">
																{ownerName}
															</span>
														)}
														<ChevronRight className="w-3 h-3 shrink-0 text-primary opacity-0 -translate-x-1 group-hover/repo:opacity-100 group-hover/repo:translate-x-0 transition-all" />
													</a>
												</li>
											);
										})}
									</ul>
								) : (
									<p class="text-[11px] text-muted-foreground/50">
										No repositories in this list yet.
									</p>
								)}
							</div>
						);
					})}
				</div>
			) : (
				<p class="p-4 sm:p-5 text-xs text-muted-foreground leading-relaxed">
					Curated repository lists will show up here once they load —
					open a list to browse its repos and jump to a project page.
				</p>
			)
		}
		</section>
	</GitHubStats>
</div>

<style>
	/* Star list repo panel eases open when its chip is clicked */
	.star-list-panel {
		animation: star-list-in 0.18s ease-out;
	}

	@keyframes star-list-in {
		from {
			opacity: 0;
			transform: translateY(-3px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star-list-panel {
			animation: none;
		}
	}
</style>
