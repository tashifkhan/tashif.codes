---
import GitHubStats from "../github/GitHubStats.astro";
import DataFreshness from "../common/DataFreshness";
import ProfileDropdown from "../github/ProfileDropdown";
import { Star, ChevronRight, ChevronDown } from "lucide-react";
import { starLists } from "../../data/starLists";
import { githubStats, githubStatsPersonal, githubFetchedAt } from "../../data/github";
import { slugify } from "../../lib/slugify";
import { formatTitle } from "../../lib/formatTitle";

const totalCommits = githubStats.stats?.totalCommits ?? 0;
const personalTotalCommits = githubStatsPersonal.stats?.totalCommits ?? 0;

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="github-section" class:list={["space-y-6 sm:space-y-8 rise-in", !active && "hidden"]}>
	<!-- Section heading: title + commit count, then labelled actions.
	     Actions drop to their own row on phones instead of squeezing. -->
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
		<div class="flex min-w-0 items-baseline gap-2.5">
			<h2 class="font-sans text-xl font-bold tracking-tight text-foreground shrink-0">
				GitHub
			</h2>
			<p class="min-w-0 truncate text-sm text-muted-foreground">
				<span
					class="font-mono font-semibold text-foreground tabular-nums"
					data-github-heading-commits
					data-value-all={totalCommits.toLocaleString()}
					data-value-personal={personalTotalCommits.toLocaleString()}
					>{totalCommits.toLocaleString()}</span
				>
				commits
			</p>
		</div>
		<div class="flex flex-wrap items-center gap-2 sm:ml-auto">
			<DataFreshness
				client:visible
				source="github"
				fetchedAt={githubFetchedAt}
				compact
				className="h-9 max-w-none px-3 text-xs sm:h-9 sm:text-xs"
			/>
			<ProfileDropdown client:visible />
			<a
				href="/github/stats"
				data-haptic-nav
				class="inline-flex h-9 items-center gap-1 rounded-full bg-primary/10 pl-3.5 pr-2.5 text-[13px] font-semibold text-primary transition-colors hover:bg-primary/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				All stats
				<ChevronRight className="w-3.5 h-3.5" />
			</a>
		</div>
	</div>

	<!-- Stats + Graph / Languages etc. -->
	<GitHubStats>
		<!-- Star Lists: expand a list to browse its repos; each repo opens the project detail page. -->
		<section
			slot="after-graph"
			class="rounded-xl border border-border/60 bg-card/60 backdrop-blur-sm overflow-hidden"
			data-star-lists
		>
		<div class="px-4 sm:px-5 pt-3 pb-1 flex items-center gap-2">
			<div class="min-w-0">
				<h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-tight text-foreground">
					<Star className="w-4 h-4 text-muted-foreground shrink-0" aria-hidden="true" />
					Star lists
				</h3>
				<p class="mt-0.5 text-xs text-muted-foreground">Pick a list to see its repos</p>
			</div>
			<button
				type="button"
				data-open-projects
				class="ml-auto -mr-2 inline-flex h-9 items-center gap-0.5 rounded-full px-3 text-[13px] font-semibold text-primary hover:bg-primary/10 transition-colors shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				All projects
				<ChevronRight className="w-3.5 h-3.5" />
			</button>
		</div>
		{
			starLists.length > 0 ? (
				<div>
					<div class="p-4 sm:p-5 flex flex-wrap gap-2">
						{starLists.map((list) => {
							const repos = list.repositories || [];
							const count = list.num_repos ?? repos.length;
							return (
								<button
									type="button"
									data-star-list={list.name}
									aria-expanded="false"
									aria-controls={`star-list-panel-${slugify(list.name)}`}
									title={list.description || `Show repos in ${list.name}`}
									class="group inline-flex min-h-10 max-w-full items-center gap-2 rounded-full border border-border/60 bg-background/50 px-3.5 py-2 text-left text-[13px] text-muted-foreground hover:text-foreground hover:border-primary/40 hover:bg-primary/5 transition-colors aria-expanded:text-foreground aria-expanded:border-primary/50 aria-expanded:bg-primary/5"
								>
									<Star className="w-3 h-3 text-primary/60 transition-colors group-hover:text-primary group-aria-expanded:text-primary" />
									<span class="min-w-0 font-medium">{list.name}</span>
									{count > 0 && (
										<span class="rounded-full bg-secondary/80 px-1.5 py-0.5 text-[10px] leading-none tabular-nums text-muted-foreground/80 transition-colors group-hover:text-primary group-aria-expanded:text-primary">
											{count}
										</span>
									)}
									<ChevronDown className="w-3 h-3 text-muted-foreground/60 transition-transform duration-200 group-aria-expanded:rotate-180 group-aria-expanded:text-primary" />
								</button>
							);
						})}
					</div>
					{starLists.map((list) => {
						const repos = list.repositories || [];
						return (
							<div
								id={`star-list-panel-${slugify(list.name)}`}
								data-star-list-panel
								hidden
								class="star-list-panel border-t border-border/40 px-4 sm:px-5 pt-3 pb-4"
							>
								{list.description && (
									<p class="mb-1 text-xs leading-relaxed text-muted-foreground">
										{list.description}
									</p>
								)}
								{repos.length > 0 ? (
									<ul class="max-h-72 overflow-y-auto overscroll-contain grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8">
										{repos.map((fullName) => {
											const parts = fullName.split("/");
											const ownerName = parts[0] || "";
											const repoName = parts[parts.length - 1] || fullName;
											const projectSlug = slugify(repoName);
											const label = formatTitle(repoName);
											const isExternal =
												ownerName &&
												ownerName.toLowerCase() !== "tashifkhan";
											return (
												<li class="border-b border-border/20">
													<a
														href={`/projects/${projectSlug}`}
														data-haptic-nav
														title={fullName}
														class="group/repo flex min-h-11 items-center gap-2 py-2 text-sm text-foreground/85 hover:text-foreground transition-colors"
													>
														<span class="min-w-0 flex-1 truncate">
															{label}
														</span>
														{isExternal && (
															<span class="shrink-0 font-mono text-[11px] text-muted-foreground">
																{ownerName}
															</span>
														)}
														<ChevronRight className="w-3.5 h-3.5 shrink-0 text-primary opacity-60 md:opacity-0 md:-translate-x-1 group-hover/repo:opacity-100 group-hover/repo:translate-x-0 transition-all" />
													</a>
												</li>
											);
										})}
									</ul>
								) : (
									<p class="text-xs text-muted-foreground">
										No repositories in this list yet.
									</p>
								)}
							</div>
						);
					})}
				</div>
			) : (
				<p class="p-4 sm:p-5 text-xs text-muted-foreground leading-relaxed">
					Curated repository lists will show up here once they load —
					open a list to browse its repos and jump to a project page.
				</p>
			)
		}
		</section>
	</GitHubStats>
</div>

<style>
	/* Star list repo panel eases open when its chip is clicked */
	.star-list-panel {
		animation: star-list-in 0.18s ease-out;
	}

	@keyframes star-list-in {
		from {
			opacity: 0;
			transform: translateY(-3px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star-list-panel {
			animation: none;
		}
	}
</style>
