---
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Github, Twitter, Linkedin, Mail, ArrowUpRight } from "lucide-react";
import { socials, githubProfiles } from "../../data/profile";

const socialLink = (label: string) =>
	socials.find((s) => s.label === label)?.link ?? "#";

const emailAddress = socialLink("Email").replace(/^mailto:/, "");

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="community-section" class:list={["rise-in", !active && "hidden"]}>
	<div class="mb-10">
		<p class="font-mono text-[0.625rem] uppercase tracking-[0.18em] text-primary">
			contact / 06
		</p>
		<h2
			class="mt-3 font-sans text-4xl font-bold tracking-tight text-foreground pb-1 sm:text-5xl"
		>
			Let's <span class="text-primary">connect.</span>
		</h2>
		<p class="mt-3 text-lg text-muted-foreground max-w-2xl">
			Got a project, an idea, or a question? Send it over.
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
		<!-- GitHub -->
		<a
			href={socialLink("GitHub")}
			data-haptic-social
			data-social-card
			target="_blank"
			rel="noopener noreferrer"
			class="group relative overflow-hidden rounded-2xl border border-border/60 bg-card/60 backdrop-blur p-6 sm:p-8 motion-card hover:border-primary/40 hover:shadow-lg lg:col-span-2"
		>
			<div
				data-social-mark
				class="absolute -right-6 -bottom-8 opacity-[0.04] group-hover:opacity-[0.09] transition-opacity duration-300 rotate-12 pointer-events-none"
			>
				<Github className="w-40 h-40 text-foreground" />
			</div>
			<div class="relative z-10">
				<div class="flex items-start justify-between">
					<div
						data-social-icon
						class="h-11 w-11 rounded-xl bg-foreground text-background flex items-center justify-center"
					>
						<Github className="w-5 h-5" />
					</div>
					<ArrowUpRight
						className="motion-card-arrow w-5 h-5 text-muted-foreground opacity-0 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-[opacity,translate] duration-200"
					/>
				</div>
				<h3 class="mt-6 font-sans text-xl font-semibold text-foreground">
					GitHub
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Check out my open source contributions and latest code.
				</p>
				<p class="mt-3 font-mono text-xs text-muted-foreground">
					@{githubProfiles[0].handle}
				</p>
			</div>
		</a>

		<!-- Twitter -->
		<a
			href={socialLink("Twitter")}
			data-haptic-social
			data-social-card
			target="_blank"
			rel="noopener noreferrer"
			class="group relative overflow-hidden rounded-2xl border border-border/60 bg-card/60 backdrop-blur p-6 sm:p-8 motion-card hover:border-sky-500/40 hover:shadow-lg lg:col-span-1"
		>
			<div
				data-social-mark
				class="absolute -right-6 -bottom-8 opacity-[0.05] group-hover:opacity-[0.1] transition-opacity duration-300 rotate-12 pointer-events-none"
			>
				<Twitter className="w-32 h-32 text-sky-500" />
			</div>
			<div class="relative z-10">
				<div class="flex items-start justify-between">
					<div
						data-social-icon
						class="h-11 w-11 rounded-xl bg-sky-500/15 text-sky-500 border border-sky-500/20 flex items-center justify-center"
					>
						<Twitter className="w-5 h-5" />
					</div>
					<ArrowUpRight
						className="motion-card-arrow w-5 h-5 text-muted-foreground opacity-0 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-[opacity,translate] duration-200"
					/>
				</div>
				<h3 class="mt-6 font-sans text-xl font-semibold text-foreground">
					Twitter
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Tech insights & updates
				</p>
			</div>
		</a>

		<!-- LinkedIn -->
		<a
			href={socialLink("LinkedIn")}
			data-haptic-social
			data-social-card
			target="_blank"
			rel="noopener noreferrer"
			class="group relative overflow-hidden rounded-2xl border border-border/60 bg-card/60 backdrop-blur p-6 sm:p-8 motion-card hover:border-blue-500/40 hover:shadow-lg lg:col-span-1"
		>
			<div
				data-social-mark
				class="absolute -right-6 -bottom-8 opacity-[0.05] group-hover:opacity-[0.1] transition-opacity duration-300 rotate-12 pointer-events-none"
			>
				<Linkedin className="w-32 h-32 text-blue-500" />
			</div>
			<div class="relative z-10">
				<div class="flex items-start justify-between">
					<div
						data-social-icon
						class="h-11 w-11 rounded-xl bg-blue-500/15 text-blue-500 border border-blue-500/20 flex items-center justify-center"
					>
						<Linkedin className="w-5 h-5" />
					</div>
					<ArrowUpRight
						className="motion-card-arrow w-5 h-5 text-muted-foreground opacity-0 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-[opacity,translate] duration-200"
					/>
				</div>
				<h3 class="mt-6 font-sans text-xl font-semibold text-foreground">
					LinkedIn
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Professional network
				</p>
			</div>
		</a>
	</div>

	<!-- taf.sh studio reference -->
	<a
		href="https://taf.sh"
		target="_blank"
		rel="noopener noreferrer"
		data-haptic-external
		class="group relative mb-16 block overflow-hidden rounded-2xl border border-primary/25 bg-primary/5 p-6 motion-card hover:border-primary/50 sm:p-8"
	>
		<div
			class="pointer-events-none absolute -right-6 -bottom-10 select-none font-mono text-[10rem] leading-none text-primary opacity-[0.06] transition-opacity duration-300 group-hover:opacity-[0.1]"
			aria-hidden="true"
		>
			&gt;
		</div>
		<div class="relative z-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
			<div class="min-w-0">
				<p class="font-mono text-[0.625rem] uppercase tracking-[0.18em] text-primary">
					taf.sh / independent studio
				</p>
				<h3 class="mt-2 font-sans text-2xl font-semibold tracking-tight text-foreground">
					Products, AI systems, and client work.
				</h3>
				<p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground">
					The studio behind TalentSync, rah.clinic, and select client builds.
					The full story lives at taf.sh.
				</p>
			</div>
			<span
				class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-transform group-hover:-translate-y-0.5 sm:self-auto"
			>
				Visit taf.sh
				<ArrowUpRight className="h-4 w-4" />
			</span>
		</div>
	</a>

	<!-- Contact Me Form & Email CTA -->
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<!-- Email Card -->
		<div
			class="relative flex flex-col overflow-hidden rounded-2xl border border-primary/25 bg-primary/5 p-6 sm:p-8 lg:col-span-1"
		>
			<div
				class="absolute -top-16 -right-16 h-48 w-48 rounded-full bg-primary/10 blur-3xl pointer-events-none"
			>
			</div>
			<div class="relative z-10 flex flex-1 flex-col">
				<div
					class="h-12 w-12 rounded-xl bg-primary/15 text-primary border border-primary/20 flex items-center justify-center mb-6"
				>
					<Mail className="w-6 h-6" />
				</div>
				<h3
					class="font-sans text-2xl font-bold text-foreground mb-3 tracking-tight"
				>
					Email Me
				</h3>
				<p class="text-muted-foreground leading-relaxed text-sm">
					Prefer email? Send me a direct message and I'll get back to you
					as soon as possible.
				</p>
				<a
					href={socialLink("Email")}
					data-haptic-external
					class="mt-5 inline-flex items-center gap-2 font-mono text-sm text-primary hover:underline"
				>
					{emailAddress}
				</a>
				<p class="mt-4 text-xs leading-5 text-muted-foreground">
					For project inquiries, include what you're building and your
					timeline.
				</p>
				<a
					href={socialLink("Email")}
					data-haptic-external
					class="mt-auto inline-flex items-center justify-center w-full px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-xl hover:bg-primary/90 shadow-lg shadow-primary/20 transition-colors"
				>
					Send Email
				</a>
			</div>
		</div>

		<!-- Form -->
		<Card
			className="lg:col-span-2 border border-border/60 shadow-lg bg-card/60 backdrop-blur-xl rounded-2xl"
		>
			<CardContent className="p-8">
				<div class="mb-6">
					<h3
						class="font-sans text-2xl font-bold text-foreground mb-2 tracking-tight"
					>
						Send a Message
					</h3>
					<p class="text-muted-foreground">Drop a quick note below.</p>
				</div>
				<form id="contact-form" class="space-y-6" autocomplete="on">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						<div class="space-y-2">
							<Label
								htmlFor="contact-name"
								className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
								>Name</Label
							>
							<Input
								id="contact-name"
								name="name"
								type="text"
								placeholder="Your name"
								className="h-11 rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20"
							/>
						</div>
						<div class="space-y-2">
							<Label
								htmlFor="contact-email"
								className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
								>Email</Label
							>
							<Input
								id="contact-email"
								name="email"
								type="email"
								required
								placeholder="you@example.com"
								className="h-11 rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20"
							/>
						</div>
					</div>
					<div class="space-y-2">
						<Label
							htmlFor="contact-subject"
							className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
							>Subject</Label
						>
						<Input
							id="contact-subject"
							name="subject"
							type="text"
							placeholder="What's this about?"
							className="h-11 rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20"
						/>
					</div>
					<div class="space-y-2">
						<Label
							htmlFor="contact-message"
							className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
							>Message</Label
						>
						<Textarea
							id="contact-message"
							name="message"
							required
							rows={5}
							placeholder="Write your message here..."
							className="resize-y rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20 p-4"
						/>
					</div>
					<div class="flex justify-end">
						<Button
							type="submit"
							size="lg"
							className="rounded-xl px-8 bg-primary hover:bg-primary/90 text-primary-foreground shadow-lg shadow-primary/25"
						>
							Send Message
						</Button>
					</div>
				</form>
			</CardContent>
		</Card>
	</div>
</div>
