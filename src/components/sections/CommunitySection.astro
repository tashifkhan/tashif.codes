---
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import { Github, Twitter, Linkedin, Mail, ArrowUpRight } from "lucide-react";
import { socials, githubProfiles } from "../../data/profile";

const socialLink = (label: string) =>
	socials.find((s) => s.label === label)?.link ?? "#";

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="community-section" class:list={[!active && "hidden"]}>
	<div class="mb-10">
		<h2
			class="font-sans text-4xl font-bold tracking-tight bg-gradient-to-r from-primary to-orange-400 bg-clip-text text-transparent mb-4 pb-1"
		>
			Let's Connect
		</h2>
		<p class="text-lg text-muted-foreground max-w-2xl">
			I'm always open to discussing new projects, creative ideas or
			opportunities to be part of your visions.
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
		<!-- GitHub -->
		<a
			href={socialLink("GitHub")}
			data-haptic-social
			target="_blank"
			rel="noopener noreferrer"
			class="group relative overflow-hidden rounded-2xl border border-border/60 bg-card/60 backdrop-blur p-6 sm:p-8 transition-all duration-300 hover:border-primary/40 hover:shadow-lg hover:-translate-y-0.5 lg:col-span-2"
		>
			<div
				class="absolute -right-6 -bottom-8 opacity-[0.04] group-hover:opacity-[0.09] transition-opacity duration-300 rotate-12 pointer-events-none"
			>
				<Github className="w-40 h-40 text-foreground" />
			</div>
			<div class="relative z-10">
				<div class="flex items-start justify-between">
					<div
						class="h-11 w-11 rounded-xl bg-foreground text-background flex items-center justify-center"
					>
						<Github className="w-5 h-5" />
					</div>
					<ArrowUpRight
						className="w-5 h-5 text-muted-foreground opacity-0 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300"
					/>
				</div>
				<h3 class="mt-6 font-sans text-xl font-semibold text-foreground">
					GitHub
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Check out my open source contributions and latest code.
				</p>
				<p class="mt-3 font-mono text-xs text-muted-foreground">
					@{githubProfiles[0].handle}
				</p>
			</div>
		</a>

		<!-- Twitter -->
		<a
			href={socialLink("Twitter")}
			data-haptic-social
			target="_blank"
			rel="noopener noreferrer"
			class="group relative overflow-hidden rounded-2xl border border-border/60 bg-card/60 backdrop-blur p-6 sm:p-8 transition-all duration-300 hover:border-sky-500/40 hover:shadow-lg hover:-translate-y-0.5 lg:col-span-1"
		>
			<div
				class="absolute -right-6 -bottom-8 opacity-[0.05] group-hover:opacity-[0.1] transition-opacity duration-300 rotate-12 pointer-events-none"
			>
				<Twitter className="w-32 h-32 text-sky-500" />
			</div>
			<div class="relative z-10">
				<div class="flex items-start justify-between">
					<div
						class="h-11 w-11 rounded-xl bg-sky-500/15 text-sky-500 border border-sky-500/20 flex items-center justify-center"
					>
						<Twitter className="w-5 h-5" />
					</div>
					<ArrowUpRight
						className="w-5 h-5 text-muted-foreground opacity-0 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300"
					/>
				</div>
				<h3 class="mt-6 font-sans text-xl font-semibold text-foreground">
					Twitter
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Tech insights & updates
				</p>
			</div>
		</a>

		<!-- LinkedIn -->
		<a
			href={socialLink("LinkedIn")}
			data-haptic-social
			target="_blank"
			rel="noopener noreferrer"
			class="group relative overflow-hidden rounded-2xl border border-border/60 bg-card/60 backdrop-blur p-6 sm:p-8 transition-all duration-300 hover:border-blue-500/40 hover:shadow-lg hover:-translate-y-0.5 lg:col-span-1"
		>
			<div
				class="absolute -right-6 -bottom-8 opacity-[0.05] group-hover:opacity-[0.1] transition-opacity duration-300 rotate-12 pointer-events-none"
			>
				<Linkedin className="w-32 h-32 text-blue-500" />
			</div>
			<div class="relative z-10">
				<div class="flex items-start justify-between">
					<div
						class="h-11 w-11 rounded-xl bg-blue-500/15 text-blue-500 border border-blue-500/20 flex items-center justify-center"
					>
						<Linkedin className="w-5 h-5" />
					</div>
					<ArrowUpRight
						className="w-5 h-5 text-muted-foreground opacity-0 -translate-x-1 translate-y-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:translate-y-0 transition-all duration-300"
					/>
				</div>
				<h3 class="mt-6 font-sans text-xl font-semibold text-foreground">
					LinkedIn
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					Professional network
				</p>
			</div>
		</a>
	</div>

	<!-- Contact Me Form & Email CTA -->
	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<!-- Email Card -->
		<div
			class="relative overflow-hidden rounded-2xl border border-primary/25 bg-primary/5 p-8 lg:col-span-1 hidden md:flex flex-col justify-center"
		>
			<div
				class="absolute -top-16 -right-16 h-48 w-48 rounded-full bg-primary/10 blur-3xl pointer-events-none"
			>
			</div>
			<div class="relative z-10">
				<div
					class="h-12 w-12 rounded-xl bg-primary/15 text-primary border border-primary/20 flex items-center justify-center mb-6"
				>
					<Mail className="w-6 h-6" />
				</div>
				<h3
					class="font-sans text-2xl font-bold text-foreground mb-3 tracking-tight"
				>
					Email Me
				</h3>
				<p class="text-muted-foreground mb-8 leading-relaxed text-sm">
					Prefer email? Send me a direct message and I'll get back to you
					as soon as possible.
				</p>
				<a
					href={socialLink("Email")}
					data-haptic-external
					class="inline-flex items-center justify-center w-full px-6 py-3 bg-primary text-primary-foreground font-semibold rounded-xl hover:bg-primary/90 shadow-lg shadow-primary/20 transition-colors"
				>
					Send Email
				</a>
			</div>
		</div>

		<!-- Form -->
		<Card
			className="lg:col-span-2 border border-border/60 shadow-lg bg-card/60 backdrop-blur-xl rounded-2xl"
		>
			<CardContent className="p-8">
				<div class="mb-6">
					<h3
						class="font-sans text-2xl font-bold text-foreground mb-2 tracking-tight"
					>
						Send a Message
					</h3>
					<p class="text-muted-foreground">Drop a quick note below.</p>
				</div>
				<form id="contact-form" class="space-y-6" autocomplete="on">
					<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
						<div class="space-y-2">
							<Label
								htmlFor="contact-name"
								className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
								>Name</Label
							>
							<Input
								id="contact-name"
								name="name"
								type="text"
								placeholder="Your name"
								className="h-11 rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20"
							/>
						</div>
						<div class="space-y-2">
							<Label
								htmlFor="contact-email"
								className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
								>Email</Label
							>
							<Input
								id="contact-email"
								name="email"
								type="email"
								required
								placeholder="you@example.com"
								className="h-11 rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20"
							/>
						</div>
					</div>
					<div class="space-y-2">
						<Label
							htmlFor="contact-subject"
							className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
							>Subject</Label
						>
						<Input
							id="contact-subject"
							name="subject"
							type="text"
							placeholder="What's this about?"
							className="h-11 rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20"
						/>
					</div>
					<div class="space-y-2">
						<Label
							htmlFor="contact-message"
							className="text-sm font-medium text-muted-foreground dark:text-muted-foreground"
							>Message</Label
						>
						<Textarea
							id="contact-message"
							name="message"
							required
							rows={5}
							placeholder="Write your message here..."
							className="resize-y rounded-xl bg-muted dark:bg-secondary/50 border-border dark:border-border focus:ring-2 focus:ring-primary/20 p-4"
						/>
					</div>
					<div class="flex justify-end">
						<Button
							type="submit"
							size="lg"
							className="rounded-xl px-8 bg-primary hover:bg-primary/90 text-primary-foreground shadow-lg shadow-primary/25"
						>
							Send Message
						</Button>
					</div>
				</form>
			</CardContent>
		</Card>
	</div>
</div>
