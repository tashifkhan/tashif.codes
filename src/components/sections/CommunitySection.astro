---
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Label } from "@/components/ui/label";
import {
	Github,
	Twitter,
	Linkedin,
	Mail,
	ArrowUpRight,
} from "lucide-react";
import { socials, githubProfiles } from "../../data/profile";

const socialLink = (label: string) =>
	socials.find((s) => s.label === label)?.link ?? "#";

const emailAddress = socialLink("Email").replace(/^mailto:/, "");

const socialCards = [
	{
		label: "GitHub",
		href: socialLink("GitHub"),
		icon: Github,
		detail: `@${githubProfiles[0].handle}`,
		markClass: "text-foreground",
	},
	{
		label: "Twitter",
		href: socialLink("Twitter"),
		icon: Twitter,
		detail: "Tech insights & updates",
		markClass: "text-sky-500",
	},
	{
		label: "LinkedIn",
		href: socialLink("LinkedIn"),
		icon: Linkedin,
		detail: "Professional network",
		markClass: "text-blue-500",
	},
	{
		label: "Email",
		href: socialLink("Email"),
		icon: Mail,
		detail: emailAddress,
		markClass: "text-primary",
	},
];

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div
	id="community-section"
	class:list={[
		"rise-in pb-16 sm:pb-20",
		!active && "hidden",
	]}
>
	<div class="mb-8 sm:mb-10">
		<p class="font-mono text-[11px] tracking-[0.08em] text-primary">
			Contact / 06
		</p>
		<h2
			class="mt-3 font-sans text-4xl font-bold tracking-tight text-foreground pb-1 sm:text-5xl"
		>
			Let's <span class="text-primary">connect.</span>
		</h2>
		<p class="mt-3 max-w-2xl text-lg text-muted-foreground">
			Got a project, an idea, or a question? Send it over. I usually reply
			within a day.
		</p>
	</div>

	<p class="mb-2.5 text-xs font-medium tracking-wide text-muted-foreground">
		Find me online
	</p>
	<div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
		{
			socialCards.map(
				({ label, href, icon: Icon, detail, markClass }) => (
					<a
						href={href}
						data-haptic-social
						data-social-card
						target="_blank"
						rel="noopener noreferrer"
						class="group relative flex min-w-0 items-center gap-3 overflow-hidden rounded-2xl border border-border/60 bg-card/60 p-4 backdrop-blur motion-card hover:border-primary/40 hover:bg-card/80"
					>
						<span
							data-social-mark
							aria-hidden="true"
							class:list={[
								"pointer-events-none absolute -right-5 -bottom-6 select-none opacity-[0.04] transition-all duration-300 group-hover:scale-110 group-hover:opacity-[0.09]",
								markClass,
							]}
						>
							<Icon className="h-28 w-28" />
						</span>
						<span class="relative z-10 min-w-0 flex-1">
							<span class="block truncate text-sm font-semibold text-foreground">
								{label}
							</span>
							<span class="mt-0.5 hidden truncate text-xs text-muted-foreground sm:block">
								{detail}
							</span>
						</span>
						<ArrowUpRight className="relative z-10 hidden h-4 w-4 shrink-0 text-muted-foreground/70 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 sm:block" />
					</a>
				),
			)
		}
	</div>

	<!-- taf.sh studio banner -->
	<a
		href="https://taf.sh"
		target="_blank"
		rel="noopener noreferrer"
		data-haptic-external
		class="group relative mt-4 block overflow-hidden rounded-2xl border border-primary/25 bg-primary/5 p-6 motion-card hover:border-primary/50 sm:p-8"
	>
		<div
			class="pointer-events-none absolute -right-6 -bottom-10 select-none font-mono text-[10rem] leading-none text-primary opacity-[0.06] transition-opacity duration-300 group-hover:opacity-[0.1]"
			aria-hidden="true"
		>
			&gt;
		</div>
		<div
			class="relative z-10 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
		>
			<div class="min-w-0">
				<p class="font-mono text-[11px] tracking-[0.06em] text-primary">
					taf.sh / independent studio
				</p>
				<h3
					class="mt-1 font-sans text-xl font-semibold tracking-tight text-foreground"
				>
					Products, AI systems, and client work.
				</h3>
				<p class="mt-1 max-w-2xl text-sm leading-6 text-muted-foreground">
					The studio behind TalentSync, rah.clinic, and select client
					builds. The full story lives at taf.sh.
				</p>
			</div>
			<span
				class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-transform group-hover:-translate-y-0.5 sm:self-auto"
			>
				Visit taf.sh
				<ArrowUpRight className="h-4 w-4" />
			</span>
		</div>
	</a>

	<div
		class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1.55fr)_minmax(16rem,0.9fr)] lg:items-start"
	>
		<Card
			className="rounded-2xl border border-border/60 bg-card/80 shadow-sm backdrop-blur-xl"
		>
			<CardContent className="p-5 sm:p-7">
				<div class="border-b border-border/60 pb-6">
					<h3
						class="font-sans text-xl font-bold tracking-tight text-foreground sm:text-2xl"
					>
						Send a message
					</h3>
					<p class="mt-1 text-sm leading-6 text-muted-foreground">
						Drop a quick note and I'll get back to you.
					</p>
				</div>

				<form id="contact-form" class="mt-5 space-y-5" autocomplete="on">
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						<div class="space-y-2">
							<Label
								htmlFor="contact-name"
								className="text-sm font-medium text-foreground"
								>Name</Label
							>
							<Input
								id="contact-name"
								name="name"
								type="text"
								placeholder="Your name"
								className="h-11 rounded-xl border-border/70 bg-background/60 focus:ring-2 focus:ring-primary/20"
							/>
						</div>
						<div class="space-y-2">
							<Label
								htmlFor="contact-email"
								className="text-sm font-medium text-foreground"
								>Email</Label
							>
							<Input
								id="contact-email"
								name="email"
								type="email"
								required
								placeholder="you@example.com"
								className="h-11 rounded-xl border-border/70 bg-background/60 focus:ring-2 focus:ring-primary/20"
							/>
						</div>
					</div>
					<div class="space-y-2">
						<Label
							htmlFor="contact-subject"
							className="text-sm font-medium text-foreground"
							>Subject</Label
						>
						<Input
							id="contact-subject"
							name="subject"
							type="text"
							placeholder="What's this about?"
							className="h-11 rounded-xl border-border/70 bg-background/60 focus:ring-2 focus:ring-primary/20"
						/>
					</div>
					<div class="space-y-2">
						<Label
							htmlFor="contact-message"
							className="text-sm font-medium text-foreground"
							>Message</Label
						>
						<Textarea
							id="contact-message"
							name="message"
							required
							rows={5}
							placeholder="Write your message here..."
							className="resize-y rounded-xl border-border/70 bg-background/60 p-4 focus:ring-2 focus:ring-primary/20"
						/>
					</div>
					<div
						class="flex flex-col gap-4 border-t border-border/60 pt-5 sm:flex-row sm:items-center sm:justify-between"
					>
						<p
							id="contact-status"
							aria-live="polite"
							class="text-xs leading-5 text-muted-foreground sm:max-w-sm"
						>
							For project inquiries, include what you're building and
							your timeline.
						</p>
						<Button
							type="submit"
							size="lg"
							className="w-full rounded-xl bg-primary px-6 text-primary-foreground shadow-lg shadow-primary/20 hover:bg-primary/90 sm:w-auto"
						>
							Send message
						</Button>
					</div>
				</form>
			</CardContent>
		</Card>

		<div class="flex flex-col gap-4">
			<div
				class="rounded-2xl border border-border/60 bg-card/80 p-5 backdrop-blur"
			>
				<div
					class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary"
				>
					<Mail className="h-5 w-5" />
				</div>
				<h3
					class="mt-4 font-sans text-lg font-semibold tracking-tight text-foreground"
				>
					Prefer email?
				</h3>
				<p class="mt-1.5 text-sm leading-6 text-muted-foreground">
					Send a direct message and I'll get back to you within a day.
				</p>
				<a
					href={socialLink("Email")}
					data-haptic-external
					class="mt-3 inline-flex font-mono text-sm text-primary hover:underline"
				>
					{emailAddress}
				</a>
			</div>
		</div>
	</div>
</div>
