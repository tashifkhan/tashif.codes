---
import LeetCodeStats from "../leetcode/LeetCodeStats.astro";
import LeetCodeContests from "../leetcode/LeetCodeContests.astro";
import LeetCodeBadges from "../leetcode/LeetCodeBadges.astro";
import DataFreshness from "../common/DataFreshness";
import { ExternalLink, ChevronRight } from "lucide-react";
import { leetCodeData, leetCodeFetchedAt } from "../../data/leetcode";

const totalSolved = leetCodeData?.stats?.totalSolved ?? 0;

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="leetcode-section" class:list={["space-y-6 sm:space-y-8 rise-in", !active && "hidden"]}>
	<!-- Section heading: title + solved count, then labelled actions.
	     Actions drop to their own row on phones instead of squeezing. -->
	<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
		<div class="flex min-w-0 items-baseline gap-2.5">
			<h2
				class="font-sans text-xl font-bold tracking-tight text-foreground shrink-0"
			>
				LeetCode
			</h2>
			<p class="min-w-0 truncate text-sm text-muted-foreground">
				<span
					class="font-mono font-semibold text-foreground tabular-nums"
					data-lc-heading-solved
					>{totalSolved}</span
				>
				solved
			</p>
		</div>
		<div class="flex flex-wrap items-center gap-2 sm:ml-auto">
			<DataFreshness
				client:visible
				source="leetcode"
				fetchedAt={leetCodeFetchedAt}
				compact
				className="h-9 max-w-none px-3 text-xs sm:h-9 sm:text-xs"
			/>
			<a
				href="https://leetcode.com/u/khan_tashif/"
				data-haptic-external
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-9 items-center gap-1.5 rounded-full border border-border/60 px-3.5 text-[13px] font-semibold text-muted-foreground transition-colors hover:border-primary/40 hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				<ExternalLink className="w-3.5 h-3.5" />
				Profile
			</a>
			<a
				href="/leetcode/stats"
				data-haptic-nav
				class="inline-flex h-9 items-center gap-1 rounded-full bg-primary/10 pl-3.5 pr-2.5 text-[13px] font-semibold text-primary transition-colors hover:bg-primary/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
			>
				All stats
				<ChevronRight className="w-3.5 h-3.5" />
			</a>
		</div>
	</div>

	<!-- Core Stats -->
	<LeetCodeStats />

	<!-- Secondary Panels -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
		<!-- Contests Panel -->
		<LeetCodeContests />

		<!-- Badges Panel -->
		<LeetCodeBadges />
	</div>
</div>
