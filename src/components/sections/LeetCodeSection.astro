---
import LeetCodeStats from "../leetcode/LeetCodeStats.astro";
import LeetCodeContests from "../leetcode/LeetCodeContests.astro";
import LeetCodeBadges from "../leetcode/LeetCodeBadges.astro";
import DataFreshness from "../common/DataFreshness";
import { ExternalLink, ChevronRight } from "lucide-react";
import { leetCodeData, leetCodeFetchedAt } from "../../data/leetcode";

const totalSolved = leetCodeData?.stats?.totalSolved ?? 0;

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="leetcode-section" class:list={["space-y-8", !active && "hidden"]}>
	<!-- Section heading (LeetCode): single compact row -->
	<div class="flex items-center gap-x-2 sm:gap-x-3 min-w-0">
		<h2
			class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
		>
			LeetCode
		</h2>
		<span
			class="inline-flex items-center gap-1 font-mono text-xs text-muted-foreground truncate min-w-0"
		>
			<span
				class="font-bold text-foreground tabular-nums"
				data-lc-heading-solved
				>{totalSolved}</span
			>
			<span class="hidden sm:inline">solved</span>
		</span>
		<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
			<DataFreshness
				client:load
				source="leetcode"
				fetchedAt={leetCodeFetchedAt}
				compact
			/>
			<a
				href="https://leetcode.com/u/khan_tashif/"
				data-haptic-external
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center justify-center h-7 w-7 sm:h-auto sm:w-auto sm:gap-1 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors shrink-0"
				aria-label="LeetCode profile"
			>
				<span class="hidden sm:inline">Profile</span>
				<ExternalLink size={12} />
			</a>
			<a
				href="/leetcode/stats"
				data-haptic-nav
				class="inline-flex items-center gap-0.5 text-xs font-semibold text-chart-2 hover:text-chart-2/80 transition-colors shrink-0"
				aria-label="Full LeetCode stats page"
			>
				<span class="hidden sm:inline">Full Page</span>
				<span class="sm:hidden">Full</span>
				<ChevronRight className="w-3 h-3" />
			</a>
		</div>
	</div>

	<!-- Core Stats -->
	<LeetCodeStats />

	<!-- Secondary Panels -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
		<!-- Contests Panel -->
		<LeetCodeContests />

		<!-- Badges Panel -->
		<LeetCodeBadges />
	</div>
</div>
