---
import BlogFilters from "../blog/BlogFilters";
import BlogCard from "../blog/BlogCard.astro";
import EmptyState from "../common/EmptyState.astro";
import DataFreshness from "../common/DataFreshness";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { ArrowUpRight, ExternalLink } from "lucide-react";
import { blogPosts, blogFetchedAt, blogCategories, avgReadingMinutes, numBlogPosts } from "../../data/blog";

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="blog-section" class:list={["relative", !active && "hidden"]}>
	<!-- Section heading: single compact row -->
	<div class="mb-4 sm:mb-5 flex items-center gap-x-2 sm:gap-x-3 min-w-0">
		<h2
			class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
		>
			Blog
		</h2>
		<span
			class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground truncate min-w-0"
		>
			<span
				class="font-bold text-foreground tabular-nums"
				data-blog-post-count
				>{numBlogPosts}</span
			>
			posts
			{
				avgReadingMinutes > 0 && (
					<>
						<span
							class="text-border select-none hidden sm:inline"
							aria-hidden="true"
						>
							·
						</span>
						<span
							class="font-bold text-foreground tabular-nums hidden sm:inline"
							data-blog-avg-read
						>
							{avgReadingMinutes}
						</span>
						<span class="hidden sm:inline">min avg</span>
					</>
				)
			}
		</span>
		<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
			<DataFreshness
				client:load
				source="blog"
				fetchedAt={blogFetchedAt}
				label="Blog posts"
				description="Re-fetch titles, excerpts, tags, and reading times from the live blog API. Views, likes, and comments only load on individual post pages."
				compact
			/>
			<a
				href="/blog/archive"
				data-haptic-nav
				class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-primary/80 transition-colors shrink-0"
				aria-label="Open the full blog archive"
			>
				<span class="hidden sm:inline">View all</span>
				<ArrowUpRight size={12} />
			</a>
		</div>
	</div>
	<BlogFilters client:load categories={blogCategories} />
	{
		blogPosts.length > 0 ? (
			<div class="space-y-10">
				<section class="mb-4">
					<BlogCard post={blogPosts[0]} variant="featured" index={0} />
				</section>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
					{blogPosts.slice(1).map((post, idx) => (
						<BlogCard post={post} variant="default" index={idx + 1} />
					))}
				</div>
				<div class="pt-10">
					<Card className="w-full text-center border-0 shadow-lg bg-gradient-to-br from-primary/5 via-transparent to-primary/5 dark:from-primary/10 dark:via-transparent dark:to-primary/10">
						<CardContent className="p-8 sm:p-10 space-y-6 relative overflow-hidden">
							<div class="absolute inset-0 bg-grid-slate-200/50 dark:bg-grid-slate-800/50 [mask-image:linear-gradient(to_bottom,transparent,black,transparent)] pointer-events-none" />
							<div class="space-y-3 relative z-10">
								<h3 class="text-2xl font-bold text-foreground dark:text-white tracking-tight">
									Want to read more?
								</h3>
								<p class="text-muted-foreground dark:text-muted-foreground max-w-lg mx-auto leading-relaxed">
									Browse the full post list on this site, or open the
									standalone blog archive.
								</p>
							</div>
							<div class="flex flex-wrap justify-center gap-3 relative z-10">
								<Button
									size="lg"
									className="rounded-full px-8 bg-primary text-primary-foreground hover:bg-primary/90 shadow-md transition-all hover:scale-105"
									asChild
								>
									<a
										href="/blog/archive"
										data-haptic-nav
										class="flex items-center gap-2"
									>
										Browse the archive
										<ArrowUpRight size={16} />
									</a>
								</Button>
								<Button
									size="lg"
									variant="outline"
									className="rounded-full px-8"
									asChild
								>
									<a
										href="https://blog.tashif.codes"
										data-haptic-external
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center gap-2"
									>
										blog.tashif.codes
										<ExternalLink size={16} />
									</a>
								</Button>
							</div>
						</CardContent>
					</Card>
				</div>
			</div>
		) : (
			<div class="py-14">
				<EmptyState
					command="ls ./blog"
					title="no posts available"
					description="Unable to load blog posts from the external API. Try again later or visit the blog directly."
					ctaLabel="visit blog"
					ctaHref="https://blog.tashif.codes"
					ctaExternal
				/>
			</div>
		)
	}
</div>

