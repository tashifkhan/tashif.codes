---
import BlogFilters from "../blog/BlogFilters";
import BlogList from "../blog/BlogList.astro";
import EmptyState from "../common/EmptyState.astro";
import DataFreshness from "../common/DataFreshness";
import { ArrowUpRight, Rss } from "lucide-react";
import { blogPosts, blogFetchedAt, blogTags, avgReadingMinutes, numBlogPosts } from "../../data/blog";

interface Props {
	active?: boolean;
}

const { active = false } = Astro.props;
---

<div id="blog-section" class:list={["relative rise-in", !active && "hidden"]}>
	<!-- Section heading: single compact row -->
	<div class="mb-4 sm:mb-5 flex items-center gap-x-2 sm:gap-x-3 min-w-0">
		<h2
			class="font-sans text-lg sm:text-xl font-bold tracking-tight text-foreground shrink-0"
		>
			Blog
		</h2>
		<span
			class="inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground truncate min-w-0"
		>
			<span
				class="font-bold text-foreground tabular-nums"
				data-blog-post-count
				>{numBlogPosts}</span
			>
			posts
			{
				avgReadingMinutes > 0 && (
					<>
						<span
							class="text-border select-none hidden sm:inline"
							aria-hidden="true"
						>
							·
						</span>
						<span
							class="font-bold text-foreground tabular-nums hidden sm:inline"
							data-blog-avg-read
						>
							{avgReadingMinutes}
						</span>
						<span class="hidden sm:inline">min avg</span>
					</>
				)
			}
		</span>
		<div class="ml-auto flex items-center gap-1.5 sm:gap-2.5 shrink-0">
			<DataFreshness
				client:visible
				source="blog"
				fetchedAt={blogFetchedAt}
				label="Blog posts"
				description="Re-fetch titles, excerpts, tags, and reading times from the live blog API. Views, likes, and comments only load on individual post pages."
				compact
			/>
			<a
				href="/blog/archive"
				data-haptic-nav
				class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-primary/80 transition-colors shrink-0"
				aria-label="Open the full blog archive"
			>
				<span class="hidden sm:inline">View all</span>
				<ArrowUpRight size={12} />
			</a>
			<a
				href="/rss.xml"
				data-haptic-nav
				class="inline-flex items-center gap-1 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors shrink-0"
				aria-label="Subscribe to the blog RSS feed"
				title="Subscribe via RSS"
			>
				<Rss size={12} />
				<span class="hidden sm:inline">RSS</span>
			</a>
		</div>
	</div>
	<BlogFilters client:visible tags={blogTags} listId="blog-list-dashboard" />
	{
		blogPosts.length > 0 ? (
			<>
				<BlogList id="blog-list-dashboard" posts={blogPosts} eager={active} />
				<div class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-border/60 pt-5 text-sm text-muted-foreground">
					<span>New posts reach the RSS feed first.</span>
					<a
						href="/rss.xml"
						data-haptic-nav
						class="inline-flex items-center gap-2 rounded-lg border border-primary/30 bg-primary/10 px-3.5 py-2 text-sm font-semibold text-primary hover:bg-primary/15"
					>
						<Rss size={14} />
						Subscribe
					</a>
				</div>
			</>
		) : (
			<div class="py-14">
				<EmptyState
					command="ls ./blog"
					title="no posts available"
					description="Unable to load blog posts from the external API. Try again later or visit the blog directly."
					ctaLabel="visit blog"
					ctaHref="https://blog.tashif.codes"
					ctaExternal
				/>
			</div>
		)
	}
</div>

