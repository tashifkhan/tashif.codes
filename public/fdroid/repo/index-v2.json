    "codes.tashif.paisa": {
      "metadata": {
        "added": 1785006084000,
        "categories": [
          "Money",
          "Offline"
        ],
        "changelog": "https://github.com/tashifkhan/Paisa/releases",
        "issueTracker": "https://github.com/tashifkhan/Paisa/issues",
        "lastUpdated": 1785006084000,
        "license": "AGPL-3.0-or-later",
        "sourceCode": "https://github.com/tashifkhan/Paisa",
        "webSite": "https://tashif.codes",
        "authorEmail": "tashifkhan010@gmail.com",
        "authorName": "Tashif Ahmad Khan",
        "name": {
          "en-US": "Paisa"
        },
        "summary": {
          "en-US": "Offline-first personal finance for Android"
        },
        "description": {
          "en-US": "Paisa keeps your money ledger on your phone.\n\nBank SMS is parsed on-device (100+ Indian banks via an AGPL parser\ncore). Optional BYOK statement import for PDF/CSV/images — your API\nkey, your endpoint; SMS never leaves the device.\n\nFeatures:\n* Home balance, filters, and recent transactions\n* Analytics charts with date ranges\n* Monthly budgets by category\n* Multiple accounts / wallets\n* SMS bulk scan + live receiver with hash dedup\n* App lock via biometrics or device credential\n* Export to CSV / PDF\n\nPackage ID: codes.tashif.paisa\n"
        },
        "icon": {
