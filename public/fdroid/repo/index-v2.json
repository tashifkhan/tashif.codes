    "codes.tashhif.patchwork": {
      "metadata": {
        "added": 1785008008000,
        "categories": [
          "Productivity",
          "Development",
          "Internet"
        ],
        "changelog": "https://github.com/tashifkhan/Patchwork/releases",
        "issueTracker": "https://github.com/tashifkhan/Patchwork/issues",
        "lastUpdated": 1794153633000,
        "license": "MIT",
        "sourceCode": "https://github.com/tashifkhan/Patchwork",
