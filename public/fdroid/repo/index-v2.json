        "lastUpdated": 1785013639000,
        "license": "MIT",
        "sourceCode": "https://github.com/tashifkhan/delhi-metro",
        "webSite": "https://tashif.codes",
        "authorEmail": "tashifkhan010@gmail.com",
        "authorName": "Tashif Ahmad Khan",
        "name": {
          "en-US": "Delhi Metro"
        },
        "summary": {
          "en-US": "Plan Delhi Metro journeys with fares, maps, and line status"
        },
        "description": {
          "en-US": "Delhi Metro is a Material 3 companion app for the Delhi Metro network.\n\nPlan trips between stations with least-distance or minimum-interchange\nstrategies, edit endpoints on the results screen, and swap origin and\ndestination without starting over. Browse lines and stations, check\nfirst and last train times, follow service alerts, and open the network\nmap with zoom and PDF share.\n\nFeatures:\n\n* Journey planner with strategy toggle\n* Editable origin and destination on route results\n* Station search with local cache\n* Line explorer and station detail\n* Network map view with share\n* Notifications / service alerts\n* Light, dark, and Material You theming\n\nReleases are built with Expo EAS, published on GitHub Releases, and\nmirrored into this F-Droid-compatible repository.\n\nPackage ID: codes.tashif.delhimetro\n"
        },
        "preferredSigner": "9533c97fae5bc77cdcc412b23957e12669d5515c6181e4f04fbc5e78a2f22933"
      },
